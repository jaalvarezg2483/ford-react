# PostgreSQL (Railway PostgreSQL now; Azure PostgreSQL later)
DATABASE_URL=postgresql://user:password@host:5432/ford
PGSSL=false

# Legacy Grupo Purdy microservice gateway, supplied as Railway/Azure variables.
MICROSERVICES_GATEWAY_URL=
MICROSERVICES_CLIENT_ID=
MICROSERVICES_CLIENT_SECRET=
MICROSERVICES_GRANT_TYPE=client_credentials
MICROSERVICES_BRAND=ford_citas

# Email delivery. Never put these values in Git.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@grupopurdy.com
CONTACT_TO_EMAIL=

PORT=4174

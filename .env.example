# --- Aplicación ---
NODE_ENV=development
# URL pública del sitio (Railway: https://<servicio>.up.railway.app · Azure: https://www.ford.cr)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# --- PostgreSQL ---
# Railway: usar la variable DATABASE_URL del servicio Postgres (${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://ford:ford@localhost:5432/ford
# Azure (identidad administrada, sin contraseña). No definir en local.
# DATABASE_AUTH_MODE=managed_identity
# POSTGRES_HOST=<servidor>.postgres.database.azure.com
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=<identidad>

# --- Archivos (media) ---
# local: disco en ./media (Railway: montar un volumen en /app/media) · azure: Blob Storage
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=fordcr-media
AZURE_STORAGE_ACCOUNT_BASEURL=

# --- Correo (igual que el Symfony: SendGrid por SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Ventas Nuevos
EMAIL_FROM_NAME_CITAS=Citas
# Para pruebas: si se define, TODOS los correos van a esta dirección en lugar de los destinatarios reales.
EMAIL_OVERRIDE_TO=

# --- Microservicios Grupo Purdy (citas, sucursales, consentimiento) ---
MICROSERVICES_GATEWAY=
MICROSERVICES_CLIENT_ID=
MICROSERVICES_CLIENT_SECRET=
MICROSERVICES_GRANT_TYPE=client_credentials
MICROSERVICES_APPOINTMENT_BRAND=ford_citas
INFORMED_CONSENT_URL=https://consentimiento.grupopurdy.com

# --- Salesforce Web-to-Lead ---
WTLEAD_PATH=https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
WTLEAD_OID=00DA0000000AGZH

# --- reCAPTCHA v2 (misma llave pública que el sitio actual) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Importación desde el sitio actual ---
LEGACY_SITE_URL=https://www.ford.cr

# --- SendGrid: plantilla dinámica de confirmación de test drive (SendGridTemplateMailer.php) ---
SENDGRID_API_KEY=
SENDGRID_TEST_DRIVE_TEMPLATE_ID=

# Zona horaria del servidor (horarios de citas)
TZ=America/Costa_Rica

{% extends "base.html.twig"%}
{% block title %}Cotizar Renting{% endblock %}

{% block body %}

<div class="wrapper">
	<div class="container container--breadcrumb">
		<ol class="breadcrumb steps--backbot">
			<li><a href="javascript:history.back()"><i class="icon icon-arrow-left breadcrumb-back"></i></a></li>
			<li><a href="javascript:history.back()"> Atrás</a></li>
			<li>Renting</li>
		</ol>
	</div>
	<div class="container text-center">
		<h2 class="title title-margin">Cotizar Renting</h2>
		<div class="step--circles">
			<ul>
				<li class="active">
					<span>1</span>
					<p>Automóvil</p>
				</li>
				<li class="active">
					<span>2</span>
					<p>Plazo</p>
				</li>
				<li>
					<span>3</span>
					<p>Cotización</p>
				</li>
			</ul>
		</div>
		<p class="text--larger"><strong>Elegir Plan</strong></p>
		<p>Seleccioná el plan que mejor se acople a tus necesidades.</p>
	</div>
	<div class="container">
		<div class="row">
			{% for year in years %}
			<div class="col-sm-4">
				<div class="card">
					<div class="card__content">
						<span><i class="mdi mdi-star-circle"></i></span>
						<h2 class="card__title">{{ year.title }}</h2>
						<h2 class="card__title">{{ year.description }}</h2>
					</div>
					<div class="card__action">
						<a href="{{ path("renting-auto3", {'type': type,'slug': slug ,'model': model, 'plan':year.id }) }}" class="" data-duration="{{ year.title }}" data-plan-id="{{ year.id }}">Elegir</a>
					</div>
				</div>
			</div>
			{% endfor %}
		</div>
	</div>
</div>

{% endblock %}

{% extends "base.html.twig"%}
{% block title %}Cotizador{% endblock %}

{% block meta %}
	<meta name="identifier-url" content="" />
	<meta name="title" content="Ford"/>
	<meta name="description" content="Ford" />
	<meta name="abstract" content="" />
	<meta name="keywords" content="" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© 2016" />
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
	<link rel="image_src" href="" >
	<meta name="dcterms.abstract" content="">
	<meta name="dcterms.rightsHolder" content="">
	<meta NAME="robots" CONTENT="noindex">
{% endblock %}

{% block body %}
	<script id="accessorie_item_template" type="text/x-tmpl">
	<section class="col-xs-12">
		<div class="chip">{-% name %-}
		<a class="accessory_wdg" data-price="{-% price %-}" data-name="{-% name %-}" data-id="{-% id %-}">
			<i class="mdi mdi-close"></i>
		</a>
		</div>
		<span class="price-selected">${-% price %-}</span>
	</section>
</script>

<script id="maintenance_item_template" type="text/x-tmpl">
	<section class="col-xs-12">
		<div class="chip">{-% tittle %-}
		<a class="item_wdg" data-price="{-% price %-}" data-name="{-% tittle %-}" data-id="{-% id %-}">
			<i class="mdi mdi-close"></i>
		</a>
		</div>
		<span class="price-selected">${-% price %-}</span>
	</section>
</script>

<script id="insurance_item_template" type="text/x-tmpl">
	<section class="col-xs-12">
		<div class="chip">{-% tittle %-}
		<a class="item_wdg" data-price="{-% price %-}" data-name="{-% tittle %-}" data-id="{-% id %-}">
			<i class="mdi mdi-close"></i>
		</a>
		</div>
		<span class="price-selected">${-% price %-}</span>
	</section>
</script>

<div class="breadcrumb--calculate">
	<div class="container step-4-calculate">
		<h1 class="breadcrumb__title">Calcular Cuota mensual</h1>
		<a class="calculate-steps" href="javascript:history.back()"><i class="mdi mdi-chevron-left"></i> Paso 4 de 5 <span class="name-step">Elegir Seguro</span></a>
	</div>
</div>
<div class="wrapper-calculate">
	<section class="sub-section">
        {%  include "LumenAppBundle:Default/partials:_resume.html.twig" with {
        "current": current,
        "families": families,
        "total": total,
        "model": model,
        "modelos": modelos,
        "accessories" : accessories,
        "maintenanceInsurance": {"maintenance_selected_wdg":"Mantenimiento", "insurance_selected_wdg": "Seguro"}
        } %}
	</section>
	<section class="bg-opacity"></section>
	<section class="container container-calculate">
		<div class="row content-plan insurance_wdg">

            {% for maintainance in maintenanceInsurances %}
				<div class="col-xs-12 col-sm-4 {{ loop.first ? "col-md-offset-2" : "" }} sr-sequenceFadeInBottom">
					<div class="card {{ in_array(maintainance.id, selected[constant('\\Lumen\\AppBundle\\Classes\\Constant::SESSION_INSURANCE')]) ? "ele-checked" : "" }}" data-id="{{ maintainance.id }}">
						<div class="card__content">
							<h2 class="title text-center"><span style="text-transform: none">Desde</span> ${{ maintainance.price | number_format(0, '.',',') }}</h2>
							<p class="subtitle text-center">{{ maintainance.tittle }}</p>
							<ul>
                                {% for service in maintainance.items %}
									<li>{{ service.text }}</li>
                                {% endfor %}
							</ul>
						</div>
						<div class="card__action">
							<a class="select-plan item_wdg btn btn--border-red btn--block" data-id="{{ maintainance.id }}">Elegir</a>
						</div>
					</div>
				</div>
            {% else %}
				<div class="col-xs-12 ">
					<div>
						<div class="card-stacked">
							<div class="card-content">
								<h6></h6>
								<span>Este modelo no cuenta con ningún seguro disponible en este momento, por favor pasá al siguiente paso.</span>
							</div>
						</div>
					</div>
				</div>
            {% endfor %}

		</div>
		<a class="next-step"  href="{{ path('calculate-step5', {slug: current.slug, code: model.code}) }}">Continuar al paso 5</a>
	</section>
	<!-- <section class="section--banner">
		<a href="#">
			<img src="/img/content/banner.jpg" alt="banner">
		</a>
	</section> -->
</div>
<div class="row">
	<div class="col-xs-10 col-xs-offset-1 col-md-8 col-md-offset-2 col-lg-6 col-lg-offset-3 ">
		<p class="text-justify"><small>*Podés cancelar el monto en colones al tipo de cambio aplicable a la transacción, correspondiente al de referencia de venta del Banco Central de Costa Rica.</small></p>
	</div>
</div>

{% if model.pixelInsurance is not null and model.pixelInsurance != "" %}
	<!-- Code for Action: {{ model.name }} Conversion_Calcular Cuota/Accesorios_Dic2018 -->
	<!-- Begin Sizmek DSP Conversion Action Tracking Code Version 9 -->
	<script type='text/javascript'>
	(function() {
		var w = window, d = document;
		var s = d.createElement('script');
		s.setAttribute('async', 'true');
		s.setAttribute('type', 'text/javascript');
		s.setAttribute('src', '//c1.rfihub.net/js/tc.min.js');
		var f = d.getElementsByTagName('script')[0];
		f.parentNode.insertBefore(s, f);
		if (typeof w['_rfi'] !== 'function') {
			w['_rfi']=function() {
				w['_rfi'].commands = w['_rfi'].commands || [];
				w['_rfi'].commands.push(arguments);
			};
		}
		_rfi('setArgs', 'ver', '9');
		_rfi('setArgs', 'rb', '36891');
		_rfi('setArgs', 'ca', '{{ model.pixelInsurance }}');
		_rfi('setArgs', '_o', '36891');
		_rfi('setArgs', '_t', '{{ model.pixelInsurance }}');
		_rfi('track');
	})();
	</script>
	<noscript>
	<iframe src='//{{ model.pixelInsurance }}p.rfihub.com/ca.html?rb=36891&ca={{ model.pixelInsurance }}&_o=36891&_t={{ model.pixelInsurance }}&ra=YOUR_CUSTOM_CACHE_BUSTER' style='display:none;padding:0;margin:0' width='0' height='0'>
	</iframe>
	</noscript>
	<!-- End Sizmek DSP Conversion Action Tracking Code Version 9 -->
{% endif %}

{% endblock %}
{% block scripts %}
    <script type="text/javascript">
        var vehiclePrice = {{ model.startPrice }};
        $('.open-calculate').on('click', function(){
			$('.nav-calculate').slideToggle('slow');
			$('.bg-opacity').toggleClass('show-bg');
		});
		$('.close-calculate').on('click', function(){
			$('.nav-calculate').slideUp('slow');
			$('.bg-opacity').removeClass('show-bg');
		});
        $('.bg-opacity').on('click', function(){
			$('.nav-calculate').slideUp('slow');
			$(this).removeClass('show-bg');
		});
    </script>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Calcular Financiamiento | Ford Costa Rica | Grupo Purdy{% endblock %}

{% block meta %}
    <meta name="identifier-url" content="" />
    <meta name="title" content="Calcular Financiamiento | Ford Costa Rica | Grupo Purdy "/>
    <meta name="description" content="Calcula el financiamiento para tu vehículo Ford fácilmente. Usa nuestra herramienta para evaluar pagos, plazos y opciones. ¡Comienza en nuestra web ahora!" />
    <meta name="abstract" content="Calcula el financiamiento para tu vehículo Ford fácilmente. Usa nuestra herramienta para evaluar pagos, plazos y opciones. ¡Comienza en nuestra web ahora!" />
    <meta name="keywords" content="como se calcula el financiamiento de un carro, calcula financiamiento, financiamiento Ford" />

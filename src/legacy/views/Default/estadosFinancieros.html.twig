{% extends "base.html.twig" %}
{% block title %}Estados Financieros{% endblock %}

{% block body %}
    <div class="wrapper">
		<div class="container container--breadcrumb">
			<ol class="breadcrumb">
		      <li><a href="javascript:history.back()"><i class="icon icon-arrowleft breadcrumb-back"></i></a></li>
		      <li><a href="{{path('index')}}"> Inicio</a></li>
		      <li>Estados Financieros</li>
		    </ol>
		</div>

	<section class="container">
		<h4 class="title text-center">Estados Financieros</h4>
		<div class="card">
             {% for year, estadoFinanciero in files %}
				<button type="button" class="collapsible__header active js-collapse-next sr-fadeInBottom"><i class="mdi mdi-plus"></i>{{ estadoFinanciero["label"] }}</button>
				<div class="collapsible__body">
					<ul class="list--download">
                        {% for estado in estadoFinanciero["results"] %}
						    <li><a href="{{ estado.getFilePath() }}" target="blank"><i class="mdi mdi-download"></i>{{ estado.name() }}</a></li>
						{% endfor %}
					</ul>
				</div>
            {% endfor %}
		</div>
	</section>
	{% include "LumenAppBundle:Default/partials:_banner-bottom.html.twig" with {} %}
</div>

{%  endblock %}
{% extends "base.html.twig"%}
{% block title %} Sostenibilidad {% endblock %}

{% block body %}
<div class="sostenibilidad--container">
    <div class="container container--breadcrumb text-left">
        <ol class="breadcrumb">
            <li><a href=""><i class="icon icon-arrow-left breadcrumb-back"></i></a></li><li><a href="{{path('index')}}"> Inicio</a></li><li>Sostenibilidad</li>
        </ol>
    </div>
    <div class="banner--sostenibilidad">
        {% if banner is not null %}
            <img src="{{ banner.image }}" alt="sostenibilidad">
        {% else %}
            <img src="/img/banners/banner_sostenibilidad.png" alt="sostenibilidad">
        {% endif %}
    </div>
    <div class="cta--sostenibilidad">
        <div class="container">
            <h1 class="mobile-title">Sostenibilidad</h1>
            <h3>Te invitamos a consultar nuestro informe de Sostenibilidad.</h3>
            <p>88 páginas que recopilan nuestra labor de sostenibilidad.</p>
            <div class="wrap-btns">
                {% if last_file is not null %}
                    <a target="_blank" href="{{path('memoria_sostenibilidad')}}" class="btn btn--border-black btn--small">Ver en línea</a>
                    <a target="_blank" href="{{ last_file.getFileReal() }}" download="{{ last_file.getFileRealName() }}" class="btn btn--red btn--small">Descargar</a>
                {% endif %}
            </div>
            {% if files %}
                <h3 class="margin--top">VER OTROS INFORMES DE SOSTENIBILIDAD</h3>
                <div class="years--container">
                    {% for file in files %}
                        <a target="_blank" href="{{ file.getFileReal() }}" download="{{ file.getFileRealName() }}" class="year">{{ file.getYear() }}</a>
                    {% endfor %}
                </div>
            {% endif %}
            <h3>DOCUMENTOS DE INTERÉS</h3>
            <div class="card">
                <button type="button" class="collapsible__header active js-collapse-next sr-fadeInBottom"><i class="mdi mdi-plus"></i> Política Ambiental</button>
				<div class="collapsible__body">
					<ul class="list--download">
						<li><a class="text-left" href="/documents/Politica-Ambiental-Grupo-Purdy-Motor.pdf" target="blank"><i class="mdi mdi-download"></i> Política Ambiental Grupo Purdy Motor</a></li>
					</ul>
                </div>
                <button type="button" class="collapsible__header active js-collapse-next sr-fadeInBottom"><i class="mdi mdi-plus"></i> Certificaciones Ambientales</button>
				<div class="collapsible__body">
					<ul class="list--download">
                        <li><a class="text-left" href="/documents/Certificados-ISO14001-17-18.pdf" target="blank"><i class="mdi mdi-download"></i> Certificados ISO14001</a></li>
                        <li><a class="text-left" href="/documents/Carbono_Programa_Pais_13-08-2019.pdf" target="blank"><i class="mdi mdi-download"></i> Carbono Programa País</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-de-Carbono-Neutro.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado de Carbono Neutro</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-Esencial-Costa-Rica.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado Esencial Costa Rica</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-INTE-ISO-14001-2015-Ciudad-Toyota-I.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado INTE-ISO 14001-2015 Ciudad Toyota I</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-INTE-ISO-14001-2015-Curridabat.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado INTE-ISO 14001-2015 Curridabat</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-INTE-ISO-14001-2015-Purdy-Trabajo.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado INTE-ISO 14001-2015 Purdy Trabajo</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-INTE-ISO-14001-2015-San-Carlos.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado INTE-ISO 14001-2015 San Carlos</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-IQNET-INTE-ISO-14001-2015-CIUDAD-TOYOTA-I.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado IQNET INTE-ISO 14001-2015 CIUDAD TOYOTA I</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-IQNET-INTE-ISO-14001-2015-Curridabat.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado IQNET INTE-ISO 14001-2015 Curridabat</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-IQNET-INTE-ISO-14001-2015-Purdy-Trabajo.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado IQNET-INTE ISO 14001-2015 Purdy Trabajo</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-IQNET-INTE-ISO-14001-2015-San-Carlos.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado IQNET INTE-ISO 14001-2015 San Carlos</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-PBAE-Ciudad-Toyota-I-2018-2019.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado PBAE Ciudad Toyota I 2018-2019</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-PBAE-Curridabat-2018-2019.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado PBAE Curridabat 2018-2019</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-PBAE-Paseo-Colón-2018-2019.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado PBAE Paseo Colón 2018-2019</a></li>
                        <li><a class="text-left" href="/documents/sostenibilidad/Certificado-PBAE-Purdy-Trabajo-2018-2019.pdf" target="blank"><i class="mdi mdi-download"></i> Certificado PBAE Purdy Trabajo 2018-2019</a></li>
					</ul>
                </div>
            </div>    
        </div>
    </div>
</div>

{% endblock %}
<div id="form-family" class="row quotation__form">
    {#<h1 class="subtitle--large not-bold text-center title-margin-more">Completá tus datos y pronto te contactaremos</h1>#}
    <div class=" form--custom card">
    <form action="{{ path('form-family-coupon', {slug: family.slug}) }}" method="post" class="form" id="contactForm">
        {#{{ path('prueba-manejo', {slug: family.slug, code: model.code}) }}#}
        <div class="card__content bg--gray">
            <div class="container">
                <p><strong>ME INTERESA EL VEHÍCULO:</strong></p>
                <p class="quotation__model">
                    {% if family.name == "Hino Serie 300" or family.name == "Hino Serie 500" or family.name == "Hino Serie 700" %}
                        <span>Hino</span>
                    {% else %}
                        <span>{{ family.name }}</span>
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="card__content">
            <div class="container">
                <div class="row">
                    <div class="col-sm-12">
                        <p><strong>MIS DATOS</strong></p>
                        <div class="input-field">
                            <input name="name" type="text" class="input" placeholder="Nombre" required>
                        </div>
                        <div class="input-field">
                            <input name="last_name" type="text" class="input" placeholder="Apellidos" required>
                        </div>
                        <div class="input-field">
                            <input name="email" type="email" class="input" placeholder="Correo Electrónico" required>
                        </div>
                        <div class="input-field">
                            <input name="phone" type="tel" class="input telefono" placeholder="Teléfono" required id="mobile">
                        </div>
                        <div class="input-field">
                            <input id="identification-coupon" name="identification" type="text" class="input" title="Este campo es obligatorio." required placeholder="Cédula" >
                        </div>

                        <button type="submit" name="button" class="btn btn--black btn--block">ENVIAR</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    </div>
</div>

{% block scripts %}
<script>
    $("#identification-coupon").keyup(function (event) {
        var value = $(this).val();
        if (value.includes("@")) {
            value = value.replace("@", "");
            $(this).val(value);
        }
    });
</script>

{% endblock %}
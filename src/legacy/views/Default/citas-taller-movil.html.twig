{% extends "base.html.twig"%}
{% block title %}Contactar Asesor Repuestos{% endblock %}

{% block body %}

<div class="wrapper">
  <div class="container container--breadcrumb">
    <a href="{{path('index')}}" class="btn--back"><span class="icon icon-arrow-left"></span>Ir a <strong>Ford CR</strong></a>
  </div>
  <div class="container">
    <h1 class="title text-center">TALLER MÓVIL PENSANDO EN SU EMPRESA</h1>
    <div class="card card--form">
      <form action="{{ path("citastallermovil") }}" class="form" id="contactForm" novalidate method="post">
        <div class="card__content">
          <div class="container">
            <h3 class="card__title">ESCRIBANOS AQUÍ</h3>
            <p>En Purdy Motor estamos para servirle, llene todos los campos de este formulario y muy pronto uno de nuestros asesores lo contactará para coordinar su cita.</p>

            <p><strong>MIS DATOS</strong></p>
            <div class="input-field">
                {{ form_widget(form.first_name, {attr: {"class": "input"}}) }}
            </div>
            <div class="input-field">
                {{ form_widget(form.last_name, {attr: {"class": "input"}}) }}
            </div>
            <div class="input-field">
                {{ form_widget(form.email, {attr: {"class": "input"}}) }}
            </div>
            <div class="input-field">
                {{ form_widget(form.mobile, {attr: {"class": "input"}}) }}
            </div>
            <p><strong>COMENTARIO</strong></p>
            <div class="input-field">
              <textarea class="textarea" placeholder="Describe tu duda o consulta" id="{{ field_id(form, 'comment') }}" name="{{ field_name(form, 'comment') }}" required></textarea>
            </div>
            <div class="input-field">

              <input type="checkbox" id="{{ field_id(form, 'terms') }}" name="{{ field_name(form, 'comment') }}" required="required" class="checkbox"/>
              <label for="{{ field_id(form, 'terms') }}">Autorizo a Grupo Purdy al envío de información de sus productos y el uso de mis datos de contacto.</label>
            </div>
            <button type="submit" class="btn btn--black btn--block">ENVIAR</button>
          </div>
        </div>
          {{ form_rest(form) }}
      </form>
    </div>
  </div>
</div>

{% endblock %}

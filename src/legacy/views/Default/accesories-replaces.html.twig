{% extends "base.html.twig" %}

{% block title %}
    {% if type == "accesorios" %}
        Accesorios
    {% elseif type == "repuestos" %}
        Repuestos
    {% endif %}
{% endblock %}

{% block seo_h1 %}
    {% if type == "accesorios" %}
        {% include "@LumenCMS/Default/articleTemplate/partials/seo-h1.html.twig" with {h1: "Accesorios | Ford Costa Rica | Grupo Purdy "} %}
    {% elseif type == "repuestos" %}
        {% include "@LumenCMS/Default/articleTemplate/partials/seo-h1.html.twig" with {h1: "Repuestos | Ford Costa Rica | Grupo Purdy"} %}
    {% endif %}
{% endblock %}

{% block meta %}
    {% if type == "accesorios" %}
        <meta name="title" content="Accesorios | Ford Costa Rica | Grupo Purdy "/>
        <meta name="description" content="Explora accesorios para Ford, incluyendo pick-ups y 4x4. Encuentra el stock completo y personaliza tu vehículo. ¡Contacta nuestro centro de atención hoy!" />
        <meta name="keywords" content="accesorios originales ford, accesorios para ford" />
    {% elseif type == "repuestos" %}
        <meta name="title" content="Repuestos | Ford Costa Rica | Grupo Purdy"/>
        <meta name="description" content="Respuestos Ford Costa Rica, Repuestos Ford, repuestos para ford, venta de respuestos para ford, ford repuestos Costa Rica, repuestos ford ranger, venta de repuestos para Ford, repuestos ford bronco" />
        <meta name="keywords" content="Respuestos Ford Costa Rica, Repuestos Ford, repuestos para ford, venta de respuestos para ford, ford repuestos Costa Rica, repuestos ford ranger, venta de repuestos para Ford, repuestos ford bronco" />
    {% endif %}
    <meta name="identifier-url" content="" />
    <meta name="abstract" content="" />
    <meta name="author" content="Grupo Purdy" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="es" />
    <meta name="copyright" content="© {{"now" | date("Y")}}" />
    <meta name="organization" content="">
    <meta name="revisit-after" content="1 day">
    <meta name="origen" content="">
    <meta name="locality" content="San José , Costa Rica">
    <meta name="distribution" content="global">
    <link rel="image_src" href="" >
    <meta name="dcterms.abstract" content="">
    <meta name="dcterms.rightsHolder" content="">
{% endblock %}

{% block body %}
{% include '@LumenCMS/MenuTemplates/script-select-menu.html.twig' with {'searchMenu': 'Servicios'} %}

    <div class="wrapper">
        <div class="text-left padding-2 bg--accent-light hidden-xs">
            <div class="container">
                <a href="javascript:history.back()" class="text--primary"><i class="icon icon-arrow-left"></i>  Volver</a>
            </div>
        </div>
        <div class="accesories-hero">
            <a class="accesories-backbot text--light" href="javascript:history.back()"><i class="icon icon-arrow-left"></i> Volver</a>
            <h2 class="title">Accesorios</h2>
        </div>
        
        <div class="container margin--top hidden-xs">
            <div class="col-md-6">
                <h2 class="title">Accesorios</h2>
                {% if type == "accesorios" %}
                    <p>Hacé tu Ford aún más único.</p>
                {% elseif type == "repuestos" %}
                    <p>Repuestos originales para que mantengás el poder Ford.</p>
                {% endif %}
            </div>
        </div>
        <div class="container">
            <div class="row row-margin">
                <div class="col-md-2 hidden-xs">
                    <div class="accessories-aside">
                        <a href="{{ path('services-type', {'type': "accesorios"}) }}" {% if type == "accesorios" %}class="active"{% endif %}><i class="icon icon-plus-circle text--secondary"></i> Accesorios</a>
                        <!-- <a href="{{ path('services-type', {'type': "repuestos"}) }}" {% if type == "repuestos" %}class="active"{% endif %}><i class="icon icon-battery text--secondary"></i> Repuestos</a> -->
                    </div>
                </div>
                <div class="col-md-10 padding-0">
                {% if type == "accesorios" %}
                    <h4 class="container container--full-mobile">
                        <h4 class="title">Seleccione un vehículo</h4>
                        {% include "LumenAppBundle:Default/partials:_select_family.html.twig" with {"categories": categories} %}
                    </div>
                {% elseif type == "repuestos" %}
                    <div class="row" id="results">
                        {% include 'LumenAppBundle:Default:partials/_repuestos.html.twig' with {"repuestos": repuestos} %}
                    </div>
                    {% if moreResults %}
                        <div class="text-center">
                            <a id="load-more" class="btn">Cargar más</a>
                        </div>
                    {% endif %}
                {% endif %}
                </div>
            </div>
        </div>
        
        
    </div>

{%  endblock %}

{% block scripts %}
    <script type="text/javascript">

        {% if type == "repuestos" %}
            var page = 2;
            $("#load-more").on("click", function () {
                var btn = $(this);
                btn.addClass("disabled");
                $.ajax({
                    url: "{{ path('services-type', {'type': "repuestos"}) }}",
                    data: {page: page}
                }).done(function(result) {
                    btn.removeClass("disabled");
                    $("#results").append(result);
                    page += 1;
                    if (page > {{ pages }}){
                        btn.css("display", "none");
                    }
                });
            });
        {% endif %}
    </script>

{% endblock %}

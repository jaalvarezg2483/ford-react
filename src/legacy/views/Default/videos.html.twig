{% extends "base.html.twig"%}
{% block title %}Videos{% endblock %}
{% block meta %}
    <meta name="title" content="Videos | Ford Costa Rica | Grupo Purdy"/>
    <meta name="description" content="Descubre videos de Ford Costa Rica para explorar el diseño, rendimiento y tecnología de nuestros vehículos. ¡Visita nuestra página para ver más contenido!" />
    <meta name="keywords" content="videos ford, ford videos" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="{{ app.request.locale }}" />
    <meta name="copyright" content="© {{"now" | date("Y")}}" />
{% endblock %}

{% block body %}

<div class="wrapper">

	<div class="container margin--top">
		<h1 class="title margin--top">Videos</h1>
		{#<p class="text--medium hidden-xs">Lorem ipsum dolor sit amet,consectetur adipiscing elit</p>#}
	</div>
	<div class="container">
		<ul class="tabs">
			<li class="tab {% if category_selected is null %}active{% endif %}"><a href="{{ path('videos') }}">Todos</a></li>
			{% for category in categories %}
				<li class="tab {% if category_selected is not  null and category_selected.name == category.name %}active{% endif %}">
					<a href="{{ path('videos-category', {'name': category.name}) }}">{{ category.name }}</a>
				</li>
            {% endfor %}
		</ul>
	</div>	
	<div class="container">
		<form id="form_search" action="{{  category_selected is not null? path('videos-category', {'name':category_selected.name}) : path('videos') }}">
		<div class="find-us__search col-md-4">
            <div class="input-field">
              <input type="text" placeholder="Buscar Video" name="name" class="input" {% if name_selected != "" %} value="{{ name_selected }}" {% endif %}>
            </div>
          </div>
		</form>
	</div>
	<div class="container">
		
			{#Si es null - Mostrar sliders#}
			{% if category_selected is null %}
				{% for category in categories if category.videos | length > 0%}
					<h2 class="title">{{ category.name }}</h2>
					<ul class="gallery-slider margin--bottom">
						{% for video in category.videos %}
							<li class="gallery__item gallery__item--video filtr-item">
								<a href="{{ video.youtube }}" class="js-popup-img js-popup-video img-container" title="{{video.name}}">
									<img src="{{ video.getWebPath() }}" class="gallery__img">
									<button class="btn btn--primary"><i class="icon icon-play"></i> Ver video</button>
								</a>
								<p>{{ video.name }}</p>
								{# <p>{{ video.description }}</p> #}
							</li>
						{% endfor %}
					</ul>
					<div class="text-center margin--bottom">
						<a href="{{ path('videos-category', {'name': category.name}) }}" class="btn btn--wider">Ver todos</a>
					</div>
				{% endfor %}
			{#Sino mostrar todoslos de la categoría#}
			{% else %}
				<div id="results">
					{% include "@LumenApp/Default/partials/videos-results.html.twig" %}
				</div>
				{% if moreResults %}
				<div class="text-center margin--bottom">
					<a id="load-more" class="btn">Cargar más</a>
				</div>
				{% endif %}
			{% endif %}
		
		
	</div>
	{% include "LumenAppBundle:Default/partials:_banner-bottom.html.twig" with {} %}
</div>

{% endblock %}

{% block scripts %}
<script>
$('.js-video').magnificPopup({
  	mainClass: 'mfp-fade',
	removalDelay: 160,
	type: 'iframe',
	gallery: {
		enabled: true
	},
});

$("#search").on('click', function () {
	$("#form_search").submit();
})

{% if category_selected is not null %}
	var page = 2;
	$("#load-more").on('click', function () {
	    var btn = $(this);
		btn.addClass("disabled");
		$.ajax({
			url: "{{ path('videos-category', {'name': category_selected.name}) }}?{{ query }}",
			data: {page: page}
		}).done(function(result) {
            btn.removeClass("disabled");
			$("#results").append(result);
			page += 1;
			if (page > {{ pages }}){
			    btn.css("display", "none");
			}
        });
	});
{% endif %}
</script>
{% endblock %}

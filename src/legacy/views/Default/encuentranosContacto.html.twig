{% extends "base.html.twig"%}
{% block title %}Contacto{% endblock %}
{% block meta %}
    <meta name="title" content="Contacto | Ford Costa Rica | Grupo Purdy | Contacto"/>
    <meta name="description" content="Contacta a Ford para obtener información sobre vehículos nuevos, financiamiento, seguros, repuestos originales y mecánica general. ¡Nuestro equipo te espera!" />
    <meta name="keywords" content="autos nuevos Ford, agencia Ford Costa Rica NASA, contacto agencia Ford Costa Rica, agentes de servicio al cliente Ford Costa Rica, información sobre modelos Ford" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="{{ app.request.locale }}" />
    <meta name="copyright" content="© {{"now" | date("Y")}}" />
{% endblock %}

{% block metaFace %}
    <meta property="og:title" content="Contacto | Ford Costa Rica | Grupo Purdy | Contacto"/>
    <meta property="og:site_name" content="Ford"/>
    <meta property="og:description" content="Contacta a Ford para obtener información sobre vehículos nuevos, financiamiento, seguros, repuestos originales y mecánica general. ¡Nuestro equipo te espera!"/>
{% endblock %}

{% block seo_h1 %}{% include "@LumenCMS/Default/articleTemplate/partials/seo-h1.html.twig" with {h1: "Contacto | Ford Costa Rica | Grupo Purdy | Contacto"} %}{% endblock %}

{% block body %}

<div class="wrapper">
  {# <div class="container margin--top margin--bottom">
    <ol class="breadcrumb">
      <li><button type="button" class="js-back-btn"><i class="icon icon-arrow-left"></i></button></li><li><a href="{{path('index')}}">Inicio</a></li><li>Contacto</li>
    </ol>
  </div> #}
  <div class="container margin--top margin--bottom">
    <h1 class="title">Contactanos</h1>
    <p>Nuestro equipo de asesores y profesionales están aquí para ayudarte con cualquier duda o para asesorarte sobre nuestros servicios de venta de vehículos nuevos, seguros, planes de mantenimiento y servicios mecánicos en general.</p>
    <ul class="tabs tabs--opacity margin--top">
        <li class="tab active"><a href="{{ path('contacto') }}"><i class="icon icon-phone text--primary"></i> Contacto</a></li>
        <li class="tab"><a href="{{ path('sucursales') }}"><i class="icon icon-home text--primary"></i> Sucursales</a></li>
        <li class="tab"><a href="{{ path('talleres') }}"><i class="icon icon-wrench text--primary"></i> Talleres</a></li>
      </ul>
    <div class="row">
      <div class="col-md-6">
          <div class="card__contact--details">
              <h3 class="title hidden-xs">Contacto</h3>
              <a href="tel:+50625197777" class="title-icon title-icon--responsive margin--top">
                <div class="icon-box">
                  <i class="icon icon-phone"></i>
                </div>
                <div>
                  <p>Ventas nuevos y citas taller</p>
                  <p>(506) 2519-7777</p>
                </div>
              </a>
              <a href="tel:+50624597615" class="title-icon title-icon--responsive margin--top">
                <div class="icon-box">
                  <i class="icon icon-phone"></i>
                </div>
                <div>
                  <p>Repuestos</p>
                  <p>(506) 2459-7615</p>
                </div>
              </a>
              <a href="mailto:ventas@grupopurdy.com" class="title-icon title-icon--responsive margin--top">
                <div class="icon-box">
                  <i class="icon icon-mail"></i>
                </div>
                <div>
                  <p>Correo electrónico</p>
                  <p>ventas@grupopurdy.com</p>
                </div>
              </a>

              <a href="http://purdygo.com/" class="title-icon title-icon--responsive margin--top">
                <div class="icon-box">
                  <i class="icon icon-purdygo"></i>
                </div>
                <div>
                  <p>App Digital</p>
                  <p>purdygo.com</p>
                </div>
              </a>

              <ul class="social-icons-contact">
                <li><a href="https://www.facebook.com/FordCostaRica" target="_blank"><span class="icon icon-facebook"></span>/FordCostaRica</a></li>
                <li><a href="https://www.youtube.com/channel/UC9dvZm4Gt1ggI428hfulSDQ" target="_blank"><span class="icon icon-youtube"></span>Ford Costa Rica</a></li>
                <li><a href="https://www.instagram.com/fordcostarica/" target="_blank"><span class="icon icon-instagram"></span>@fordcostarica</a></li>
                
              </ul>
          </div>
          </div>
          <div class="col-md-6">
            <h4 class="title text-center-xs">¿Tiene alguna duda o consulta?</h4>                
            <small><span class="text--primary">*</span> Campos Obligatorios</small>
            <form action="{{ path("contacto") }}" id="contactForm" class="form--contact margin--top margin--bottom verify-captcha" method="post">
                {%  set aditionalValues = form.vars.value.aditionalFields | default([])%}
              <div class="row">

                <div class="col-sm-12">
                  <div class="input-field select">
                    <label for="area" class="label--black"><span class="text--primary">*</span> Área o Departamento</label>
                    <select name="area" id="area" class="js-select">
                        {%  set area =  aditionalValues["area"] | default("")%}
                      <option value="Ventas Vehículos Nuevos" {{ area == "Ventas Vehículos Nuevos" ? 'selected="selected"' : ""}}>Ventas Vehículos Nuevos</option>
                      <option value="Ventas Vehículos Usados" {{ area == "Ventas Vehículos Usados" ? 'selected="selected"' : ""}}>Ventas Vehículos Usados</option>
                      <option value="Repuestos" {{ area == "Repuestos" ? 'selected="selected"' : ""}}>Repuestos</option>
                      <option value="Accesorios" {{ area == "Accesorios" ? 'selected="selected"' : ""}}>Accesorios</option>
                      <option value="Citas de Taller" {{ area == "Citas de Taller" ? 'selected="selected"' : ""}}>Citas de Taller</option>
                      <option value="Carrocería y Pintura" {{ area == "Carrocería y Pintura" ? 'selected="selected"' : ""}}>Carrocería y Pintura</option>
                      <option value="Seguros" {{ area == "Seguros" ? 'selected="selected"' : ""}}>Seguros</option>
                      <option value="Quejas o Reclamos" {{ area == "Quejas o Reclamos" ? 'selected="selected"' : ""}}>Quejas o Reclamos</option>
                      {#<option value="Distribuidor" {{ area == "Distribuidor" ? 'selected="selected"' : ""}}>Distribuidor</option>#}
                    </select>
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field select">
                    <label class="label--black" for="sucursal"><span class="text--primary">*</span> Sucursal</label>
                    <select name="sucursal" id="sucursal" class="js-select">
                        {%  set sucursal_value =  aditionalValues["sucursal"] | default("")%}
                      {% for key,sucursal in sucursales %}
                        <option value="{{ sucursal }}" {{ sucursal_value == sucursal ? 'selected="selected"' : ""}}>{{ sucursal }}</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field">
                    <label class="label--black" for="first_name"><span class="text--primary">*</span> Nombre </label>
                    {{ form_widget(form.first_name, {"attr":{"placeholcer" :"Juan", "class":"input" }}) }}
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field">
                    <label class="label--black" for="last_name"><span class="text--primary">*</span> Apellidos </label>
                      {{ form_widget(form.last_name, {"attr":{"placeholcer" :"Rodríguez", "class":"input" }}) }}
                  </div>
                </div>
                
                <div class="col-sm-12">
                  <div class="input-field">
                      <label class="label--black" for="email"><span class="text--primary">*</span> Correo electrónico </label>
                      {{ form_widget(form.email, {"attr":{"placeholcer" :"ejemplo@mail.com", "class":"input" }}) }}
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field">
                    <label class="label--black" for="mobile"><span class="text--primary">*</span> Número telefónico </label>
                    {{ form_widget(form.mobile, {"attr": {"placeholder": "88888888", "class": "input"}}) }}
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field">
                    <label class="label--black" for="plate">Número de Placa</label>
                      <input class="textarea" name="{{ field_name(form, "plate") }}" id="{{ field_id(form, "plate") }}" value="{{ aditionalValues["plate"] | default("") }}" placeholder="ABC123" />
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="input-field">
                    <label class="label--black" for="comment"><span class="text--primary">*</span> Mensaje</label>
                    <textarea class="textarea" name="{{ field_name(form, "comment") }}" id="{{ field_id(form, "comment") }}" placeholder="Describe tu duda o consulta" required>{{ aditionalValues["comment"] | default("") }}</textarea>
                  </div>
                </div>
              </div>
              {% if show_captcha == "true" %}
                  {% include "@LumenApp/Default/partials/_form-captcha-field.html.twig" %}
              {% endif %}
              <div class="row">
                <div class="col-sm-12 text-center">
                  <button disabled id="btn-submit" type="submit" class="btn btn--primary btn--wider">Enviar Mensaje</button>
                </div>
              </div>
              {{ form_rest(form) }}
            </form>
          </div>
      </div>

  </div>
</div>

{% endblock %}

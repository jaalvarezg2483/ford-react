{% extends "base.html.twig"%}
{% block title %}Cotizar Renting{% endblock %}

{% block body %}

<div class="wrapper">
	<div class="container container--breadcrumb">
		<ol class="breadcrumb steps--backbot">
			<li><a href="javascript:history.back()"><i class="icon icon-arrow-left breadcrumb-back"></i></a></li>
			<li><a href="javascript:history.back()"> Atrás</a></li>
			<li>Renting</li>
		</ol>
	</div>
	<div class="container">
		<h2 class="title title-margin text-center">Cotizar Renting</h2>
		<div class="step--circles">
			<ul>
				<li class="active">
					<span>1</span>
					<p>Automóvil</p>
				</li>
				<li class="active">
					<span>2</span>
					<p>Plazo</p>
				</li>
				<li class="active">
					<span>3</span>
					<p>Cotización</p>
				</li>
			</ul>
		</div>
		<p class="text--larger margin--top text-center"><strong>Resumen</strong></p>
		<div class="margin--top">
			<div class="row">
				<div class="col-sm-6">
					<div class="row">
						<div class="col-xs-4">
							<p><strong>Automóvil:</strong></p>
						</div>
						<div class="col-xs-8">
							{% if hino is defined %}
								<p class="text--large">{{ family.name }}</p>
                            {% else %}
								<p class="text--large">{{ model.name }}</p>
							{% endif %}
						</div>
					</div>
					<hr>
					<div class="row">
						<div class="col-xs-4">
							<p><strong>Plan:</strong></p>
						</div>
						<div class="col-xs-8">
							<p class="text--large">{{ year.title }}</p>
							<p>Detalle</p>
							<p><small>{{ year.description }}</small></p>
						</div>
					</div>
					<hr>
				</div>
				<div class="col-sm-6 text-center">
					<img id="img-chosen-car" src="{{ server_url ~ image }}" class="img-responsive" alt="">
				</div>
			</div>
		</div>
		<div class="row--flex margin--top">
			{#<div class="col-sm-4">#}
				{#<a href="{{ path("asesor-renting-stepper", {'type': type, 'slug': slug, 'code': model.code, 'plan': year.id}) }}" class="card card--link card--flex">#}
					{#<div class="card__content">#}
						{#<i class="mdi mdi-human-greeting"></i>#}
						{#<h2 class="card__title"> Contactar Asesor de Renting</h2>#}
					{#</div>#}
				{#</a>#}
			{#</div>#}
			<div class="col-sm-6">
				{% if hino is defined %}
					<a href="{{ path("cotizacion-renting-stepper-hino", {'type': type, 'slug': slug, 'plan': year.id}) }}" class="card card--link card--flex">
						<div class="card__content">
							<i class="mdi mdi-email"></i>
							<h2 class="card__title"> Enviar Cotización al correo</h2>
						</div>
					</a>
				{% else %}
				<a href="{{ path("cotizacion-renting-stepper", {'type': type, 'slug': slug, 'code': model.code, 'plan': year.id}) }}" class="card card--link card--flex">
					<div class="card__content">
						<i class="mdi mdi-email"></i>
						<h2 class="card__title"> Enviar Cotización al correo</h2>
					</div>
				</a>
				{% endif %}
			</div>
			<div class="col-sm-6">
				<a href="{{ path('renting') }}" class="card card--link card--flex">
					<div class="card__content">
						<i class="mdi mdi-reply"></i>
						<h2 class="card__title"> Iniciar Nueva Cotización</h2>
					</div>
				</a>
			</div>
		</div>
	</div>
</div>

{% endblock %}

<div class="menu--mock">
    <div class="hidden-xs hidden-sm">
        <div class="container">
            <ul class="tabs">
                {% for type in categories  %}
                    <li class="tab {% if loop.index == 1 %} active {% endif %}"><a href="#folleto{{ loop.index }}" data-toggle="tab">{{ type.name }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <ul class="collapsible tab-content">
        {% for type in categories  %}
            <li class="tab-pane fade {% if loop.index == 1 %} in active {% endif %}" id="folleto{{ loop.index }}">
                <button type="button" class="collapsible__header js-collapse-next {% if loop.index == 1 %}  {% endif %}"><i class="mdi mdi-plus"></i>{{ type.name }}</button>
                <div class="collapsible__body container-fluid">
                    <div class="row col-md-offset-2">
                        {% for family in families[type.id] %}
                            <div class="col-sm-6 col-md-3 family-wrap">
                                <a class="family-click" id="{{ family.id }}">
                                    <div class="family">
                                        <div class="family__img">
                                            <img src="{{ family.getWebPath() ? image_url(family.getWebPath(), false)  : image_url('/img/content/yaris-small.png', false) }}" alt="Car" class="img-responsive">
                                        </div>
                                        <div class="family__text">
                                            <h2>
                                                {{ family.name }}
                                                {{family.hybrid == true ? '<span class="mdi mdi-leaf"></span>' : ''}}
                                            </h2>
                                            <p class="family__cta-price">Desde <span>${{ family.startPrice | number_format(0, ',', '.') }}</span></p>
                                            <p>
                                                {% if family.name == "Hino Serie 300" %}
                                                    De 2.5 ton a 6 ton de capacidad de carga.
                                                {% endif %}
                                                {% if family.name == "Hino Serie 500" %}
                                                    De 7 ton a 19 ton de capacidad de carga.
                                                {% endif %}
                                                {% if family.name == "Hino Serie 700" %}
                                                    Cabezales para capacidades de arrastre desde 49 toneladas.
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>

</div>
<div class="wrapper forms-appear" style="display: none" id="dynamic_form">
    <div class="container container--breadcrumb">
    </div>

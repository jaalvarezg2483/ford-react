<script id="ajaxPath">
    var dynamicFormConfiguration = {};
    {% for type in categories  %}
    {% for family in families[type.id] %}
    dynamicFormConfiguration[{{ family.id }}] = {
        familyName: "{{ family.name }}",
        models: "{% for model in models[family.id] %}<option value='{{ model.categorySalesForce }}'>{{ model.name }}</option>{% endfor %}",
        wtl_marca: "{{ family.familyBrand.code }}",
        wtl_familia: "{{ family.principalModel.familySalesForce.name }}",
        savePath: "{{ secureUrl("contactar-asesor-trabajo", {slug: family.slug }) }}"
    };
    {% endfor %}
    {% endfor %}
    $(".family-click").on("click",function () {
        var id = $(this).attr("id");
        $("#dynamic_form").css('display', 'block');
        $('html, body').animate({
            scrollTop: $("body").find("#dynamic_form").offset().top - 64
        }, 1000);
        var configuration = dynamicFormConfiguration[id];
        $("#wtl_marca").val(configuration.wtl_marca);
        $("#wtl_familia").val(configuration.wtl_marca);
        $("#familyName").html(configuration.familyName);
        $('#wtl_modelo').children().remove();
        $('#wtl_modelo').append(configuration.models);
        savePath = configuration.savePath;
    });
</script>
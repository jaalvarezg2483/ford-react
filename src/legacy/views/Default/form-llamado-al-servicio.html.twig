{% extends "base.html.twig" %}
{% block title %}Seguridad{% endblock %}

{% block body %}

    <div class="wrapper">
        <div class="container container--breadcrumb">
            <a href="javascript: history.back();" class="btn--back"><span class="icon icon-arrow-left"></span>Volver</a>
        </div>
        <section class="container form">
            <div class="banner container">
                <div class="row">
				<div class="col-xs-12 no--padding">
					<img src="{{ '/img/banners/seguridad_primero.png' | imagine_filter('hero_bg_small') }}" alt="banner">
					<div class="banner__overlay">
					</div>
					<div class="banner__inner">
					<h2 class="banner__title">CAMPAÑAS DE SERVICIO (RECALL)</h2>
					<p></p>
				</div>
			</div>
		</div>

                <form class="form-llamado-servicio" id="llamadoForm" novalidate method="post"
                      action="{{ path('guarda-llamado') }}">

			<p class="intro_form_service">Para Toyota tu seguridad es nuestra prioridad y queremos reforzar nuestro compromiso de Protección y Respaldo con nuestros clientes, por medio del programa de Campañas de Servicio (Recall).
        <br><br>
			El programa realiza servicios preventivos para asegurar tu tranquilidad en carretera.
        <br><br>
			Ingresá tu placa y confirmá si tu Toyota tiene un servicio pendiente.</p>
                    <fieldset>

                        <p id="response" align="center"></p>
                        <br>
                        <div class="input-field">
                            <input type="text" class="input vld_plate" name="placa" id="placa" placeholder="Número de placa"
                                   required="required" minlength="5">
                        </div>
                        <div class="input-field">
                            <input type="text" class="input" name="nombre" id="nombre" placeholder="Nombre completo"
                                   required="required" minlength="3">
                        </div>
                        <div class="input-field">
                            <input type="text" class="input vld_phone" name="tel" id="tel" placeholder="Teléfono"
                                   required="required" minlength="8">
                        </div>
                        <button type="button" class="btn btn--block btn--red" id="btnConsulta">CONSULTAR</button>
                        <div class="loader">
                            <span></span>
                        </div>
                    </fieldset>
                </form>

                <div class="msj_response">
                    <i class="mdi mdi-alert-circle"></i>
                    <p class="print_response">En estos momentos tu vehículo no cuenta con una revisión asociada</p>
                    <button type="button" class="btn btn--red" id="consultarOtro">CONSULTAR OTRO</button>
                </div>




	<div class="row js-equal-height-parent">
      <div class="col-md-4 sr-sequenceFadeInBottom">
        <a href="{{ path('contactar-asesor-seguridad') }}" class="card card--link js-equal-height">
          <div class="card__content">
            <i class="mdi mdi-account"></i>
            <h2 class="card__title">Contactar Asesor de Seguridad</h2>
          </div>
        </a>
      </div>
      <div class="col-md-4 sr-sequenceFadeInBottom">
        <a href="tel:+(506)25197888" class="card card--link js-equal-height">
          <div class="card__content">
            <i class="mdi mdi-phone"></i>
            <h2 class="card__title">Llamar</h2>
            <p class="card__text">(506) 2519-7888</p>
          </div>
        </a>
      </div>
      <div class="col-md-4 sr-sequenceFadeInBottom">
        <a href="#" class="card card--link js-equal-height chat-btn">
          <div class="card__content">
            <i class="mdi mdi-message"></i>
            <h2 class="card__title">Chat</h2>
          </div>
        </a>
      </div>
    </div>

    <div class="box__announcement">
      <p class="intro_form_service">Si tu vehículo <strong>Toyota</strong> no fue adquirido en <strong>Grupo Purdy Motor</strong>, podés contactarnos directamente para indicarte si existe un servicio preventivo pendiente. Podés usar cualquier de los medios de contacto que están disponibles en esta página.</p>
    </div>

		<div class="box__faq">
			<div class="container">
				<h1 class="title text-center">Preguntas Frecuentes</h1>
			</div>
			<div class="container container--full-mobile">
				<ul class="collapsible card find-us__office">
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Qué es el programa de Campañas de Servicio (Recall)? </button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Es un programa de seguridad de Grupo Purdy Motor que realiza servicios preventivos para asegurar la tranquilidad de nuestros clientes en carretera.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Por qué se realizan este tipo de programas?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Para Grupo Purdy Motor tu seguridad es nuestra prioridad y queremos reforzar nuestro compromiso de protección y respaldo, por eso en línea con las solicitudes y recomendaciones de Toyota Motor Corporation atendemos los vehículos que requieren atención y servicios preventivos.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿En qué consisten los servicios?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>El servicio puede variar de acuerdo al modelo, año y/o otros factores de fabricación, pero esencialmente consiste en el reemplazo de una pieza de tu vehículo cuyo funcionamiento podría no ser preciso.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Cómo sé si mi vehículo es parte del programa de Campañas de Servicio (Recall)?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>En esta área del sitio de Toyota Costa Rica podrás consultar, por número de placa, si tu vehículo tiene o no un servicio pendiente. En ambos casos te daremos una respuesta concreta y además instrucciones sobre cómo proceder.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Si la respuesta es afirmativa qué debo hacer?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Si tu Toyota tiene un servicio pendiente, deberás contactarnos por cualquier de los medios a disposición para agendar una cita en nuestros Talleres de Servicio o por medio de nuestro Taller Móvil<span class="small">*</span>, que podrá ir hasta tu casa u oficina.</p>
								<p><span class="small">*</span>No aplica para todos los servicios.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Incurriré en algún gasto al realizar el servicio?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>No, el servicio preventivo del programa de Campañas de Servicio (Recall) es completamente gratuito y tu vehículo no incurrirá en gastos adicionales.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Me quedaré sin acceso a mi vehículo durante el servicio?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Buscaremos una hora y fecha conveniente para ajustarnos a tus necesidades.</p>
								<p>Si optás por la opción de Taller Móvil<span class="small">*</span>, nuestro taller se trasladará hasta donde vos estés.</p>
                                <p>La duración de los servicios puede variar.</p>
								<p><span class="small">*</span>No aplica para todos los servicios.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Qué tan pronto recomiendan hacer el servicio?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Recomendamos hacer el servicio de manera inmediata. Para agendar tu cita solo requerimos que nos contactés.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Qué podrán asegurar con el servicio? </button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Si realizás el servicio podremos asegurar un 100% de efectividad en el reemplazo y funcionamiento de la pieza y podrás viajar tranquilo, afirmar tu seguridad, la de tu familia y amigos.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Puedo tomar la decisión de no llevar mi vehículo a servicio? </button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Nuestra promesa es ofrecerte Protección y Respaldo para toda la vida y este tipo de programas forman parte del compromiso que adquirimos con todos los dueños de vehículos Toyota en Costa Rica. Te recomendamos realizar tu servicio lo antes posible para que podás viajar seguro y tranquilo en carretera.</p>
							</div>
						</div>
					</li>
					<li class="sr-fadeInBottom">
						<button type="button" class="collapsible__header js-collapse-next lower-case-header"><i class="mdi mdi-plus"></i>¿Por qué no sabía que mi vehículo tenía un servicio pendiente?</button>
						<div class="collapsible__body">
							<div class="collapsible__padding">
								<p>Las diferentes instancias del <strong>programa de Campañas de Servicio (Recall)</strong> se activan tan pronto como Grupo Purdy Motor sea notificado por Toyota Motor Corporation. A partir de ese momento, realizamos esfuerzos para contactar a nuestros clientes e informarles sobre la revisión pendiente. Este tipo de herramientas como las que ves en este sitio web es solo uno de los esfuerzos que realizamos por otorgar la oportunidad de consulta y notificación alrededor de nuestro programa.</p>
							</div>
						</div>
					</li>
				</ul>
			</div>
		</div>
		</div>


        </section>
    </div>



{% endblock %}



{% block scripts %}

    <script>
        var resetF;
        $(document).ready(function () {

            resetF = $('#llamadoForm').validate({

                errorPlacement: function (error, element) {
                    error.appendTo(element.parent());
                }
                /*,
                rules: {
                    nombre: {require : true},
                    placa: {require : true},
                    tel: {require : true}
                }*/
            });

            $('body').on('click', '#btnConsulta', function () {
                if ($('#llamadoForm').valid()) {
                    var carro = {};
                    carro.placa = $('#placa').val();
                    carro.nombre = $('#nombre').val();
                    carro.tel = $('#tel').val();
                    registroCarro(carro, '#btnConsulta');
                }
            });

            $("body").on("click", "#consultarOtro", function () {
                $("#placa").val("");
                togleForm(this);
            });

        });



        function togleForm(element) {
            $(element).closest("section.container").toggleClass("form");
            $(element).closest("section.container").toggleClass("message");
        }


        function registroCarro(carro, trigger) {
            $.ajax({
                type: 'POST',
                url: '/guardar-llamado',
                data: carro,
                beforeSend: function(){
                    $(".loader").show();
                },
                success: function (response) {
                    if (response.status === 'OK' && response.register.mantenimiento) {

                        $(".msj_response .mdi").addClass("mdi-checkbox-marked-circle");

                    }
                    else  {//(!response.register.mantenimiento)
                        $(".msj_response .mdi").removeClass("mdi-checkbox-marked-circle");
                    }
                    $(".print_response").html(response.register.msn);
                    togleForm(trigger);

                },
                complete: function(){
                    $(".loader").hide();
                }
            });
        }


    </script>


{% endblock %}

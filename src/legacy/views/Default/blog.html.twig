{% extends "base.html.twig"%}
{% block title %}Blog {% endblock %}

{% block meta %}
	<meta name="title" content="Blog | Ford Costa Rica | Grupo Purdy "/>
	<meta name="description" content="Explora el Blog de Ford para conocer las últimas tecnologías, noticias y lanzamientos de 2026. ¡Mantente informado sobre innovación vehicular en nuestra web!" />
	<meta name="keywords" content="noticias grupo purdy motor, innovaciones en movilidad vehicular, innovaci—n vehicular, tecnolog’a en veh’culos nuevos, innovaciones automotrices 2021, noticias ford" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="{{ app.request.locale }}" />
	<meta name="copyright" content="© {{"now" | date("Y")}}" />
{% endblock %}

{% block metaFace %}
	<meta property="og:title" content="Blog | Ford Costa Rica | Grupo Purdy "/>
	<meta property="og:site_name" content="Ford"/>
	<meta property="og:description" content="Explora el Blog de Ford para conocer las últimas tecnologías, noticias y lanzamientos de 2026. ¡Mantente informado sobre innovación vehicular en nuestra web!"/>
{% endblock %}

{% block seo_h1 %}{% include "@LumenCMS/Default/articleTemplate/partials/seo-h1.html.twig" with {h1: "Blog | Ford Costa Rica | Grupo Purdy "} %}{% endblock %}

{% block body %}

<div class="wrapper wrapper-blog">
	<section class="container">
		<h1 class="title margin--top">Blog</h1>
		{#<p class="margin--top text text-medium">Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>#}
		<div class="blog__filter">
			<form id="blog-form">
				<div class="row">
					<div class="col-sm-6">
						<div class="input-wrap-blog">
							<i class="icon icon-search"></i>
							<input type="text" placeholder="Buscar artículo" class="input" name="q" {% if data['q'] is defined %} value="{{ data['q'] }}" {% endif %}>
						</div>
					</div>
				</div>
				<div class="blog-filters">
						<input class="categories-select" id="checkbox-all" type="checkbox" name="select-all" value="all" {% if data['categories'] is not defined %} checked {% endif %}>
						<label for="checkbox-all">Todos ({{ total }})</label>
					{% for sub in subcategories %}
						<input class="categories-select" id="checkbox-{{ sub.id }}" type="checkbox" name="categories[]" value="{{ sub.name }}" {% if data['categories'] is defined and sub.name in data['categories'] %} checked {% endif %}>
						<label for="checkbox-{{ sub.id }}">{{ sub.name }} ({{ sub.articles | length }})</label>
					{% endfor %}
				</div>
			</form>
		</div>

		{% if featured is not null %}
		<div class="row blog-panel blog-featured-panel">
			{#Destacado#}
				<h2 class="title margin--bottom">Destacado</h2>
				
				<a class="blog-link-featured blog" href="{{ path("article_by_alias_and_category", {"category_alias": featured.category.alias, "article_alias": featured.alias}) }}">

					<div class="article-img">
						<img src="{{ featured.getWebPath() | imagine_filter('blog_teaser') }}">
					</div>

					<div class="card__content">
						<h5 class="title">{{ featured.title() }}</h5>
						<p>{{ featured.shortDescription()}}</p>
						<p class="text--primary"><strong>Ver más <i class="icon icon-arrow-right"></i></strong></p>
					</div>
				</a>
		</div>
		{% endif %}
		<div class="margin--top row blog-panel js-equal-height-parent-desktop" id="articulos">
			<h2 class="title margin--bottom">Todos los artículos</h2>
			<div id="results">
				{% include "@LumenApp/Default/partials/blog-results.html.twig" %}
			</div>
		</div>

		{% if moreResults %}
			<div >
			<a id="load-more" class="btn btn-primary">Cargar más</a>
		{% endif %}
	</div>
</section>
	<div class="clearfix-blog"></div>
</div>

{% endblock %}
{% block scripts %}
	<script type="text/javascript">
		var page = 2;
		$('.open-calculate').on('click', function(){
			$('.nav-calculate').slideToggle('slow');
		});
		$('.close-calculate').on('click', function(){
			$('.nav-calculate').slideUp('slow');
		});
		$(".js-select").change(function (evt) {
            $(evt.target).closest("form").submit();
			$(".input-blog").prop('disabled', true);

        });
		$(".search-icon-blog").click(function () {
			$(this).closest("form").submit();
        });

		$(".categories-select").on("click",  function () {
			if ($(this).val() != 'all') {
				$('[name="select-all"]').prop('checked', false)
			} else {
				$('[name="categories[]"]').prop('checked', false)
			}
			$("#blog-form").submit();
        })

		$("#load-more").on("click", function () {
            var btn = $(this);
            btn.addClass("disabled");
            $.ajax({
                url: "{{ path('blog') }}?{{ query }}",
                data: {page: page}
            }).done(function(result) {
                btn.removeClass("disabled");
                $("#results").append(result);
                page += 1;
                if (page > {{ pages }}){
                    btn.css("display", "none");
                }
            });
        })
	</script>

{% endblock %}


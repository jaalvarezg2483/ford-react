{% extends "base.html.twig"%}
{% block title %}Accesorios{% endblock %}

{% block meta %}
    <meta name="identifier-url" content="" />
    <meta name="title" content="Ford"/>
    <meta name="description" content="Ford" />
    <meta name="abstract" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="es" />
    <meta name="copyright" content="© 2016" />
    <meta name="organization" content="">
    <meta name="revisit-after" content="1 day">
    <meta name="origen" content="">
    <meta name="locality" content="San José , Costa Rica">
    <meta name="distribution" content="global">
    <link rel="image_src" href="" >
    <meta name="dcterms.abstract" content="">
    <meta name="dcterms.rightsHolder" content="">
    <meta NAME="robots" CONTENT="noindex">
{% endblock %}

{% block body %}
{% include '@LumenCMS/MenuTemplates/script-select-menu.html.twig' with {'searchMenu': 'Servicios'} %}
 <div class="wrapper">
    <div class="text-left padding-2 bg--accent-light hidden-xs">
		<div class="container">
			<a href="javascript:history.back()" class="text--primary"><i class="icon icon-arrow-left"></i>  Volver</a>
		</div>
	</div>
    <div class="container">
        <h2 class="title margin--top">Cotización de accesorios</h2>
        <div class="row margin--top">
            <div class="col-md-6 bg--accent-light padding-2">
                <h3 class="title">Cotización de accesorios</h3>
                <table>
                    {% for accesory in accessories %}
                        <tr>
                            <td class="padding-1">{{ accesory.name }}</td><td>${{ accesory.price }}</td>
                        </tr>    
                    {% endfor %}
                    <tr>
                        <td class="padding-1"><strong>Total</strong></td><td><strong>${{ total }}</strong></td>
                    </tr> 
                </table>
            </div>
            <div class="col-md-6 padding-2">
                <h3 class="title">¿Qué desea hacer?</h3>
                <a href="{{ path("accesorios-asesor", {slug: app.request.get("slug")}) }}" class="title-icon title-icon--responsive margin--top">
                    <div class="icon-box">
                        <i class="icon icon-phone"></i>
                    </div>
                    <div>
                        <p>Solicitar seguimiento y <br>contactar asesor de ventas</p>
                    </div>
                </a>
                <a href="{{ path("accesorios-correo", {slug: app.request.get("slug")}) }}" class="title-icon title-icon--responsive margin--top">
                    <div class="icon-box">
                        <i class="icon icon-mail"></i>
                    </div>
                    <div>
                        <p>Enviar cotización a mi correo</p>
                    </div>
                </a>
                <a href="{{ path('services-type', {'type': "accesorios"}) }}" class="title-icon title-icon--responsive margin--top">
                    <div class="icon-box">
                        <i class="icon icon-plus"></i>
                    </div>
                    <div>
                        <p>Iniciar nueva cotización</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="text-center col-xs-12">
            <a href="javascript:history.back()" class="btn">Volver</a>
        </div>
    </div>
</div>
    
    
{% endblock %}
{% block scripts %}
    <script type="text/javascript">
        $('.calculate-price').on('click', function(){
            $('.content-insurances').slideDown('fast');
        });
    </script>
{% endblock %}

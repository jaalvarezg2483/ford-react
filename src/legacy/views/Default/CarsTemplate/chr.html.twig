{% extends "base.html.twig"%}
{% block title %} {{ family.webTitle }} {% endblock %}

{% block metaFace %}
	<meta property="og:title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
	<meta property="og:site_name" content="Ford"/>
	<meta property="og:description" content="{{ family.getSeoDescription() }}"/>
	<meta property="og:type" content="website"/>
	<meta property="article:author" content="Ford" />
	<meta property="article:publisher" content="Ford" />
	<meta property="og:image" content="{{server_url ~ "/" ~ family.getWebPath()}}"/>
{% endblock %}

{% block meta %}
	<meta name="title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
	<meta name="description" content="{{ family.getSeoDescription() }}" />
	<meta name="abstract" content="" />
	<meta name="keywords" content="{{ family.getSeoTags() }}" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© {{ "now"|date("Y") }}" />
	<meta name="robots" content="index,follow" />
	<meta name="googlebot" content="index, follow">
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
{% endblock %}

{%  block template_car %}
	<div>
		<div class="card">
			<button type="button" class="card__close js-remove-slide"> <i class="mdi mdi-close"></i> </button>
			<div class="card__image">
				<img src="{{ model_picture }}" alt="Ford {{ model_name }} {{ "now"|date("Y") }}">
			</div>
			<div class="card__content">
				<h2 class="card__title">{{ model_name }}</h2>
				<p class="card__text">{{ family_name }}</p>
			</div>
			<div class="card__action">
				<a href="#" class="compare__replace" >Cambiar vehículo</a>
			</div>
			<input type="hidden" id="code_{{ index }}" data-type="code" data-code="{{ index }}" name="code[{{ index }}]" value="{{ code }}" />
			<input type="hidden" id="year_{{ index }}" data-type="year" name="year[{{ index }}]" value="{{ year }}" />
			<input type="hidden" id="id_{{ index }}" data-type="id" name="id[{{ index }}]" value="{{ id }}" />
		</div>
	</div>
{% endblock %}

{% block body %}
	<script id="car_template" type="text/x-tmpl">
		{% set model_picture = "{image_exterior}" %}
		{% set model_name = "{model_name}" %}
		{% set family_name = "{family_name}" %}
		{% set year = "{year}" %}
		{% set index = "{number}" %}
		{% set code = "{code}" %}
		{% set id = "{id}" %}
        {{ block("template_car") }}
    </script>

    {% if family .slug != "camry" and family.slug != "prius" %}
    	{% set comparar = true %}
	{% else %}
        {% set comparar = false %}
    {% endif %}
{% include 'LumenAppBundle:Default/CarsTemplate:_menu-inner.html.twig' with {especificaciones:true, descargas:true, comparar:comparar, calcular:family.showCalculate, tecnologia: show_technology} %}

<div class="wrapper--car">
	{% include 'LumenAppBundle:Default/CarsTemplate:_breadcrumb.html.twig' %}
	
	<section class="scrollspy text-center car__colors {% if family.name == "Rav4 2.5 L" or family.name == "Corolla" or family.name == "Fortuner" or family.name == "Hilux 2.4L" or family.name == "Hilux 2.8L" or family.slug == "rv4sport2019"%} bgwhite_colors {% endif %}">
		<div class="container">
			{% include 'LumenAppBundle:Default/CarsTemplate:_logo-title.html.twig' %}
			<ul class="car__links">
				{%  for datasheet in family.dataSheets %}
					{% if datasheet.hideFrom360 == false %}
						<li><a href="{{ path("download_datasheet", {"id": datasheet.id, "path" : datasheet.path}) }}" target="_blank"><span class="mdi mdi-arrow-down-bold-circle-outline"></span> {{datasheet.description}}</a></li>
					{% endif %}
				{% endfor %}
                {% if testDrive == true %}
					<li><a href="{{ path("car-test-drive", {"slug": family.slug}) }}"><span class="mdi mdi-steering"></span> Solicitar Prueba de manejo</a></li>
                {% endif %}
			</ul>

			{% if family.name == "Fortuner" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/fortuner/index.html" style="border:none;"> </iframe>
	        {% elseif family.name == "Hilux 2.4L" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/hilux4x4_24L/index.html" style="border:none;"> </iframe>
			{% elseif family.name == "Hilux 2.8L" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/hilux2-8/index.html" style="border:none;"> </iframe>
			{% elseif family.name == "Land Cruiser Prado" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/prado-TMC/index.html" style="border:none;"> </iframe>
			{% elseif family.slug == "rav4-1"%}
				<iframe class="iframe_colors" src="{{ server_url }}/360/rav4-s-2019/index.html" style="border:none;"> </iframe>
			{% elseif family.slug == "rav4-hibrido-electrico-2019"%}
				<iframe class="iframe_colors" src="{{ server_url }}/360/rav4-hib-2019/index.html" style="border:none;"> </iframe>
			{% elseif family.name == "Rav4 2.5 L" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/rav4/index.html" style="border:none;"> </iframe>
			{% elseif family.name == "Yaris Advance" %}
				<iframe class="iframe_colors" src="{{ server_url }}/360/yaris/index.html" style="border:none;"> </iframe>
			{% else %}
				{%  set colorGallery =  baseModel.getColorGallery()%}
		        {% if colorGallery | default(false) %}
		            {%  set colors = colorGallery.getGalleryFiles() %}
					<div class="slider slider--colors js-slider-colors">

		                {%  for color in colors %}
							<div>
								<img src="{{server_url ~ "/" ~color.getWebPath() | default('/img/content/fortuner.png') }}" alt="Ford {{ family.name }} {{ color.color.name | default("") }} {% if family.slug != 'camry' and family.slug != 'prius'%}{{ "now"|date("Y") }}"{% endif %}>
								<p class="text--gray subtitle">{{ color.color.name | default("") }} ({{ color.color.purdyCode | default("") }})
								{% if color.secondaryColor is not null %}
									  | {{ color.secondaryColor.name | default("") }} ({{ color.secondaryColor.purdyCode | default("") }})
								{% endif %}
								</p>
							</div>
		                {% endfor %}
					</div>
					<div class="slider slider--nav slider--colors-nav js-slider-colors-nav">
		                {%  for color in colors %}
							<div>
								{% if color.secondaryColor is not null %}
									<span style="background:linear-gradient(135deg, #{{ color.color.webCode | default("FFFF") }} 50%, #{{ color.secondaryColor.webCode | default("FFFF") }} 50%)"></span>
								{% else %}
									<span style="background-color: #{{ color.color.webCode | default("FFFF") }}"></span>
								{% endif %}
							</div>
		                {% endfor %}
					</div>
		        {% endif %}
		    {% endif %}
			<h2 class="car__title"><strong>{{ family.name }} </strong>{% if family.slug != 'camry' and family.slug != 'prius'%} {{ family.currentYear }} <span>Desde <strong>${{ family.startPrice | number_format(0, ',', '.')}} </strong></span>{% endif %}</h2>
			<div class="car__btns">
				{% if family.showCalculate == true %}
					<a href="{{path('calculate_select_model', {slug: family.slug})}}" class="btn btn--red">Calcular Cuota mensual</a>
				{% endif %}
				{% if family.slug == 'yarishb'%}
					<a href="https://tutoyotaenlinea.com/modelos/YH" class="btn btn--blue">Comprar en línea</a>
				{% endif %}

				{% if family.slug == 'yaris-sedan'%}
					<a href="https://tutoyotaenlinea.com/modelos/YA" class="btn btn--blue">Comprar en línea</a>
				{% endif %}

				{% if family.slug == 'prueba'%}
					<a href="https://tutoyotaenlinea.com/modelos/YA" class="btn btn--blue">Comprar en línea</a>
				{% endif %}
				<button type="button" class="car__scroll js-car-scroll"><i class="mdi mdi-chevron-down"></i></button>
			</div>		
		</div>
	</section>
	<section class="section car__text">
		{% if infoFamily != false %}
			{% include 'LumenAppBundle:Default/CarsTemplate:_description-video.html.twig' %}
		{% else %}
		<div class="container">
			<h2 class="title text-center sr-fadeInLeft">{{ family.webTitle }}</h2>
			<p class="text--large sr-fadeInRight">{{ family.description }}</p>
		</div>
		{% endif %}
	</section>
	<section class="section bg--gray scrollspy text-center car__models" id="modelos">
		<div class="container">
			<h2 class="title sr-fadeInBottom">Modelos</h2>
			<div class="slider slider--nav slider--model-nav js-slider-model js-slider-model-nav">
				{% for model in models %}
				<div>
					<p>{{ model.name }}</p>
				</div>
				{%  endfor %}
			</div>
		</div>
		<div class="slider slider--model js-slider-model js-slider-model-car">
            {% for model in models %}
			<div class="js-slider-model-inner">
				{% set model_img =  model.getFoto() | default('/img/content/car-lg-white.png') %}
				<img src="{{ model_img |  imagine_filter('hero_bg_small') }}" alt="Ford {{ model.name }} {% if family.slug != 'camry' and family.slug != 'prius'%}{{ "now"|date("Y") }}{% endif %}">
				<h2>{{ model.name }}</h2>
                {% if family.slug != 'camry' and family.slug != 'prius'%}
				<p>${{ model.startPrice | number_format(0, ',','.') }}</p>
				{% endif %}
			</div>
            {%  endfor %}

		</div>
		<div class="container sr-fadeInBottom">
			<div class="slider slider--model-specs js-slider-model js-slider-model-specs">
                {% for model in models %}
				<div>
					{% set maxFeatures = model.mainFeatures | length %}
					<ul class="slider--model-specs__main js-equal-height-parent">
						{% for feature in model.mainFeatures | slice(0,6) %}
						<li class="js-equal-height">
							<img src="{{ (feature.image and feature.image != 'imagen.jpg') ? (server_url ~ "/" ~feature.getWebPath()) : '/img/content/icons/seats.png' }}" alt="ícono {{ feature.name }}">
							{{ feature.name }}
						</li>
						{% endfor %}

					</ul>
					{# {% if maxFeatures > 6 %}
					<div class="slider--model__more">
						<ul class="list--bullets">
                            {% for feature in model.features | slice(6,maxFeatures) %}
								<li>
                                    {{ feature.name }}
								</li>
                            {% endfor %}

						</ul>
					</div>
					<button type="button" class="slider--model__more-btn js-collapse-slider"> <i class="mdi mdi-plus"></i> <span>Ver más</span> </button>
					{% endif %} #}
				</div>
                {%  endfor %}
			</div>
		</div>
		<div class="car__btns">
			<a href="{{ server_url }}/documents/Libro-de-Coberturas.pdf" class="btn btn--border-red" target="_blank">DESCARGAR RESPALDO GRUPO PURDY</a>
		</div>
	</section>
	{% if benefits | length > 0 %}
		{% include 'LumenAppBundle:Default/CarsTemplate:_benefits.html.twig' %}
	{% endif %}
	<section class="section scrollspy text-center car__specs" id="especificaciones">
		<h2 class="title sr-fadeInBottom">Especificaciones</h2>
		<div class="slider slider--cards js-slider-cards js-equal-height-parent">
			{%  for type in specs %}
				<div>
					<div class="card card--collapse sr-sequenceFadeInBottom">
						<div class="card__image">
                            {% set imgSpecs =  (type.image and (type.image != 'default.jpg') ) ? type.getWebPath() : (type.featureType.path ? type.featureType.getWebPath() : 'img/content/card-img2.png') %}
							<img src="{{ imgSpecs | imagine_filter('accesories') }}" alt="{{ type.featureType.name }}">
						</div>
						<div class="card__content">
							<h2 class="card__title">{{ type.featureType.name }}</h2>
							<p class="card__text js-equal-height">{{ type.information | default("__Con un motor de 3.1 L Turbo Diesel Intercooler y un caballaje de161HP este auto es el mejor de todos.__")}}</p>
							<div class="card__collapse">
								<ul>
									{% for feature in type.featureType.features %}
									<li>{{ feature.name }}</li>
									{%  endfor %}
								</ul>
								<ul class="disclaimer">
                                    {% for disclaimer in type.disclamers %}
										<li>
											{{ disclaimer.asterisc | trim }}{{ disclaimer.name }}
										</li>
                                    {% endfor %}
								</ul>
							</div>
						</div>
						<div class="card__action">
							<button type="button" class="js-card-collapse">Ver Detalles</button>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</section>

    {% if show_technology | default(false) %}
		<section class="section scrollspy text-center car__specs" id="tecnologia">
			<h2 class="title sr-fadeInBottom">Tecnología</h2>
			<div class="slider slider--cards js-slider-cards js-equal-height-parent">
                {%  for item in technology.items %}
					<div>
						<div class="card card--collapse sr-sequenceFadeInBottom">
							<div class="card__image">
								<img src="{{ (item.image and (item.image != 'default.jpg') ) ? item.image(): 'img/content/card-img2.png' }}" alt="{{ item.title }}">
							</div>
							<div class="card__content">
								<h2 class="card__title">{{ item.title }}</h2>
								<p class="card__text js-equal-height">{{ item.description | default("__Con un motor de 3.1 L Turbo Diesel Intercooler y un caballaje de161HP este auto es el mejor de todos.__")}}</p>
							</div>
						</div>
					</div>
                {% endfor %}
			</div>
		</section>
    {% endif %}

	{% if family.specialBanners %}
		{% for banner in family.specialBanners %}
		<section class="banner--full">
			<a href="{{ banner.link }}">
				<img src="{{ banner.image }}"/>
			</a>
		</section>
		{% endfor %}
	{% endif %}

	<section class="section scrollspy text-center car__gallery" id="galeria">
		<h2 class="title sr-fadeInBottom">Galería</h2>


		<ul class="tabs" role="tablist">
		    {#<li class="tab active"><a href="#fotos" role="tab" data-toggle="tab">Fotos</a></li>#}
			{# dirty code to check number of galleries, original idea was print all kind of galleries#}
		    {% for gallery in baseModel.getModelGalleries(["principal","colour"]) if 0 != gallery.galleryFiles | length  %}
		    <li class="tab {% if loop.first %} active {% endif %}"><a href="#{{ gallery.getGalleryType().getCode() }}" role="tab" data-toggle="tab">{{ gallery.getGalleryType().getCode() | upper }}</a></li>
			{% endfor %}
		    {%  if (family.urlViewInterior or family.urlViewExterior) and ('' != family.urlViewInterior | trim or '' != family.urlViewExterior  | trim)%}
		    <li class="tab"><a href="#360" role="tab" data-toggle="tab">Vistas 360</a></li>
		    {% endif %}
		</ul>


		<!-- Tab panes -->
		<div class="tab-content sr-fadeInBottom">
            {% for gallery in baseModel.getModelGalleries(["principal", "colour"]) if 0 != gallery.galleryFiles | length %}
			<div role="tabpanel" class="tab-pane {% if loop.first %} active {% endif %} clearfix" id="{{ gallery.getGalleryType().getCode() }}">
		    	<ul class="gallery gallery--closed">
			            {% for image in gallery.galleryFiles %}
							{% if image.isVideo() %}
								<li class="gallery__item gallery__item--video filtr-item">
									<a href="{{ image.getVideo() }}" class="js-popup-img js-popup-video">
										<img src="{{ image.getWebPath() | imagine_filter('hero_bg') }}" alt="video {{family.name}}" class="gallery__img">
									</a>
								</li>
							{% else %}
							<li class="gallery__item filtr-item">
								<a href="{{ image.getWebPath() | imagine_filter('hero_bg_medium') }}" class="js-popup-img">
									<img src="{{ image.getWebPath() | imagine_filter('hero_bg') }}" alt="galería {{family.name}}" class="gallery__img">
								</a>
							</li>
							{% endif %}
			            {% endfor %}
		    	</ul>
		    	<div class="gallery__btn">
					<button type="button" class="btn btn--border-white js-gallery-more">Cargar más fotos</button>
					<p><small>*Imágenes con fines ilustrativos. Para especificaciones por favor consultar ficha técnica.</small></p>
				</div>
		    </div>
			{% endfor %}

			{#<div role="tabpanel" class="tab-pane clearfix" id="videos">#}
		    	{#<ul class="gallery">#}
		    		{#{% for gallery in baseModel.getModelGalleries(["principal","colour", "interior", "exterior"]) %}#}
			            {#{% for image in gallery.galleryFiles %}#}
							{#{% if image.isVideo() %}#}
							{#<li class="gallery__item gallery__item--video filtr-item">#}
								{#<a href="{{ image.getVideo() }}" class="js-popup-img js-popup-video">#}
									{#<img src="{{ image.getWebPath() }}" alt="video {{family.name}}" class="gallery__img">#}
								{#</a>#}
							{#</li>#}
							{#{% endif %}#}
			            {#{% endfor %}#}
		            {#{% endfor %}#}
		    	{#</ul>#}
		    {#</div>#}

		    <div role="tabpanel" class="tab-pane clearfix" id="360">
		    	<ul class="gallery">
		    		{%  if " " != family.urlViewExterior | default(" ") %}
					<li class="gallery__item gallery__item--360 filtr-item" data-category="2">
						<a href="{{ family.urlViewExterior }}" class="js-popup-img js-popup-video">
							<img src="{{ baseModel.getOneImage("exterior").getWebPath  }}" alt="360 exterior {{family.name}}" class="gallery__img">
						</a>
					</li>
					{% endif %}
		            {%  if " " != family.urlViewInterior | default(" ") %}
					<li class="gallery__item gallery__item--360 filtr-item" data-category="2">
						<a href="{{ family.urlViewInterior }}" class="js-popup-img js-popup-video">
							<img src="{{ server_url ~ "/" ~ baseModel.getOneImage("interior").getWebPath }}" alt="360 interior {{family.name}}" class="gallery__img">
						</a>
					</li>
		            {% endif %}
		    	</ul>
		    </div>
		</div>

		{# <ul class="tabs js-filter-tabs">
			<li class="tab active"><button type="button" data-filter="all">Todos</button></li>
			<li class="tab"><button type="button" data-filter="1">Fotos</button></li>
            {% for gallery in baseModel.getModelGalleries(["principal","colour", "interior", "exterior"]) if 0 != gallery.galleryFiles | length  %}
			<li class="tab"><button type="button" data-filter="{{ gallery.galleryType.id }}">{{ gallery.galleryType.name }}</button></li>
			{% endfor %}
			{%  if (family.urlViewInterior or family.urlViewExterior) and ('' != family.urlViewInterior | trim or '' != family.urlViewExterior  | trim)%}
			<li class="tab"><button type="button" data-filter="2">Vistas 360°</button></li>
			{% endif %}
		</ul>

		<ul class="gallery gallery--closed filtr-container">
            {% for gallery in baseModel.getModelGalleries(["principal","colour"]) %}
	            {% for image in gallery.galleryFiles %}
					{% if image.isVideo() %}
					<li class="gallery__item gallery__item--video filtr-item" data-category="{{ image.isVideo() ? image.modelGallery.galleryType.id : '1' }}">
						<a href="{{ image.getVideo() }}" class="js-popup-img js-popup-video">
							<img src="{{ image.getWebPath() }}" alt="" class="gallery__img">
						</a>
					</li>
					{% else %}
					<li class="gallery__item filtr-item" data-category="{{ image.isVideo() ? image.modelGallery.galleryType.id : '1' }}">
						<a href="{{ server_url ~ "/" ~ image.getWebPath() }}" class="js-popup-img">
							<img src="{{ server_url ~ "/" ~ image.getWebPath() }}" alt="" class="gallery__img">
						</a>
					</li>
					{% endif %}
	            {% endfor %}
            {% endfor %}
			{%  if " " != family.urlViewExterior | default(" ") %}
			<li class="gallery__item gallery__item--360 filtr-item" data-category="2">
				<a href="{{ family.urlViewExterior }}" class="js-popup-img js-popup-video">
					<img src="{{ server_url ~ "/" ~ baseModel.getOneImage("exterior").getWebPath }}" alt="" class="gallery__img">
				</a>
			</li>
			{% endif %}
            {%  if " " != family.urlViewInterior | default(" ") %}
			<li class="gallery__item gallery__item--360 filtr-item" data-category="2">
				<a href="{{ family.urlViewInterior }}" class="js-popup-img js-popup-video">
					<img src="{{ server_url ~ "/" ~ baseModel.getOneImage("interior").getWebPath }}" alt="" class="gallery__img">
				</a>
			</li>
            {% endif %}
		</ul>
		<div class="gallery__btn">
			<button type="button" class="btn btn--border-white js-gallery-more">Cargar más fotos</button>
		</div> #}

	</section>
	<section class="section scrollspy car__downloads" id="descargas">
		<div class="container">
			<div class="row">
				<div class="col-sm-4">
					<p class="subtitle">Descargas:</p>
				</div>
				<div class="col-sm-8 col-xs-12">
					<div class="link--icon-container">
						{%  for datasheet in family.dataSheets %}
							<a class="link--icon" href="{{ path("download_datasheet", {"id": datasheet.id, "path" : datasheet.path}) }}" target="_blank"> <i class="mdi mdi-download"></i> {{ datasheet.description | replace({"DESCARGAR": ""}) | trim }}</a>
						{% endfor %}
	                    {% if (family.urlCatalog | default(false)) and (family.urlCatalog != ' ') %}
							<a class="link--icon" href="{{ family.urlCatalog }}" target="_blank"> <i class="mdi mdi-download"></i> Catálogo</a>
	                    {% endif %}
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-sm-4">
					<p class="subtitle">Ver en línea:</p>
				</div>
				<div class="col-sm-8 col-xs-12 col-mb">
					<div class="link--icon-container">
                        {%  for datasheet in family.dataSheets %}
							<a class="link--icon" href="{{ path("view-pdf", {"id": datasheet.id, "slug" : family.slug}) }}" target="_blank"> <i class="mdi mdi-download"></i> {{ datasheet.description | replace({"DESCARGAR": ""}) | trim }}</a>
                        {% endfor %}
					</div>
				</div>
			</div>
		</div>
	</section>
	{#<section class="section scrollspy text-center car__accesories" id="accesorios">#}
		{#<h2 class="title sr-fadeInBottom">Accesorios</h2>#}
		{#<div class="slider slider--cards js-slider-cards js-equal-height-parent">#}
			{#{% for accesory in accesories %}#}
    		{#<div>#}
    			{#<div class="card sr-sequenceFadeInBottom">#}
    				{#<div class="card__image">#}
                        {#{% set img_accesory = accesory.getFoto() ? accesory.getFoto() | default('/img/content/card-img2.png') %}#}
						{#<img src="{{ img_accesory | imagine_filter('accesories') }}" alt="{{ accesory.name }}">#}
    	            {#</div>#}
    	            {#<div class="card__content js-equal-height">#}

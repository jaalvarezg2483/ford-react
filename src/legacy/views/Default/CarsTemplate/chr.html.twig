{% if family .slug != "camry" and family.slug != "prius" %}
<div id="compare" class="modal fade modal--compare">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal__inner">
				<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>
				<h2 class="subtitle--large text-center">Seleccionar Vehículo</h2>
			</div>
			<div class="modal__inner bg--gray">
				<form action="" class="container">
					<p class="subtitle">Elegir vehículo</p>
					<div class="row">
						<div class="col-sm-6 select">
							<select name="family" id="compare_family" data-target="compare_model" data-repo="familyModel" class="js-select">
								<option value="">Seleccione una familia</option>
                                {% for family in familyList %}
									<option value="{{ family.id }}">{{ family.name }}</option>
                                {% endfor %}
							</select>
						</div>
						<div class="col-sm-6 select">
							<select name="model" id="compare_model" class="js-select" data-index="models" data-text="name">
								<option value="">Debe seleccionar primero una Familia</option>
							</select>
						</div>
					</div>
					<div class="text-center">
						<button type="button" class="btn btn--border-black vehicle_click">Elegir Vehículo</button>
					</div>
				</form>
			</div>
		    <div class="modal__inner">
		        <h2 class="subtitle--large text-center">Otros modelos relacionados</h2>
		    </div>
			<div class="modal__inner">
				<div class="container">
					<div class="row row--flex">
                        {% for vehicle in array_rand(models, 4, true, vechile_agregar) %}
							<div class="col-sm-3">
								<input type="radio" class="radio radio--large car__select" id="car{{ loop.index }}" name="car" value="{{ vehicle.id }}" data-family="{{ vehicle.family.id }}">
								<label for="car{{ loop.index }}" class="family family--radio">
									<div class="family__img">
		                                <img src="{{ server_url ~ vehicle.getFoto() }}" alt="Ford {{ vehicle.name }} {{ "now"|date("Y") }}" class="img-responsive">
		                            </div>
									<div class="family__text">
										<h2>{{ vehicle.name }}</h2>
										<p class="family__cta-price">desde <span>$ {{ vehicle.startPrice | number_format(0, ',', '.')}} </span></p>
									</div>
									<p class="check">Elegir</p>
								</label>
							</div>
                        {% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% endif %}
<div class="row">
	<div class="col-xs-10 col-xs-offset-1 col-md-10 col-md-offset-1 col-lg-10 col-lg-offset-1">

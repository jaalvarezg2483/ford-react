	<div class="car__btns">
		{% if family.showCalculate == true %}
			<a href="{{path('calculate_select_model', {slug: family.slug})}}" class="btn btn--red">Calcular Cuota mensual</a>
		{% endif %}
		{% if family.slug == 'yarishb'%}
			<a href="https://tutoyotaenlinea.com/modelos/YH" class="btn btn--blue">Comprar en línea</a>
		{% endif %}

		{% if family.slug == 'yaris-sedan'%}
			<a href="https://tutoyotaenlinea.com/modelos/YA" class="btn btn--blue">Comprar en línea</a>
		{% endif %}

		{% if family.slug == 'prueba'%}
			<a href="https://tutoyotaenlinea.com/modelos/YA" class="btn btn--blue">Comprar en línea</a>
		{% endif %}
	</div>
	{% if family .slug != "camry" and family.slug != "prius" %}
	<section class="section scrollspy text-center car__compare bg--gray" id="comparar">
		<form action="{{ path("comparador") }}" method="get">
		<div class="container">
			<h2 class="title sr-fadeInBottom">Comparar vehículo</h2>

            <div class="slider slider--cards slider--compare js-slider-compare">
                <div>
                    <button type="button" class="card compare__add">
						<div>
							<i class="mdi mdi-car"></i>
	                        <p class="subtitle">Agregar otro vehículo</p>
						</div>
                    </button>
                </div>
				{%  set vechile_agregar = array_rand(models, 2) %}
                {% for vehicle in  vechile_agregar%}
                    {% set model_picture = server_url ~ vehicle.getFoto() %}
                    {% set model_name = vehicle.name %}
                    {% set family_name = vehicle.family.name %}
                    {% set index = loop.index %}
                    {% set code = vehicle.code %}
                    {% set year = vehicle.year %}
					{% set id = vehicle.id %}
                    {{ block("template_car") }}
                {% endfor %}

            </div>
			<a href="{{ path("comparador") }}" class="btn btn--black compare_submit">Comparar Ahora</a>
		</div>
		</form>
	</section>
	{% endif %}
    {% if 0 < (tePodriaGustar | length) %}
	<section class="section scrollspy text-center car__suggest">
		<h2 class="title sr-fadeInBottom">te podría gustar</h2>
		<div class="slider slider--model js-slider-model-car">
            {% for canLikeFamily in tePodriaGustar%}
				<div class="js-slider-model-inner">
					<a href="{{ path("model_list", {slug: canLikeFamily.slug}) }}" class="slider__link">
						<img src="{{ server_url ~ canLikeFamily.getFoto3() }}" alt="Ford {{ canLikeFamily.name }} {{ "now"|date("Y") }}">
						<h2>{{ canLikeFamily.name }}</h2>
                        {% if canLikeFamily.slug != "camry" and canLikeFamily != "prius" %}
							<p>${{ canLikeFamily.startPrice | number_format(0,',', '.') }}</p>
                        {% endif %}
					</a>
				</div>
            {% endfor %}
		</div>
	</section>
    {% endif %}

{% extends "base.html.twig"%}
{% block title %} {{ family.webTitle }} {% endblock %}

{% block metaFace %}
	<meta property="og:title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
	<meta property="og:site_name" content="Ford"/>
	<meta property="og:description" content="{{ family.getSeoDescription() }}"/>
	<meta property="og:type" content="website"/>
	<meta property="article:author" content="Ford" />
	<meta property="article:publisher" content="Ford" />
	<meta property="og:image" content="{{server_url ~ "/" ~ family.getWebPath()}}"/>
{% endblock %}

{% block meta %}
	<meta name="title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
	<meta name="description" content="{{ family.getSeoDescription() }}" />
	<meta name="abstract" content="" />
	<meta name="keywords" content="{{ family.getSeoTags() }}" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© {{ "now"|date("Y") }}" />
	<meta name="robots" content="index,follow" />
	<meta name="googlebot" content="index, follow">
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
{% endblock %}

{%  block template_car %}
	<div>
		<div class="card">
			<button type="button" class="card__close js-remove-slide"> <i class="mdi mdi-close"></i> </button>
			<div class="card__image">
				<img src="{{ model_picture }}" alt="Ford {{ model_name }} {{ "now"|date("Y") }}">
			</div>
			<div class="card__content">
				<h2 class="card__title">{{ model_name }}</h2>
				<p class="card__text">{{ family_name }}</p>
			</div>
			<div class="card__action">
				<a href="#" class="compare__replace" >Cambiar vehículo</a>
			</div>
			<input type="hidden" id="code_{{ index }}" data-type="code" data-code="{{ index }}" name="code[{{ index }}]" value="{{ code }}" />
			<input type="hidden" id="year_{{ index }}" data-type="year" name="year[{{ index }}]" value="{{ year }}" />
		</div>
	</div>
{% endblock %}

{% block body %}
	<script id="car_template" type="text/x-tmpl">
		{% set model_picture = "{image_exterior}" %}
		{% set model_name = "{description}" %}
		{% set family_name = "{family_name}" %}
		{% set year = "{year}" %}
		{% set index = "{number}" %}
		{% set code = "{code}" %}
        {{ block("template_car") }}
    </script>

{% include 'LumenAppBundle:Default/CarsTemplate:_menu-inner.html.twig' with {descargas:true, tecnologia: show_technology} %}

<div class="wrapper--car">
	{% include 'LumenAppBundle:Default/CarsTemplate:_breadcrumb.html.twig' %}
	<section class="scrollspy text-center car__colors">
		<div class="container">
			{% include 'LumenAppBundle:Default/CarsTemplate:_logo-title.html.twig' %}

			{%  set colorGallery =  baseModel.getColorGallery()%}

			<div class="slider slider--colors js-slider-colors">
				<div>
					<img src="{{ server_url ~ family.getFoto3() }}" alt="Ford {{ family.name }} {{ "now"|date("Y") }}">
				</div>
			</div>


			<h2 class="car__title"><strong>{{ family.name }} </strong> {{ family.currentYear }} <span>Desde <strong>${{ family.startPrice | number_format(0, ',', '.')}} </strong></span></h2>
		</div>
	</section>
    {% if '' != family.webTitle | trim  or '' != family.description | trim  %}
		<section class="section car__text">
			{% if infoFamily != false %}
					{% include 'LumenAppBundle:Default/CarsTemplate:_description-video.html.twig' %}
				{% else %}
				<div class="container">
					<h2 class="title text-center sr-fadeInLeft">{{ family.webTitle }}</h2>
					<p class="text--large sr-fadeInRight">{{ family.description }}</p>
				</div>
				{% endif %}
		</section>
    {% endif %}
    {% if 0 < models |length %}
	<section class="section bg--gray scrollspy text-center car__models" id="modelos">
		<div class="container">
			<h2 class="title sr-fadeInBottom">Modelos</h2>
			<div class="slider slider--nav slider--model-nav js-slider-model js-slider-model-nav">
				{% for model in models %}
				<div>
					<p>{{ model.name }}</p>
				</div>
				{%  endfor %}
			</div>
		</div>
		<div class="slider slider--model js-slider-model js-slider-model-car">
            {% for model in models %}
			<div class="js-slider-model-inner">
				<img src="{{server_url ~ "/" ~ model.getFoto() | default('/img/content/car-lg-white.png') }}" alt="Ford {{ model.name }} {{ "now"|date("Y") }}">
				<h2>{{ model.name }}</h2>
				<p>${{ model.startPrice | number_format(0, ',','.') }}</p>
			</div>
            {%  endfor %}

		</div>
		<div class="container sr-fadeInBottom">
			<div class="slider slider--model-specs js-slider-model js-slider-model-specs">
                {% for model in models %}
				<div>
					{% set maxFeatures = model.mainFeatures | length %}
					<ul class="slider--model-specs__main js-equal-height-parent">
						{% for feature in model.mainFeatures | slice(0,6) %}
						<li class="js-equal-height">
							<img src="{{ (feature.image and feature.image != 'imagen.jpg') ? (server_url ~ "/" ~feature.getWebPath()) : '/img/content/icons/seats.png' }}" alt="ícono {{ feature.name }}">
							{{ feature.name }}
						</li>
						{% endfor %}

					</ul>
					{# {% if maxFeatures > 6 %}
					<div class="slider--model__more">
						<ul class="list--bullets">
                            {% for feature in model.features | slice(6,maxFeatures) %}
								<li>
                                    {{ feature.name }}
								</li>
                            {% endfor %}

						</ul>
					</div>
					<button type="button" class="slider--model__more-btn js-collapse-slider"> <i class="mdi mdi-plus"></i> <span>Ver más</span> </button>
					{% endif %} #}
				</div>
                {%  endfor %}
			</div>
		</div>
        {% if salesforceModels > 0 %}
			<div class="container car__btns section ">
				<a href="{{ path("contactar-asesor-trabajo", {"slug": family.slug}) }}" class="btn btn--red">Contactar asesor</a>
			</div>
        {% endif %}
		<div class="car__btns">
			<a href="{{ server_url }}/documents/Libro-de-Coberturas.pdf" class="btn btn--border-red" target="_blank">COBERTURAS</a>
		</div>
	</section>
    {% endif %}
	{% if benefits | length > 0 %}
		{% include 'LumenAppBundle:Default/CarsTemplate:_benefits.html.twig' %}
	{% endif %}
	{#<section class="section scrollspy text-center car__specs" id="especificaciones">#}

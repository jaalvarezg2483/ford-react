<div class="container text-center">
    <h2>{{ family.webTitle }}</h2>
    <br>
    {% if infoFamily.video != "" and infoFamily.video is not null %}
        <a href="#" data-toggle="modal" data-target="#modal-video" class="btn btn--red"><i class="mdi mdi-play"></i>  Ver video</a>
    {% endif %}
    <br>
    <p>{{ family.description }}</p>
</div>



<!-- MODAL --> 
<div id="modal-video" class="modal fade modal-video">
	<div class="modal-dialog">
		<div class="modal-content">
			{% if infoFamily != false %}
				{% if infoFamily.video != "" and infoFamily.video is not null %}
					<iframe width="460" height="315" src="https://youtube.com/embed/{{ infoFamily.video }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
				{% endif %}
			{% endif %}
		</div>
	</div>
</div>
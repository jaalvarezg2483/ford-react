<section class="section scrollspy text-center" id="beneficios">
		<div class="bg">
			<div class="container text-center">
				<h2 class="title title-margin">beneficios</h2>
				<ul class="list--icons list--benefits js-equal-height-parent">
					{% for benefit in benefits[0:6]  %}
					<li class="js-equal-height text-center benefit">
						<i class="mdi {{ benefit.icon }}"></i>
						<p class="text">
							{{ benefit.title }} <br><small>{{ benefit.disclaimer }}</small>
						</p>
						<p class="description hidden">
							{{ benefit.description }}
						</p>
					</li>
					{% endfor %}
				</ul>	
				<ul class="more--benefits hidden list--icons list--benefits js-equal-height-parent">
					{% for benefit in benefits[6:]  %}
						<li class="js-equal-height text-center benefit">
							<i class="mdi {{ benefit.icon }}"></i>
							<p class="text">
								{{ benefit.title }} <br><small>{{ benefit.disclaimer }}</small>
							</p>
							<p class="description hidden">
								{{ benefit.description }}
							</p>
						</li>
					{% endfor %}
				</ul>
				<a class="benefits--expand" href="#"><i class="mdi mdi-plus"></i>  <span>Ver más</span></a>
			</div>
		</div>
	</section>
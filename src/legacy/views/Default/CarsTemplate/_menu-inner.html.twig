{% set route = app.request.get('_route') %}

<div class="menu--inner menu--inner-car" id="carMenu">
	<ul class="tabs--drop-mobile">
        <li class="tab"><a {% if route == 'model_list' %}class="current"{% endif %} href="{{  path('model_list', {"slug" : family.slug}) }}"><i class="icon icon-profile hidden-xs"></i> Perfil</a></li>
        {% if family.blockCharacteristics == false and hasOtherCharacteristics(family) == true %}
        <li class="tab"><a {% if route == 'model_list_characteristic' %}class="current"{% endif %} href="{{  path('model_list_characteristic', {"slug" : family.slug}) }}"><i class="icon icon-chart hidden-xs"></i> Características</a></li>
        {% endif %}
        {% if family.blockSpecifications == false %}
        <li class="tab"><a {% if route == 'model_list_specs' %}class="current"{% endif %} href="{{  path('model_list_specs', {"slug" : family.slug}) }}"><i class="icon icon-engine hidden-xs"></i> Especificaciones</a></li>
        {% endif %}
        {% if family.blockGallery == false %}
        <li class="tab"><a {% if route == 'model_list_gallery' %}class="current"{% endif %} href="{{  path('model_list_gallery', {"slug" : family.slug}) }}"><i class="icon icon-image hidden-xs"></i> Galería</a></li>
        {% endif %}
    </ul>
</div>
<div class="overlay"></div>
{% extends "base.html.twig"%}
{% block title %} {{ family.webTitle }} {% endblock %}
{% set familyWhatsapp = whatsapp ~ "&text=¡Quiero RESERVAR el " ~ family.familyBrand.name ~ " " ~ family.name ~ "!" %}

{# PurdyGO purdy Go reservation url#}
{% set purdyGoReservationLink = family.reservationUrl|default('#') %}

{% block metaFace %}
    <meta property="og:title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
    <meta property="og:site_name" content="Ford"/>
    <meta property="og:description" content="{{ family.getSeoDescription() }}"/>
    <meta property="og:type" content="website"/>
    <meta property="article:author" content="Ford" />
    <meta property="article:publisher" content="Ford" />
    <meta property="og:image" content="{{server_url ~ "/" ~ family.getWebPath()}}"/>
{% endblock %}

{% block meta %}
    <meta name="title" content="{{ family.currentYear }} {{ family.familyBrand.name }} {{ family.name }} {{ family.getFamilyTypesToString() }} | {{ family.webTitle }}"/>
    <meta name="description" content="{{ family.getSeoDescription() }}" />
    <meta name="abstract" content="" />
    <meta name="keywords" content="{{ family.getSeoTags() }}" />
    <meta name="author" content="" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="es" />
    <meta name="copyright" content="© {{ "now"|date("Y") }}" />
    <meta name="robots" content="index,follow" />
    <meta name="googlebot" content="index, follow">
    <meta name="organization" content="">
    <meta name="revisit-after" content="1 day">
    <meta name="origen" content="">
    <meta name="locality" content="San José , Costa Rica">
    <meta name="distribution" content="global">
{% endblock %}

{%  block template_car %}
    <div>
        <div class="card">
            <button type="button" class="card__close js-remove-slide"> <i class="mdi mdi-close"></i> </button>
            <div class="card__image">
                <img src="{{ model_picture }}" alt="Ford {{ model_name }} {{ "now"|date("Y") }}">
            </div>
            <div class="card__content">
                <h2 class="card__title">{{ model_name }}</h2>
                <p class="card__text">{{ family_name }}</p>
            </div>
            <div class="card__action">
                <a href="#" class="compare__replace" >Cambiar vehículo</a>
            </div>
            <input type="hidden" id="code_{{ index }}" data-type="code" data-code="{{ index }}" name="code[{{ index }}]" value="{{ code }}" />
            <input type="hidden" id="year_{{ index }}" data-type="year" name="year[{{ index }}]" value="{{ year }}" />
            <input type="hidden" id="id_{{ index }}" data-type="id" name="id[{{ index }}]" value="{{ id }}" />
        </div>
    </div>
{% endblock %}


{% block customStyles %}
    {% if banner is not null %}
        <style>
            .car-profile-hero {
                background-image: url("{{ banner.imageMobile }}");
            }
            @media screen and (min-width: 768px){
                .car-profile-hero {
                    background-image: url("{{ banner.image }}");
                }
            }
        </style>
    {% endif %}
{% endblock %}

{% block body %}
<script id="car_template" type="text/x-tmpl">
		{% set model_picture = "{image_exterior}" %}
		{% set model_name = "{model_name}" %}
		{% set family_name = "{family_name}" %}
		{% set year = "{year}" %}
		{% set index = "{number}" %}
		{% set code = "{code}" %}
		{% set id = "{id}" %}
        {% set isMobile = false %}
        {{ block("template_car") }}
    </script>

  

{% if family.slug != "camry" and family.slug != "prius" %}
    {% set comparar = true %}
{% else %}
    {% set comparar = false %}
{% endif %}


<div class="wrapper--car">
    <div class="profile-back hidden-md">
        <a class="btn btn--clear" href="javascript:history.back()"><i class="icon icon-arrow-left"></i> Volver</a>
    </div>
    <div class="hero car-profile-hero">
        {% include 'LumenAppBundle:Default/CarsTemplate:_menu-inner.html.twig' with {page:'profile'} %}
    </div>

    <section>
        <div class="car-profile-description">
            <div class="car-profile-text">
                <h1 class="title"><span>{{ family.familyBrand.name }}</span> {{ family.name }}</h1>
                {% if family.hidePrice is defined and not family.hidePrice %}
                    <h3 class="title"><span>desde:</span> ${{ family.startPrice | number_format(0, ',', '.')}}</h3>
                {% else %}
                    {% if family.comingSoon is defined and family.comingSoon %}
                        <h3 class="title">Coming Soon</h3>
                    {% endif %}
                {% endif %}
                {% if family.description2 %}
                    <p class="text text--padding-right text--medium margin--top">{{ family.description2 }}</p>
                {% endif %}
            </div>
            <div class="car-profile-text">
                <p class="text text--medium">{{ family.description }}</p>
                <div class="container">
                    {% if purdyGoReservationLink != '#' %}
                        <a href="{{ purdyGoReservationLink }}" class="btn btn--icon" target="_blank" style='background-color:#00095B; color:white'>Ir a PURDY GO y Reservar en Línea</a>
                    {% endif %}

                    <a href="{{ familyWhatsapp }}" class="btn btn--wa-green btn--icon" target="_blank"><i class="icon icon-whatsapp"></i> Negociá con un Asesor</a>

                    {% if family.showCalculate == true %}
                        <a href="{{path('calculate_select_model', {slug: family.slug})}}" class="btn btn--primary btn--icon"><i class="icon icon-calculator"></i> Calcular Financiamiento</a>
                    {% endif %}
{#                    {% if test_drive == true %}#}
{#                        <a href="{{ path("car-test-drive", {"slug": family.slug}) }}" class="btn btn--icon"><i class="icon icon-car-alt"></i> Solicitar Test Drive</a>#}
{#                    {% endif %}#}
                   
                   
                </div>
            </div>
        </div>
    </section>
    {% if family.webDescription != "" %}
        <section class="car-profile-lead bg--accent-light">
            <div class="container">
                <h3 class="title">{{ family.webTitle }}</h3>
                <p class="text text-medium">{{ family.webDescription }}</p>
            </div>
        </section>
    {% endif %}

    {% if family.urlView360 != " " and family.urlView360 != "" %}

        <section>
            <div class="container container-360 text-center">
                <iframe class="iframe_colors"
                        src="{{ family.urlView360 }}"
                        style="border:none;"> </iframe>
            </div>
        </section>

    {% else %}

        <section class="car__colors">
            <div class="container">
                {%  set colorGallery =  baseModel.getColorGallery()%}
                {% if colorGallery | default(false) %}
                    {%  set colors = colorGallery.getGalleryFiles() %}
                    <div class="slider slider--colors js-slider-colors">

                        {%  for color in colors %}
                            <div>
                                {% set imgColor = "/" ~color.getWebPath() | default('/img/content/fortuner.png') %}
                                <img src="{{ imgColor |  imagine_filter('hero_bg_small') }}" alt="Ford {{ family.name }} {{ color.color.name }} {% if family.slug != 'camry' and family.slug != 'prius'%}{{ "now"|date("Y") }}"{% endif %}>
                            </div>
                        {% endfor %}
                    </div>
                    <div id="colorSelect">
                        <p class="text-center text--medium">Seleccione un color</p>
                        <div class="slider slider--nav slider--colors-nav js-slider-colors-nav">

                            {%  for color in colors %}
                                <div>
                                    {% if color.secondaryColor is not null %}
                                        <span style="background:linear-gradient(135deg, #{{ color.color.webCode | default("FFFF") }} 50%, #{{ color.secondaryColor.webCode | default("FFFF") }} 50%)"
                                        data-colorName="{{ color.color.name }} ({{ color.color.purdyCode }}) | {{ color.secondaryColor.name }} ({{ color.secondaryColor.purdyCode }})"
                                        data-colorDisclaimer="{{ color.colorDisclaimer }}"
                                        ></span>
                                    {% else %}

                                        <span style="background-color: #{{ color.color.webCode }}" data-colorName="{{ color.color.name }} ({{ color.color.purdyCode }})"
                                                        data-colorDisclaimer="{{ color.colorDisclaimer }}"
                                        ></span>

                                    {% endif %}
                                        <p class="color-name text--bold">{{ color.color.name }}</p>
                                </div>
                            {% endfor %}
                        </div>
                        
                    </div>
                {% endif %}
            </div>
        </section>

    {% endif %}

    <section class="car-profile-features">
        <div class="container">
            <h2 class="title">Características destacadas</h2>
            <div class="car-profile-features-slider">
                {% for characteristic in featured_characteristics %}
                    <div class="features-slide">
                        <div class="car-profile-feature-card">
                            <div class="car-profile-feature-img">
                                <img src="{{ characteristic.image }}" alt="{{ characteristic.name }}">
                            </div>
                            <div class="car-profile-feature-text">
                                <h3 class="title text--light">{{ characteristic.name }}</h3>
                                <p class="text--light">{{ characteristic.description | raw  }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="text-center margin--top">
                <a href="{{  path('model_list_characteristic', {"slug" : family.slug}) }}" class="btn">Ver todas las características</a>
            </div>
        </div>
    </section>
    <section class="car-profile-models margin--top">
        <div class="container">
            <h2 class="title">Modelos ({{models | length}})</h2>
            <p class="text">{{ family.modelsText }}</p>
        </div>
        <div class="car-profile-models-slider">
            <div class="slider slider--model js-slider-model js-slider-model-car">
                {% for model in models %}
                    <div class="js-slider-model-inner">
                        <h3 class="title">{{family.familyBrand.name}}  {{ model.name }}</h3>
                         {% if family.hidePrice is defined and not family.hidePrice %}
                            <p>desde ${{ model.startPrice | number_format(0, ',','.') }}</p>
                        {% else %}
                            {% if family.comingSoon is defined and family.comingSoon %}
                                <h3>Coming Soon</h3>
                            {% endif %}
                        {% endif %}
                       
                        {% set model_img =  model.getFoto() | default('/img/content/car-lg-white.png') %}
                        <img src="{{ model_img |  imagine_filter('hero_bg_small') }}" alt="Ford {{ model.name }} {% if family.slug != 'camry' and family.slug != 'prius'%}{{ "now"|date("Y") }}{% endif %}">
                    </div>
                {%  endfor %}
            </div>
        </div>
        <div class="container">
            <div class="row center">
                {% if purdyGoReservationLink != '#' %}
                    <a href="{{ purdyGoReservationLink }}" class="btn btn--icon" target="_blank" style='background-color:#00095B; color:white'>Ir a PURDY GO y Reservar en Línea</a>
                {% endif %}
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="title-icon">
                        <div class="icon-box">
                            <i class="icon icon-engine"></i>
                        </div>
                        <div>
                            <p>Especificaciones<p> 
                            <h3 class="title">Técnicas</h3>
                        </div>
                    </div>
                    <p>¿Querés conocer especificaciones técnicas?</p>
                    <a class="btn btn--clear" href="{{ path('model_list_specs', {'slug': family.slug }) }}">Ver especificaciones técnicas <i class="icon icon-arrow-right"></i></a>
                </div>
                <div class="col-md-8">
                    <div class="slider slider--model-specs js-slider-model js-slider-model-specs">
                        {% for model in models %}
                            <div>
                                <ul class="slider--model-specs__main js-equal-height-parent">
                                    {% for feature in model.mainFeatures | slice(0,6) %}
                                        <li class="js-equal-height">
                                            <img src="{{ (feature.image and feature.image != 'imagen.jpg') ? (server_url ~ "/" ~feature.getWebPath()) : '/img/content/icons/seats.png' }}" alt="ícono {{ feature.name }}">
                                            <p>{{ feature.name }}</p>
                                        </li>
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-gas"></i> <p>Capapacidad del tanque: {{model.tankCapacity}}</p>#}
                                    {#</li>#}
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-station"></i> <p>Tanque de {{model.gas}}</p>#}
                                    {#</li>#}
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-motor"></i> <p>Motor: {{model.motor}}</p>#}
                                    {#</li>#}
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-tacometro"></i> <p>Potencia HP {{model.potencyHp}}</p>#}
                                    {#</li>#}
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-users-group"></i> <p>{{model.pasajeros}} pasajeros</p>#}
                                    {#</li>#}
                                    {#<li class="js-equal-height">#}
                                        {#<i class="icon icon-wheel"></i> <p>Llantas: {{model.tires}}</p>#}
                                    {#</li>#}
                                    {% endfor %}
                                </ul>
                                <div class="text-left">
                                    {% if family.showCalculate == true %}
                                        {#<a class="btn btn--primary margin--top" href="{{ path('calculate_select_model', {slug: family.slug}) }}"> Calcular financiamiento</a>#}
                                        <a class="btn btn--primary margin--top" href="{{ path('calculate-all', {slug: family.slug, code: model.code}) }}"> Calcular financiamiento</a>
                                    {% endif %}
                                </div>
                            </div>
                        {%  endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class=" container">
        
        <h2 class="title">Galería</h2>
        

        <div class="margin--top">
            <div class="gallery-slider">
            {%  set principalGallery =  baseModel.getPrincipalGallery()%}
            {% if principalGallery | default(false) %}
            {%  set photos = principalGallery.getGalleryFiles() | reverse | slice(0,3) %}
                {%  for photo in photos %}
                    <div class="gallery__item">
                        <div class="profile-img-container" style="background-image:url('{{ server_url ~ "/" ~ photo.getWebPath() | default('/img/ford/characteristic.png') }}')">
                        </div>
                        <p class="margin-top">{{ photo.description }}</p>
                    </div>
                {% endfor %}
            {% endif %}
            </div>
        </div>
        <div class="message-box">
            <p>* Imágenes con fines ilustrativos</p>
        </div>
        <div class="text-center margin--top">
         <a class="btn" href="{{ path('model_list_gallery', {'slug': family.slug }) }}">Ver todas</a>
        </div>
    </section>

    <div class="bg--accent-light">
        <div class="container">
            <div class="row row-margin">
               {% if family.warranty is not null %}

                <div class="col-md-6">
                    <div class="title-icon">
                        <div class="icon-box">
                            <i class="icon icon-checkbox"></i>
                        </div>
                        <div>
                            <h3 class="title">COBERTURA DE RESPALDO DE AUTOMOTRIZ</h3>
                        </div>
                    </div>
                    <p>{{ family.warranty.description | raw }}</p>
                    <a href="{{ family.warranty.fileReal }}" class="btn btn--clear">DESCARGAR RESPALDO GRUPO PURDY<i class="icon icon-download"></i></a>
                </div>
                {% endif %}

                {% if family.showCalculate == true %}
                <div class="col-md-6">
                    <div class="title-icon">
                        <div class="icon-box">
                            <i class="icon icon-calculator"></i>
                        </div>
                        <div>
                            <p>Calcule su</p> 
                            <h3 class="title">financiamiento</h3>
                        </div>
                    </div>
                    <p>Cotizar tu FORD es muy fácil. Elegí el modelo y extras y obtené un estimado de la cuota.</p>
                    <a href="{{path('calculate_select_model', {slug: family.slug})}}" class="btn btn--clear">Calcular <i class="icon icon-arrow-right"></i></a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <section>
        <div class="container">
            {% if promotions | length > 0 %}
            <h2 class="title">Promociones Disponibles</h2>
                <div class="slider slider--promotions">
                {% for promotion in promotions | reverse %}
                    <div class="card card--promo">
                        <img src="{{ promotion.image }}" alt="{{ promotion.name }}">
                    </div>
                {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    <div class="message-box">
        <p>* Imágenes con fines ilustrativos</p>
    </div>

    {% if family.pixelCode != null %}
        <!-- Code for Action: {{ family.name }} _Conversion_Calcular Cuota_Nov2018 -->
        <!-- Begin Sizmek DSP Conversion Action Tracking Code Version 9 -->
        <script type='text/javascript'>
            (function() {
                var w = window, d = document;
                var s = d.createElement('script');
                s.setAttribute('async', 'true');
                s.setAttribute('type', 'text/javascript');
                s.setAttribute('src', '//c1.rfihub.net/js/tc.min.js');
                var f = d.getElementsByTagName('script')[0];
                f.parentNode.insertBefore(s, f);
                if (typeof w['_rfi'] !== 'function') {
                    w['_rfi']=function() {
                        w['_rfi'].commands = w['_rfi'].commands || [];
                        w['_rfi'].commands.push(arguments);
                    };
                }
                _rfi('setArgs', 'ver', '9');
                _rfi('setArgs', 'rb', '36891');
                _rfi('setArgs', 'ca', '{{ family.pixelCode }}');
                _rfi('setArgs', '_o', '36891');
                _rfi('setArgs', '_t', '{{ family.pixelCode }}');
                _rfi('track');
            })();
        </script>
        <noscript>
            <iframe src='//{{ family.pixelCode }}p.rfihub.com/ca.html?rb=36891&ca={{ family.pixelCode }}&_o=36891&_t={{ family.pixelCode }}&ra=YOUR_CUSTOM_CACHE_BUSTER' style='display:none;padding:0;margin:0' width='0' height='0'>
            </iframe>
        </noscript>
        <!-- End Sizmek DSP Conversion Action Tracking Code Version 9 -->
    {% endif %}
    {% endblock %}

    {% block scripts %}
        <script>
            var serverPath = '{{ server_url }}';
            scrollspy( $('#carMenu') );

            function SetBg(item) {
                var bg = item.data('bg-mobile');
                if(window.outerWidth > 992){
                    bg = item.data('bg-desktop');
                } 
                item.css('background-image', 'url('+bg+')')
            }

            $(document).ready(function(){
                $('.car-profile-gallery-link').each(function(){
                    SetBg($(this))
                })
                $(window).on('resize', function(){
                    $('.car-profile-gallery-link').each(function(){
                        SetBg($(this))
                    })
                })
            })
        </script>

    {% endblock %}
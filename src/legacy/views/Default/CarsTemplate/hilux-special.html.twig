									{#</ul>#}
								{#</div>#}
							{#</div>#}
							{#<div class="card__action">#}
								{#<button type="button" class="js-card-collapse">Ver Detalles</button>#}
							{#</div>#}
						{#</div>#}
					{#</div>#}
                {#{% endfor %}#}
			{#</div>#}
		{#</section>#}

		<section class="section scrollspy text-center sr-fadeInBottom">
			<iframe class="video-hilux" src="//www.youtube.com/embed/jXDWJYzdQS4?version=3&loop=1" frameborder="0" allowfullscreen=""></iframe>
		</section>

	</div>

	<div class="modal modal-hotspots fade modal--compare">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal__inner">
					<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>

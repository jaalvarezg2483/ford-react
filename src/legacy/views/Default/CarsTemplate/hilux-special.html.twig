{% block scripts %}
	<script src="/js/hotspots.js"></script>
	<script>
        var serverPath = '{{ server_url }}';
        scrollspy( $('#carMenu') );
        $(document).ready(function(){
        	var txtMultilinea = $('.text--large').html().split('.');
        	$('.text--large').empty();
        	$.each(txtMultilinea, function(i,e){
        		if(i != 5){
        			$('.text--large').append(e+'.');
        		}
        		if(i == 2){
        			$('.text--large').append('</br> </br>');
        		}
        	});
        });
	</script>

{% endblock %}

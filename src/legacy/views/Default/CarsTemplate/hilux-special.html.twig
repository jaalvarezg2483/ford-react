								{#<div class="card__collapse">#}
									{#<ul>#}
                                        {#{% for feature in type.featureType.features %}#}
											{#<li>{{ feature.name }}</li>#}
                                        {#{%  endfor %}#}
									{#</ul>#}
									{#<ul class="disclaimer">#}
                                        {#{% for disclaimer in type.disclamers %}#}
											{#<li>#}
                                                {#{{ disclaimer.asterisc | trim }}{{ disclaimer.name }}#}
											{#</li>#}

					<span data-dot="17" rel="internal" class="hotspot hotspot-18"><i></i></span>
					<span data-dot="18" rel="internal" class="hotspot hotspot-19"><i></i></span>
					<span data-dot="19" rel="internal" class="hotspot hotspot-20"><i></i></span>
					<span data-dot="20" rel="internal" class="hotspot hotspot-21"><i></i></span>
					<span data-dot="21" rel="internal" class="hotspot hotspot-22"><i></i></span>
					<span data-dot="22" rel="internal" class="hotspot hotspot-23"><i></i></span>

<div class="row quotation__form">
    {#<h1 class="subtitle--large not-bold text-center title-margin-more">Enviar cotización al correo</h1>#}
    <div class="form--custom card">
        <form action="{{ path('renderDrawForm') }}" method="post" class="form" id="contactFormDraw">
            <div class="card__content bg--gray">
                <div class="container">
                    <p><strong>ME INTERESA EL VEHÍCULO:</strong></p>
                    <p class="quotation__model">
                        <select class="input select" name="family">
                            {% for family in families %}
                                <option value="{{ family.id }}">{{ family.name }}</option>
                            {% endfor %}
                        </select>
                    </p>
                </div>
            </div>
            <div class="card__content">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">
                            <p><strong>MIS DATOS</strong></p>
                            <div class="input-field">
                                <input type="text" name="name" class="input" required placeholder="Nombre" maxlength="255">
                            </div>
                            <div class="input-field">
                                <input type="text" name="lastnames" class="input" required placeholder="Apellidos" maxlength="255">
                            </div>
                            <div class="input-field">
                                <input type="email" name="email" class="input" required placeholder="Correo electrónico" maxlength="255">
                            </div>
                            <div class="input-field">
                                <input type="tel" name="phone" class="input telefono" required placeholder="Teléfono" data-inputmask="'mask':'99999999'" />
                            </div>
                            <div class="form__terms">
                                Ver <a href="/article/terminos-condiciones" target="_blank">Términos y Condiciones</a>
                            </div>
                            <div class="input-field">
                                <input id="autorizo_envio" name="autorizo_envio" type="checkbox" value="1" checked="" class="checkbox" required="required">
                                <label for="autorizo_envio">Autorizo a Grupo Purdy S.A. al envío de información de sus productos y la utilización de mis datos de contacto.</label>
                            </div>

                            <button type="submit" name="button" class="btn btn--black btn--block">ENVIAR</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
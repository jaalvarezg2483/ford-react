{% extends "base.html.twig"%}
{% block title %}Descubrir Toyota{% endblock %}


{% block stylesheet %}    
	<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-slider/9.7.2/css/bootstrap-slider.min.css" rel="stylesheet">
{% endblock %}
{% block body %}
<div class="wrapper">
	<section class="container form-discover-toyota container--discover">
		<form id="form-dicover" class="section" method="post" action="{{path('discover-toyota-result')}}">
			{#Se hará un slider en la misma vista para todo el formulario, cada slide será una pregunta#}
			<div class="discover--slider">
			<div class="discover-slide row">
				<div class="question-image hidden-xs">
					<img src="{{ asset('img/content/question-placeholder.png') }}"/>
				</div>
				<div class="question-content content-center">
					<img class="discover-logo" src="{{ asset('img/logos/logo-toyota-short.png') }}">
					<h1 class="title">Descubrir</h1>
					<h2 class="discover-title"> mi <span class="text--red">Toyota</span></h2>
					<p class="discover-text text-center">¿Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt u?</p>

					<button class="btn btn--red btn-discover-next btn-centered">Iniciar</button>
						
					<a href="{{ path('home') }}" class="btn btn-transparent btn-centered">Salir</a>

				</div>
			</div>
			{% for question in questions %}
				<div class="discover-slide row">
					<div class="question-image hidden-xs">
						<img src="{{question.image}}"/>
					</div>
					<div class="question-content">
						<h2 class="discover-title">Descubrir mi Toyota</h2>
						<p class="margin--top"><a class="btn-discover-prev" href="#"><i class="mdi mdi-chevron-left text--red"></i> Pregunta <strong>{{ loop.index }}</strong> de <strong>{{ loop.length }}</strong></a></p>
						<ul class="discover-nav">
							{% set idx = loop.index %}
							{% for i in 1..loop.length %}
							<li {% if i <= idx %}class="done"{% endif %}>
								<button class="discover-nav-btn" data-slide="{{ i }}">&nbsp;</button>
							</li>
							{% endfor %}
						</ul>

						<p><strong>{{ loop.index }}</strong> {{ question.text }}</p>
						{#Mostrar como selección única#}
						{% if question.typeSelected == "Normal" %}
							{% for answer in question.answers %}
							<label class="card-label" for="answer-{{ answer.id }}">
								<input type="radio" name="question[{{ question.id }}]" class="card-input-element" value="{{ answer.id }}" id="answer-{{ answer.id }}" required/>
								<div class="card-input">
									<p>{{ answer.text }}</p>
								</div>
							</label>
							
							{% endfor %}
						{#Mostrar un select#}
						{% elseif question.typeSelected == "Selector" %}
							<div class="select select-discover">
								<select class="js-select" name="question[{{ question.id }}]" required>
									<option>Seleccioná una opción</option>
									{% for answer in question.answers %}
										<option value="{{ answer.id }}">{{ answer.text }}</option>
									{% endfor %}
								</select>
							</div>
						{#Mostrar radios normales#}
						{% elseif question.typeSelected == "Radio" %}
							{% for answer in question.answers %}
							<div>
								<input class="radio" id="answer-{{ answer.id }}" type="radio" name="question[{{ question.id }}]" value="{{ answer.id }}" required>
								<label for="answer-{{ answer.id }}">{{ answer.text }}</label>
							</div>	
							{% endfor %}
						{#Mostrar como selección única con ícono#}
						{% else %}
							<div class="card-icon-container">
								{% for answer in question.answers %}

								<label class="card-icon" for="answer-{{ answer.id }}">
									<input type="radio" name="question[{{ question.id }}]" class="card-input-element" value="{{ answer.id }}" id="answer-{{ answer.id }}" required/>
									<div class="card-input">
										<i {% if answer.icon != "" %}class="mdi {{ answer.icon }}"{% endif %}></i>
										<p>{{ answer.text }} </p>
									</div>
								</label>
								
								{% endfor %}
							</div>
						{% endif %}
						
						<p class="error">Por favor selecciona una opción para contiuar</p>
						
						{#Mostar botón de submit #}
						{% if loop.last %}
							<button class="btn btn--red btn-centered" type="submit">Enviar</button>
						{% else %}
							<button class="btn btn--red btn-centered btn-discover-next">Continuar</button>
						{% endif %}
						<a href="{{ path('home') }}" class="btn btn-transparent btn-centered">Salir</a>
					</div>	
				</div>

				
				{% endfor %}
			</div>
		</form>
	</section>		
	
</div>

{% endblock %}

{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-slider/9.7.2/bootstrap-slider.min.js"></script>
<script>
	$(".range").slider(function(){});

	$('.js-input-number .more').on('click', function(){
		var input = parseInt($(this).prev().val());
		$(this).prev().val(input + 1);
	})

	$('.js-input-number .less').on('click', function(){
		var input = parseInt($(this).next().val());
		$(this).next().val(input - 1);
	})
</script>
{% endblock %}
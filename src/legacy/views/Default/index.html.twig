{% extends "base.html.twig"%}
{% block title %}Inicio{% endblock %}

{% block body %}

<div class="wrapper">
	<section class="section section--hero">
		<div class="container">
			<h2>NO LO MANEJE, MALTRÁTELO/h2>
			<img src="/img/logos/hilux_logo-home.png" alt="HILUX">
			<a href="/autos/hilux60" class="btn btn--red">ver más</a>
		</div>
	</section>

	<section class="section section--slider">
		<h2 class="title text-center">Descubrir vehículos</h2>

		<ul class="tabs js-tabs-car">
            {% for type in familyTypes %}
				<li class="tab {{ loop.first ? "active" : "" }}">
					<a href="#slider{{ loop.index }}" data-toggle="tab">{{ type.name }}</a>
				</li>
            {% endfor %}
	  	</ul>
		<ul class="collapsible tab-content js-collapse-car">
            {% for type in familyTypes %}
				<li class="tab-pane fade tab--find-car {{ loop.first ? "in active" : "" }}" id="slider{{ loop.index }}">
					<button type="button" class="collapsible__header js-collapse-next">
						<p><i class="mdi mdi-plus"></i> {{ type.name }}</p>
					</button>
					<div class="collapsible__body row">
						<div class="slider slider--car js-slider-car">
                            {% for family in type.families2 %}
								<div>
									<a href="{{ path("model_list", {slug: family.slug}) }}" class="slider__link">
										<img src="{{ server_url ~ family.getFoto3() }}" alt="car">
										<h2>{{ family.name }} {{ family.principalModel.year | default(2017) }}</h2>
										<span class="line"><span>desde</span></span>
										<p class="title">${{ family.startPrice | number_format(0,',','.') }}</p>
									</a>
								</div>
                            {% endfor %}
						</div>
					</div>
				</li>
            {% endfor %}
		</ul>
	</section>


	<section class="section section--featured">
		<div class="container">
			<div class="row js-equal-height-parent">
				<div class="col-sm-4">
					<div class="card card--img">
						<div class="card__image">
			              	<img src="/img/content/card-home-calcular.jpg">
			            </div>
			            <div class="card__content js-equal-height">
			            	<i class="mdi mdi-cash-multiple"></i>
			              	<h2 class="card__title">Calcular cuota mensual</h2>
			            </div>
			            <div class="card__action">
			            	<a href="{{path('calculate')}}">ver más</a>
			            </div>
					</div>
				</div>
				<div class="col-sm-4">
					<div class="card card--img">
						<div class="card__image">
			              	<img src="/img/content/card-home-repuestos.jpg">
			            </div>
			            <div class="card__content js-equal-height">
			            	<i class="mdi mdi-settings"></i>
			              	<h2 class="card__title">Repuestos</h2>
			            </div>
			            <div class="card__action">
			            	<a href="{{path('category_by_alias', {"category_alias": 'repuestos'})}}">ver más</a>
			            </div>
					</div>
				</div>
				<div class="col-sm-4">
					<div class="card card--img">
						<div class="card__image">
			              	<img src="/img/content/card-home-encontranos.jpg">
			            </div>
			            <div class="card__content js-equal-height">
			            	<i class="mdi mdi-store"></i>
			              	<h2 class="card__title">Encontranos</h2>
			            </div>
			            <div class="card__action">
			            	<a href="{{path('contacto')}}">ver más</a>
			            </div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--discover">
		<div class="container">
			<div class="row">
				<div class="col-sm-6 col-md-7 hidden-xs">
					<img src="/img/content/discover.png" alt="Descubrir mi toyota" class="img-responsive">
				</div>
				<div class="col-sm-6 col-md-5">
					<a href="{{path('discover-toyota')}}" class="card card--btn">
						<img src="/img/logos/logo-toyota-short.png" alt="Toyota">
						<h2>Descubrir <span>mi <strong>toyota</strong></span></h2>
						<p>Comenzar <i class="mdi mdi-arrow-right"></i></p>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section--banner">
		<a href="http://hibridoscostarica.com/" target="_blank">
			<img src="/img/banners/home-mobile.jpg" alt="Híbridos Costa Rica" class="visible-xs">
			<img src="/img/banners/home-desktop.jpg" alt="Híbridos Costa Rica" class="hidden-xs">
		</a>
	</section>


</div>


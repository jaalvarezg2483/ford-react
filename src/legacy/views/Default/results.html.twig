{% extends "base.html.twig" %}
{% block title %}Buscador{% endblock %}

{% block body %}

<div class="wrapper">
        <div class="search__head">
            <div class="container">
                <div class="search__field">
                    <!-- <a class="js-close_search"><i class="mdi mdi-close"></i></a> -->
                    <form action="{{ path('results_search') }}" method="GET">
                        <input class="input" type="text" placeholder="Buscar en el sitio" name="q">
                        <button type="submit"><i class="mdi mdi-arrow-right"></i></button>
                    </form>
                </div>
            </div>
        </div>
        <div class="search__body">
            <div class="container">
                {% if pagination['count'] > 0 %}

                    <p class="search__result"><span>{{ pagination['count'] }}</span> Resultados para
                        “<strong>{{ search }}</strong>”</p>
                    {% for element in pagination[constant('\\Lumen\\CMSBundle\\Service\\SearchElasticaService::ELEMENTS')] %}
                        {% set routeElements =  element.getRouteSearch()  %}

                        <a href="{{ search_path(routeElements) }}" class="search__item">
                            <h2 class="subtitle">{{ element.getTittleSearch() }}</h2>
                            <ol>
                                {% for route in element.getSection() | split("||") %}
                                    <li>{{ route }}</li>
                                {% endfor %}
                                {#<li>SUV</li>#}
                            </ol>

                            <p>{{ element.getDescriptionSearch() }}</p>
                            <p class="text--red">VER MÁS</p>
                        </a>
                    {% endfor %}

                    <div class="search__pagination">
                        <ul>
                    {% for page in 1..pagination[constant('\\Lumen\\CMSBundle\\Service\\SearchElasticaService::PAGES')] %}
                            <li>
                            <a href="{{ path('results_search', {}) ~ '?q=' ~ search ~'&page=' ~ page }}">  <span>Página</span> {{ page }}</a>
                            </li>
                    {% endfor %}
                        </ul>
                    </div>

                {% else %}
                    <div class="search__no-results">
                        <p>
                            No hemos encontrado
                            <span>resultados para:</span>
                            “{{ search }}”
                        </p>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>


{% endblock %}

{% extends "base.html.twig"%}
{% block title %}Cotizador{% endblock %}

{% block meta %}
	<meta name="identifier-url" content="" />
	<meta name="title" content="Ford"/>
	<meta name="description" content="Ford" />
	<meta name="abstract" content="" />
	<meta name="keywords" content="" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© 2016" />
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
	<link rel="image_src" href="" >
	<meta name="dcterms.abstract" content="">
	<meta name="dcterms.rightsHolder" content="">
	<meta NAME="robots" CONTENT="noindex">
{% endblock %}

{% block body %}
<script id="accessorie_item_template" type="text/x-tmpl">
	<section class="col-xs-12">
		<div class="chip">{-% name %-}
		<a class="accessory_wdg" data-price="{-% price %-}" data-name="{-% name %-}" data-id="{-% id %-}">
			<i class="mdi mdi-close"></i>
		</a>
		</div>
		<span class="price-selected">${-% price %-}</span>
	</section>
</script>

<div class="breadcrumb--calculate breadcrumb--calculate-old">
	<div class="container step-2-calculate">
		<h5 class="breadcrumb__title">Accesorios</h5>
		{# <a class="calculate-steps" href="javascript:history.back()"><i class="mdi mdi-chevron-left"></i> Paso 2 de 5 <span class="name-step">Elegir Accesorios</span></a> #}
	</div>
</div>
<div class="wrapper-calculate wrapper-calculate-step-2 wrapper-calculate-old">
	<section class="sub-section">
		{%  include "LumenAppBundle:Default/partials:_resume.html.twig" with {"current": current, "families": families, "total": total, "model": model, "modelos": modelos, "accessories" : accessories, "maintenanceInsurance": [], "old-design": true} %}
	</section>
	<section class="bg-opacity"></section>
	<section class="container container-calculate">
		<div class="row content-accesories-car accessories_wdg js-equal-height-parent">
            {% for accessory in modelAccesories %}
				<section class="col-xs-6 col-sm-3 sr-fadeInBottom">
					<div class="card-accesories {{ in_array(accessory.id, accessories) ? "ele-checked" : ""}}">
						<img src="{{ server_url ~ "/" ~ accessory.getWebPath() }}">
						<p class="js-equal-height">{{ accessory.name }}</p>
						<p>${{ accessory.price | number_format(0, ".", ",")}}</p>
						<div class="add-accesory">
							<input type="checkbox" class="checkbox accessory_wdg" id="Cotizar{{ loop.index }}" {{ in_array(accessory.id, accessories) ? 'checked="checked"' : "" }} data-price="{{ accessory.price }}" data-name="{{ accessory.name }}" data-id="{{ accessory.id }}"/>
							<label for="Cotizar{{ loop.index }}">Cotizar</label>
						</div>
					</div>
				</section>
            {% endfor %}
			{%if modelAccesories | length == 0%}
				<div class="error__wrap text-center no_icon mt-3">
					<div class="row">
						<div class="col-xs-10 col-xs-offset-1">
							<p>No hay accesorios disponibles en este momento</p>
						</div>
					</div>
				</div>
			{%endif%}
		</div>
		<a class="next-step" href="{{ path('calculate-step3', {"slug": current.slug, "code": model.code}) }}">Continuar al paso 3</a>
	</section>
	
</div>
<div class="row">
	<div class="col-xs-10 col-xs-offset-1 col-md-8 col-md-offset-2 col-lg-6 col-lg-offset-3 ">
		<p class="text-justify">
			<small>
				*COBERTURAS DE EXTRAS: La vigencia será de acuerdo con la descrita de manera individual para cada Extra.
				Poseen sus propias condiciones de cobertura de Garantía y de Respaldo de Grupo Purdy Motor, sin que estén vinculadas al vehículo y sus coberturas, cada extra se considera un bien independiente.
				Para más información contacte a su asesor de confianza.
			</small>
		</p>
        <br>
		<p class="text-justify"><small>*Podés cancelar el monto en colones al tipo de cambio aplicable a la transacción, correspondiente al de referencia de venta del Banco Central de Costa Rica.</small></p>
	</div>
</div>


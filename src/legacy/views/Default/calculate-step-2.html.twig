{% endblock %}
{% block scripts %}
    <script type="text/javascript">
		var vehiclePrice = {{ model.startPrice }};

        $('.open-calculate').on('click', function(){
			$('.nav-calculate').slideToggle('slow');
			$('.bg-opacity').toggleClass('show-bg');
		});
		$('.close-calculate').on('click', function(){
			$('.nav-calculate').slideUp('slow');
			$('.bg-opacity').removeClass('show-bg');
		});
        $('.bg-opacity').on('click', function(){
			$('.nav-calculate').slideUp('slow');
			$(this).removeClass('show-bg');
		});
    </script>
{% endblock %}

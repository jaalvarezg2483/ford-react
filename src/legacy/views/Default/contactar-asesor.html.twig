{% extends "base.html.twig"%}
{% block title %}Contactar asesor de ventas{% endblock %}

{% block body %}

<div class="wrapper">
  <div class="container container--breadcrumb">
    <a href="{{ path("calculate-step5", {slug: family.slug, code: model.code}) }}" class="btn--back"><span class="icon icon-arrow-left"></span>Volver a <strong>Cotización</strong></a>
  </div>
  <div class="section">
    <div class="container">
      <h1 class="title text-center">Contactar Asesor de Ventas</h1>
    </div>
    <div class="container container--full-mobile">
      <div class="card card--form">
        <form action="{{ wtlead_path }}" method="post" class="pre_submit verify-captcha" novalidate>
          <script id="ajax_path">
              var savePath = '{{ path("save_contactus", {slug: family.slug, code: model.code, type: app.request.get("_route")}) }}';
          </script>
          <input type="hidden" name="oid" value="{{ wtlead_oid }}">
          <input type="hidden" name="lead_source" value="Sitio Web">
          <input type="hidden" name="rating" value="Neutro">
          <input type="hidden" name="retURL" value="{{ server_url~path("thanks_route_family", {"route_name": app.request.get("_route"),
            "family": family.slug}) }}">
          <input type="hidden" name="debug" value="0">
          <input type="hidden" name="debugEmail" value="{{wtlead_debug_email}}">
          <input type="hidden" name="{{ wtlead_marca }}" value="{{ family.familyBrand.code }}" id="wtl_marca"/>
          <input type="hidden" name="{{ wtlead_familia }}" value="{{ model.familySalesForce.name }}" id="wtl_familia"/>
          <input type="hidden" name="{{ wtlead_modelo }}" value="{{ model.categorySalesForce }}" id="wtl_modelo"/>
          <div class="card__content bg--gray">
            <div class="container">
              <p class="form__title">ME INTERESA EL VEHÍCULO:</p>
              <p class="quotation__model">
                  <span>{{ family.name }}</span>
                  {{ model.name }}
              </p>
            </div>
          </div>
          <div class="card__content">
            <div class="container">
              {% include 'LumenAppBundle:Default/partials:_form-fields.html.twig'  with {'captcha':true, 'captcha':true, "cedula": true, "consentimiento": true, "seguimiento": true, "hiddenSeguimiento": true} %}
            </div>
          </div>
            {{ form_rest(form) }}
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block snippetScripts %}
{% endblock %}

<div class="wrapper-calculate">
	<section class="bg-opacity"></section>
	<section>
		<div class="calculate__top container">
			<div class="row">
				{# <div class="col-sm-6 margin--bottom">
					<img src="{{ server_url ~ "/" ~ model.getWebPath() }}" class="img-responsive">
				</div> #}
				<div class="col-sm-6 collapse-resumen">
					<div class="calculate-resumen-head">
						<h2 class="title"><span>{{current.familyBrand.name}}</span> {{model.name}}</h2>

						<img src="{{ server_url ~ "/" ~ model.getWebPath() }}" class="img-responsive">
					</div>
					<button type="button" class="collapsible__header collapse-specs js-collapse-next">
						<span class="collapse--content">
							<i class="icon icon-chevron-down pull-right"></i>
							<p>Detalles <strong>de la orden</strong> </p>
							<p><strong>Total $<span id="pc-total-price">{{ (model.startPrice + total) | number_format(0, ',', '.') }}</span></strong></p>
						</span>
					</button>
            		<div class="collapsible__body collapsible--calculate">
						<table class="table--calculate">
							<tbody>
								<tr>
									<td id="pc-model-name">{{ model.name }}</td>
									<td><strong id="pc-model-start-price">${{ model.startPrice | number_format(0, ',', '.') }}</strong></td>
									<td>&nbsp;</td>
								</tr>
								{% for key,accesory in accessories %}
									<tr>
										<td>
											{{ accesory.name }}
										</td>
										<td>
											<strong>${{ accesory.price | number_format(0, ',', '.') }}</strong>
										</td>
										<td>
											<a data-id="{{ key }}" data-attr="accesory" class="js-delete-accessory"><span class="icon icon-close"></span></a>
										</td>
									</tr>
								{% endfor %}
								{% set mantVar = constant('\\Lumen\\AppBundle\\Classes\\Constant::SESSION_MAINTENANCE') %}
								{% if maintenanceInsurance[mantVar] | default(false)%}
								{% for key,maintenance in maintenanceInsurance[mantVar] %}
									<tr>
										<td>
											{{ maintenance.tittle }}	
										</td>
										<td>
											<strong>${{ maintenance.price | number_format(0, ',', '.') }}</strong>
										</td>
										<td>
											<a data-id="{{ key }}" data-attr="maintenance" class="js-delete-accessory"><span class="icon icon-close"></span></a>	
										</td>
									</tr>
								{% endfor %}
								{% endif %}
								{%  set insVar = constant('\\Lumen\\AppBundle\\Classes\\Constant::SESSION_INSURANCE') %}
								{% if maintenanceInsurance[insVar] | default(false)%}
								{% for key,maintenance in maintenanceInsurance[insVar] %}
									<tr>
										
										<td>
											{{ maintenance.tittle }}*	
										</td>
										<td>
											<strong>${{ maintenance.price | number_format(0, ',', '.') }}</strong>
										</td>
										<td>
											<a data-id="{{ key }}" data-attr="insurance" class="js-delete-accessory"><span class="icon icon-close"></span></a>
										</td>
									</tr>
								{% endfor %}
								{% endif %}
							</tbody>
						</table>
						<p class="small">* Costos mensuales</p>

					</div>	
					<div class="row">
						{% if purdyGoReservationLink != '#' %}
							<a href="{{ purdyGoReservationLink }}" class="btn btn--icon" target="_blank" style='background-color:#00095B; color:white; margin-left:15px ; height:55px; border-radius:4px'>Ir a PURDY GO y Reservar en Línea</a>
						{% endif %}
					</div>
				</div>
				<div class="col-sm-6 hidden-xs">
					{% if purdyGoReservationLink != '#' %}
					<div class="row">
						<div class="col-md-8 col-md-offset-4" style="align-text:right">
							<div class="bubble-wrapper">
								<div class="bubble-container">
									<div class="bubble">
											Reservá en <br>Línea este modelo
									</div>
								</div>
							</div>
						</div>
					</div>
					{% endif %}
					<img src="{{ server_url ~ "/" ~ model.getWebPath() }}" class="img-responsive">
				</div>
			</div>
		</div>

		<div class="container">
			<div class="row">
				{% if purdyGoReservationLink != '#' %}
                    <a href="{{ purdyGoReservationLink }}" class="btn btn--icon" target="_blank" style='background-color:#00095B; color:white; margin-left:15px ; height:55px; border-radius:4px'>Ir a reservar en Línea</a>
                {% endif %}
			</div>
		</div>
		
		
		<div class="content-financial">
			<div class="container">

				<h4 class="title">Entidades disponibles</h4>
				<div class="slider-financial-nav hidden-md">
					{% for entidad in entidades %}
						<div class="slide-logo logo-{{entidad | lower}}">
							<p>{{ entidad.name  | upper}}</p>
						</div>
					{% endfor %}
				</div>
				<div class="row js-equal-height-parent slider-financial-mobile {% if app.request.get('_route') == 'preapproved-calculate-step5' %} financial-mobile-preaprobador {% endif %}">
					{% for entidad in entidades %}
					<div class="{% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-12 col-md-12 cafsa-card {% else %} col-sm-6 col-md-4 {% endif %} not-outline">
						<form data-calculator="{{ entidad.name }}" class="frm_calculator_wdg form-reload--disable">
							{% if entidad.name == 'CAFSA' and (preaprobador is defined and preaprobador == true)%}
                                <div class="card card--finance js-equal-height card--preaprobador">
                            {% else %}
                                <div class="card card--finance js-equal-height">
                            {% endif %}
								<div class="{% if app.request.get('_route') == 'preapproved-calculate-step5' %} cafsa-content-preaprobador {% endif %}">
									<div class="card__content">
										<div class="logo-entity logo-{{entidad | lower}}">
											{% if entidad.name == 'FACILEASING' %}
											<img class="" src="/img/icons/facileasing-logo.png">
											{% else %}
											<img class="" src="{{ entidad.getImagePath() }}">
											{% endif %}
											
										</div>
										<div class="row">
											<div class="col-xs-5 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-3 col-sm-offset-1 {% endif %}">
												<p class="label ProximaBold">Tasa fija:</p>
											</div>
											<div class="col-xs-7 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-6 {% endif %}">
												<p><strong>{{ entidad.rate }}%</strong></p>
											</div>
										</div>
										<div class="row card--finance__down">
											<div class="col-xs-5 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-3 col-sm-offset-1 {% endif %}">
												<p class="label ProximaBold">Prima ($):</p>
											</div>
											<div class="col-xs-7 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-6 {% endif %}">
												<input {% if entidad.name == 'CAFSA' %}id="pc-premium-amount"{% endif %} type="text" placeholder="$11 000" class="validate rate_prima no-letters" value="{{ entidad.calcPrima(model.startPrice + total) }}">
											</div>
											<p class="text--error js-rate--error col-xs-12"><sup>*</sup>La prima no puede ser menor a ${{ entidad.calcPrima(model.startPrice + total) }}</p>
										</div>
										<div class="row">
											<div class="col-xs-5 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-3 col-sm-offset-1 {% endif %}">
												<p class="label ProximaBold">Plazo:</p>
											</div>
											<div class="col-xs-7 {% if app.request.get('_route') == 'preapproved-calculate-step5' %} col-sm-6 {% endif %}">

												{#cambiar plazo de select a radio #}

												{% for term in entidad.getTermArray() %}
													<div>
														<input class="radio rate_term" type="radio" name="term" id="{{entidad}}-{{term}}" value="{{term}}" {%  if loop.first %}checked="checked"{% endif %} %}>
														<label for="{{entidad}}-{{term}}" class="plazo-label">{{ term }} años</label>
													</div>
												{% endfor %}

												{#<div class="select">#}
													{#<select class="js-select rate_term">#}
														{#{% for term in entidad.getTermArray() %}#}
															{#<option value="{{ term }}">{{ term }} Años</option>#}
														{#{% endfor %}#}
													{#</select>#}
												{#</div>#}
											</div>
										</div>
									</div>
								</div>
								<div class="{% if app.request.get('_route') == 'preapproved-calculate-step5' %} c-month-preaprobador {% endif %}">
									<div class="card__content">
										{% if insurancePrice > 0 %}
											<div class="bankPlusInsuranceCard">
												<div>
													<p>Cuota</p>
													<p>Bancaria:</p>
													<p class="fee_wdg_plain priceAndColor">${{ (entidad.calculate(model.startPrice + total ) + (insurance["price"] | default(0))) | number_format(2,'.',',')}}</p>
												</div>
												{% if entidad.name != 'Facileasing' %}
													<div><p class="plusParagraph">+</p></div>
													<div>
														<p>Purdy</p>
														<p>Seguro:</p>
														<p class="priceAndColor">${{ insurancePrice }}</p>
													</div>
												{% endif %}
											</div>
										{% endif %}
										{%  set insurance = maintenanceInsurance[insVar] | first %}
										<p class="text-center ProximaBold">Cuota Mensual:</p>
										{% if entidad.name != 'Facileasing' %}
											<h4 class="title text-center fee_wdg text--red text--bold">${{ (entidad.calculate(model.startPrice + total ) + (insurance["price"] | default(0)) + insurancePrice) | number_format(2,'.',',') }}</h4>
										{% else %}
											<h4 class="title text-center fee_wdg_plain text--red text--bold">${{ (entidad.calculate(model.startPrice + total ) + (insurance["price"] | default(0))) | number_format(2,'.',',')}}</h4>
										{% endif %}
									</div>
									{% if entidad.name == 'CAFSA' and (preaprobador is defined and preaprobador == true)%}
										<span class="hidden" id="pa-vehicle-family">{{ model.family.slug }}</span>
										<div id="pa-module" class="card__content"></div>
									{% endif %}

									{% if '' != entidad.disclamer | trim %}
										<div class="card__content disclamer-preaprobador">
											<div class="">
												<p class="text--small">*{{ entidad.disclamer | raw | nl2br  }}</p>
											</div>
										</div>
									{% endif %}
								</div>
							</div>
						</form>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
		<div class="container">
			<div class="row js-equal-height-parent-desktop row-card--links">
				<div class="col-sm-6 order-0">
					<a href="{{ familyWhatsapp }}" class="sr-sequenceFadeInBottom card--action" target="_blank">
						<div class="card__content js-equal-height">
							<span class="whatsapp"><i class="icon icon-whatsapp"></i></span>
							<p>Contactar Asesor por Whatsapp</p>
							<i class="icon icon-arrow-right"></i>
						</div>
					</a>
				</div>
				<div class="col-sm-6 order-2" {% if hideCTA == true %} style="display:none;"{% endif %}>
					<a href="{{ path("contactar-asesor", {slug: current.slug, code: model.code}) }}" class="sr-sequenceFadeInBottom card--action">
						<div class="card__content js-equal-height">
							<span><i class="icon icon-phone"></i></span>
							<p>Solicitar Seguimiento y Enviar Cotización al correo</p>
							<i class="icon icon-arrow-right"></i>
						</div>
					</a>
				</div>
				{% if testDrive == true %}
					<div class="col-sm-6 order-2" {% if hideCTA == true %} style="display:none;"{% endif %}>
						<a href="{{ path("prueba-manejo", {slug: current.slug, code: model.code}) }}" class="sr-sequenceFadeInBottom card--action">
							<div class="card__content js-equal-height">
								<span><i class="icon icon-car"></i></span>
								<p>Solicitar Test Drive</p>
								<i class="icon icon-arrow-right"></i>
							</div>
						</a>
					</div>
				{% endif %}
				
{#				<div class="col-sm-6">#}
{#					<a href="{{ path("enviar-correo", {slug: current.slug, code: model.code}) }}" class="sr-sequenceFadeInBottom card--action">#}
{#						<div class="card__content js-equal-height">#}
{#							<span><i class="icon icon-mail"></i></span>#}
{#							<p>Enviar cotización al correo</p>#}
{#							<i class="icon icon-arrow-right"></i>#}
{#						</div>#}
{#					</a>#}
{#				</div>#}
				<div class="col-sm-6 order-2" {% if hideCTA == true %} style="display:none;"{% endif %}>
					<a href="{{ path("calculate") }}" class="sr-sequenceFadeInBottom card--action">
						<div class="card__content js-equal-height">
							<span><i class="icon icon-plus"></i></span>
							<p>Iniciar nueva cotización</p>
							<i class="icon icon-arrow-right"></i>
						</div>
					</a>
				</div>
				<div class="col-sm-6 copy-preaprobacion" {% if hideCTA == true %} style="display:none;"{% endif %}>
					<a href="{{ path("reservar", {'slug': current.slug, 'code': model.code}) }}" class="sr-sequenceFadeInBottom card--action">
						<div class="card__content js-equal-height">
							<span><i class="icon icon-chart"></i></span>
							<p class="card__text">Solicitar reserva de vehículo</p>
							<i class="icon icon-arrow-right"></i>
						</div>
					</a>
				</div>
				<div class="col-sm-6 order-2" {% if hideCTA == true %} style="display:none;"{% endif %}>
					<a href="#print-modal" class="sr-sequenceFadeInBottom card--action"
						data-toggle="modal"
						data-btn="#print-modal"
					>
						<div class="card__content js-equal-height">
							<span><i class="mdi mdi-printer"></i></span>
							<p class="card__text">Imprimir esta cotización</p>
							<i class="icon icon-arrow-right"></i>
						</div>
					</a>
				</div>
			</div>
		</div>
		<div class="container text-center">

			<a class="btn" href="{{ path('model_list', {"slug" : current.slug}) }}">Volver</a>
		</div>
	</section>
</div>
<div style="display: none">
	<p id="pc-salesforce-brand">{{ model.family.familyBrand.name | default("") }}</p>
	<p id="pc-salesforce-family">{{ model.familySalesForce.name | default("") }}</p>
	<p id="pc-salesforce-model">{{ model.categorySalesForce }}</p>
</div>

<!-- Modal for printing quotation -->
<div class="modal fade" id="print-modal">
	<div class="modal-dialog" role="document">
    	<div class="content-accesories-car content-cards-car">		
			<div class="card-accesories-modal">
				<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>
				<div class="card-accesories-img">
					<img id="modal-acc-img" src="">
				</div>
				<div class="modal-accesories-content">
					<p><strong id="modal-acc-title">Imprimir cotización de:</strong></p>
					<h3 id="modal-acc-price" class="text--bold text--primary">{{ model.name }}</h3>
					<p class="modal-accesories-description" id="modal-acc-description">Ingresa tu nombre completo en el siguiente campo vacío, por favor:</p>
					<form id="formPrint" method="post" target="_blank" action="{{ path('generate-pdf-quotation', {slug: current.slug, code: model.code}) }}">
						<input type="text" name="quotation_name" required />
					</form>
					<div class="add-accesory">
						<a class="btn btn--transparent" 
							href="#print-modal" 
							data-dismiss="modal"
							>Volver</a>
						<button class="btn btn--check" type="submit" id="btnPrint">
							<i class="mdi mdi-file-pdf"></i> Imprimir
						</button>
					</div>
				</div>
			</div>
    	</div>
  	</div>
</div>

{% extends "base.html.twig"%}
{% set familyWhatsapp = whatsapp ~ "&text=Hola, coticé el modelo en el sitio " ~ model.code ~ " " ~ model.name ~ " y quiero conversar con un asesor" %}

{# PurdyGO purdy Go reservation url#}
{% set purdyGoReservationLink = current.reservationUrl|default('#') %}

{% block title %}Resumen de Cotización {{ current.name }} {% endblock %}
{# PurdyGO purdy Go reservation url#}
{% set purdyGoReservationLink = current.reservationUrl|default('#') %}

{% block meta %}
	<meta name="identifier-url" content="" />
	<meta name="title" content="Resumen de Cotización {{ current.name }}"/>
	<meta name="description" content="Resumen de Cotización vehiculo" />
	<meta name="abstract" content="" />
	<meta name="keywords" content="" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© {{"now" | date("Y")}}" />
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
	<link rel="image_src" href="" >
	<meta name="dcterms.abstract" content="">
	<meta name="dcterms.rightsHolder" content="">
	<meta NAME="robots" CONTENT="noindex">
{% endblock %}
{% set insurancePrice = 0 %}
{% if insuranceForModel is not null %}
	{% set insurancePrice = insuranceForModel.price %}
{% endif %}
{%  block template_car %}
	<div class="col-xs-12 col-sm-3 col-md-3">
		<div class="img-calculate-content">
			<img src="{{ image }}">
		</div>
		<p class="title-car-calculate">{{ name }}</p>
		<p>${{ price }}</p>
		<div class="content-caract-vehicle">
			<ul class="list--bullets">
                {% for caracteristica in caracteristicas %}
					<li>{{ caracteristica.name }}</li>
                {% endfor %}
			</ul>
		</div>
		<a class="viewmore-calculate js-collapse-prev js-text-change">VER MÁS</a>

		<a href="{{ path('calculate-step5', {slug: current.slug, code: code}) }}" class="btn btn--black btn--block">CAMBIAR</a>
	</div>
{% endblock %}
{% block body %}

<div class="calculate--header">
	<div class="calculate--cancel bg--accent-light">
		<a class="btn btn--clear" href="{{  path('model_list', {"slug" : current.slug}) }}"><i class="icon icon-arrow-left"></i> Cancelar</a>
	</div>
	<div class="text-center margin--top">
		<h2 class="title">Calcular Financiamiento</h2>
	</div>
	<div class="calculate-nav">
		<div class="calculate-nav-item current"><a href="{{ path('calculate_select_model', {'slug': current.slug }) }}" class="calculate-nav-btn">1</a><span>Vehículo</span></div>
		<div class="calculate-nav-item current"><a href="{{ path('calculate-all', {'slug':current.slug, 'code': model.code})}}" class="calculate-nav-btn">2</a><span>Adicionales</span></div>
		<div class="calculate-nav-item current"><a href="javascript:void()" class="calculate-nav-btn">3</a><span>Resumen</span></div>
	</div>
</div>


		// because button for printing is not inside the form
		// submit event on button clicked is fired here
		$('#btnPrint').on('click', function(e){
			$('#formPrint').submit();
		})

		// "Detalles de la orden" collapse: toggle the next .collapsible__body (works even if DOM is adjusted by browser)
		$('.collapse-resumen .js-collapse-next').on('click', function(e) {
			e.stopImmediatePropagation();
			var btn = $(this);
			var body = btn.nextAll('.collapsible__body').first();
			if (!body.length) body = btn.next();
			body.slideToggle('slow', function() {
				btn.toggleClass('is-open', body.is(':visible'));
			});
		});

		$('.collapsible__header').on('click', function(e){
			var txt = $(this).find('.text-change');
			if (txt.length && txt.text() === 'Mostrar'){
				txt.text('Ocultar')
			} else if (txt.length) {
				txt.text('Mostrar')
			}
		})
		
	</script>


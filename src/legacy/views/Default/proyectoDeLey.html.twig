{% extends "base.html.twig"%}
{% block title %}Proyecto de ley{% endblock %}

{% block body %}

<div class="wrapper">
	<div class="container container--breadcrumb">
		<ol class="breadcrumb">
	      <li><a href=""><i class="icon icon-arrow-left breadcrumb-back"></i></a></li>
	      <li><a href="{{path('index')}}"> Inicio</a></li>
	      <li>Proyecto de Ley</li>
	    </ol>
	</div>
	<section class="container">
		<h4 class="title text-center">Proyecto de ley</h4>
		<div class="container-custom-cards">
		
			{% for file in files %}
			<a href="{{ file.getFilePath() }}" class="card card--pdf sr-fadeInBottom">
				<div class="card__content">
					<p>{{ file.description() }}</p>
				</div>
				<div class="card__action">
					<p>Descargar PDF<i class="mdi mdi-download"></i></p>
				</div>
			</a>
			{% endfor %}
	
		</div>
	</section>
	{% include "LumenAppBundle:Default/partials:_banner-bottom.html.twig" with {} %}
</div>

{% endblock %}

{% extends "base.html.twig" %}
{% block title %}Híbridos{% endblock %}
{% block metaFace %}
    <meta property="og:title" content="Híbridos"/>
    <meta property="og:site_name" content="Ford - Híbridos"/>
    <meta property="og:description" content="{{ info.description | striptags | raw }}"/>
    <meta property="og:type" content="website"/>
    <meta property="article:author" content="Ford" />
    <meta property="article:publisher" content="Ford" />
    <meta property="og:image" content="{{ server_url }}{{ info.image }}"/>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1600">
    <meta property="og:image:height" content="480">
{% endblock %}
{% block body %}
    <div class="wrapper wrapper-hibrido">
        <div class="hero">
            <div 
              data-min-width-0='<img src={{ info.imageMobile }} alt="Híbridos Costa Rica">'
              data-min-width-768='<img src={{ info.image }} alt="Híbridos Costa Rica">'
            > </div>
            <div class="hero__inner">
                <div class="hero__title">{{ info.title | raw }}</div>
                <div class="hero__subtitle">{{ info.subtitle | raw }}</div>
            </div>
        </div>
        
        <div class="hibrido hibrido-info">
            <div class="container">
                <div class="row--flex">
                    <div class="col-md-6">
                        <div class="hibrido-title">{{ info.titleDescription | raw }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ info.description | raw}}
                    </div>
                </div>
            </div>
        </div>
        <div class="hibrido hibrido-video">
            <div class="container-fluid">
                <div class="row--flex">
                    <div class="col-md-4">
                        <div class="hibrido-title">{{ info.videoTitle | raw }}</div>
                    </div>
                    <div class="col-md-8">
                        <a class="js-popup-video hibrido-video__open" href="{{ info.video }}"><img src="/img/content/hibridos-video.jpg" alt="Cómo funciona la tecnología híbrida"></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hibrido hibrido-razones">
            <div class="container">
                <div class="hibrido-title">{{ info.chooseReason | raw }}</div>
            </div>
            <div class="hibrido__tabs">
                <ul class="tabs tabs--alt">
                    {% for reason in reasons %}
                        <li class="tab {{loop.index == 1 ? 'active' : ''}}">
                            <a href="#razon_{{loop.index}}" data-toggle="tab">{{ reason.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
                <ul class="collapsible tab-content">
                    {% for reason in reasons %}
                        <li class="tab-pane fade {{loop.index == 1 ? 'in active' : ''}}" id="razon_{{loop.index}}">
                            <button type="button" class="collapsible__header js-collapse-next">
                                <p><i class="mdi mdi-plus"></i> {{ reason.title }}</p>
                            </button>
                            <div class="collapsible__body row">
                                {% for item in reason.items %}
                                <div class="col-sm-4">
                                    <h2><img src="{{ item.image }}" alt="Arranque"> {{ item.title }}</h2>
                                    <p>{{ item.description }}</p>
                                </div>
                                {% endfor %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        
        
        {% if familyType is not null %}
        <div class="hibrido hibrido-autos">
            <div class="container">
                <div class="hibrido-title">{{ info.carsTitle | raw }}</div>
            </div>
            <div class="slider slider--model js-slider-hibrido">
                {% set allFamilies =  familyType.families2 %}
                {% for family in allFamilies %}
                    <div class="js-slider-model-inner">
                        <a href="{{  path('model_list', {"slug" : family.slug}) }}" class="slider__link">
                            <img src="{{ family.getWebPath() ? server_url ~ '/' ~ family.getWebPath()  : '/img/content/yaris-small.png' }}" alt="Car" class="img-responsive">
                            <h2>{{ family.name }}</h2>
                            {% if family.startPrice > 0 and family.slug != 'camry' and family.slug != 'prius'%}
                                <span class="line"><span>desde</span></span>
                                <h3 class="title text--blue">${{ family.startPrice | number_format(0,',','.') }}</h3>
                            {% endif %}
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="container">
            <div class="hibrido-title">{{ info.howToDrive | raw }}</div>
        </div>
        <div class="hibrido hibrido-instruccion">
            <div class="container">
                <div class="row--flex">
                    {% for howToDrive in howToDriveItems %}
                        <div class="col-sm-4">
                            <img src="{{ howToDrive.image }}">
                            <h2>{{ howToDrive.title }}</h2>
                            <p>{{ howToDrive.description }}</p>
                        </div>
                    {% endfor %}
                </div>
                <button href="#popup-instruction" class="open-popup-link">Ver más <span class="mdi mdi-chevron-right"></span></button>
            </div>
        </div>

        <div class="hibrido hibrido--data">
            <div class="container">
                <div class="hibrido-title">{{ info.hybridsData | raw }}</div>
                <div class="row--flex js-equal-height parent">
                    {% for card in dataCards %}
                    <div class="col-md-4">
                        <div class="card card--gradient js-equal-height">
                            <div class="card__content">
                                <h2>{{ card.value }}</h2>
                                <p>{{ card.title }}</p>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>


        <div class="hibrido hibrido--data">
            <div class="container">
                <div class="hibrido-title">{{ info.hybridsStatistics | raw }}</div>
                <div class="row--flex js-equal-height-parent">
                    <div class="col-md-4">
                        <div class="card card--gradient card--green js-equal-height">
                            <div class="card__content">
                                <h2>{{ testDrives['generalData']['distance'] }}</h2>
                                <p>KM RECORRIDOS</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card--gradient card--green js-equal-height">
                            <div class="card__content">
                                <span class="hybrid-card-rating rating-white rating-{{ testDrives['generalData']['rating'] }}"></span>
                                <p>SATISFACCIÓN DE LOS CONDUCTORES</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card--gradient card--green js-equal-height">
                            <div class="card__content">
                                <h2>{{ testDrives['generalData']['electric_pct'] }}%</h2>
                                <p>MODO ELÉCTRICO</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="hibrido hibrido-autos">
            <div class="container">
                <div class="hibrido-title"><h1>Vehículos <strong>Híbridos</strong></h1></div>
                <p class="text-center">Seleccioná uno de los autos híbridos para ver los Test Drives realizados y al final encontrá la opción para solicitar el tuyo en los modelos disponibles</p>
            </div>
            <div class="slider--hybrid">
                {% for info in testDrives['models'] %}
                {% set first = loop.first %}
                    <div class="js-slider-model-inner">
                        <a class="slider--hybrid__item hybridInfo {% if not first %}collapsed{% endif %}" data-toggle="collapse" data-target="#info{{ info.family.id }}">
                            <img src="{{ info.family.getWebPath() ? server_url ~ '/' ~ info.family.getWebPath()  : '/img/content/yaris-small.png' }}" alt="Car" class="img-responsive">
                            <h2>{{ info.family.name }}</h2>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% for info in testDrives['models'] %}
            {% set first = loop.first %}
            <div id="info{{ info.family.id }}" class="bg--gray section--hybrid collapse {% if first %} in {% endif %} col-xs-12 col-sm-12">
                <p class="test-drive-count"> Mostrando <span class="text--blue">3 de {{ info['test-drives'] | length }}</span></p>
                <div class="slider--hybrid-details">
                {% for row in info['test-drives'] | batch(3) %}
                        <div class="slider--hybrid-flex-slide">
                        {% for testDrive in row %}
                            <div class="slider--hybrid-card">
                                <div>
                                    <img class="hybrid-card-img" src="{{ asset('img/hibridos/distance.svg') }}"/>
                                    <p class="hybrid-card-title">{{ testDrive['electric_pct'] }}% RECORRIDO EN MODO ELÉCTRICO</p>
                                    <p>{{ testDrive['distanceKm'] }} km recorrido total</p>
                                    <p><strong>Evaluación:</strong></p>
                                    <span class="hybrid-card-rating rating-{{ testDrive['rating'] }}"></span>
                                    <p><strong>{{ testDrive['dealer_city'] }}</strong></p>
                                    <p>{{ testDrive['date'] }}</p>

                                    <button data-active="0" data-id="{{ testDrive['hash'] }}" class="see-road btn">VER RECORRIDO <i class="text--blue mdi mdi-plus"></i></button>
                                </div>
                                <div class="hybrid-iframe" id="{{ testDrive['hash'] }}">

                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
                </div>
                <div class="slider--hybrid-details-nav">
                    {% for row in info['test-drives'] | batch(3) %}
                    <div class="slide-hybrid-nav">
                        <p>{{loop.index}}</p>
                    </div>
                    {% endfor %}
                </div>
                {% if info['hasTestDrive'] == true %}
                 <div class="text-center margin--top">
                    <a class="btn btn--blue test-drive-req" href="{{ path("car-test-drive", {"slug": info.family.slug}) }}">SOLICITAR TEST DRIVE</a>
                 </div>
                {% endif %}
            </div>
        {% endfor %}

       


        <div class="hibrido hibrido-blog margin--top">
            <div class="container">
                <div class="hibrido-title">{{ info.newsTitle | raw }}</div>
                <div class="row--flex">
                    {% include '@LumenApp/Default/partials/blog-entry.html.twig' %}
                </div>
                <button class="js-show-all-blog {{articles|length <= 3 ? 'hidden' : ''}}"><span class="mdi mdi-plus"></span>Ver Todos</button>
            </div>
        </div>

        {% if faqs is not empty %}
            <div class="container">
                <div class="hibrido-title">{{ info.faqsTitle | raw }}</div>
                <ul class="collapsible">
                    {% for faq in faqs %}
                        <li>
                            <button type="button" class="collapsible__header js-collapse-next">
                                <i class="mdi mdi-plus"></i> {{ faq.question }}
                            </button>

                            <div class="collapsible__body collapsible__padding">
                                {{ faq.answer | raw }}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

    </div>

    <div id="popup-instruction" class="popup mfp-hide">
        <div class="popup__top">
            <div class="hibrido-title">{{ info.howToDrive | raw }}</div>
            <div class="slider slider--hibridos js-slider-instruct">
                {% for howToDrive in howToDriveItems %}
                    <div>
                        <h3>{{ howToDrive.title }}</h3>
                        <p>{{ howToDrive.description }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>     
        <div class="popup__content">
            <div class="slider slider--hibridos js-slider-instruct-steps">
                {% for howToDrive in howToDriveItems %}
                    <ul class="list--image">
                        {% for item in howToDrive.items %}
                            <li><img src="{{ howToDrive.image }}" alt="Arranque"> {{ item.description }}</li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </div>
        </div>   
    </div>

{% endblock %}

{% block scripts %}
    <script>
        $('.js-show-all-blog').on('click', function(){
            $('.js-blog').removeClass('hidden');
        })

        $('.open-popup-link').magnificPopup({
            type:'inline',
        });

        $('.js-slider-instruct').slick({
            dots: false,
            infinite: true,
            arrows: false,
            slidesToShow: 1,
            slidesToScroll: 1,
            asNavFor: '.js-slider-instruct-steps',
            adaptiveHeight: true
        })

        $('.js-slider-instruct-steps').slick({
            dots: true,
            infinite: true,
            slidesToShow: 1,
            slidesToScroll: 1,
            asNavFor: '.js-slider-instruct',
            prevArrow: '<button type="button" class="slick-prev"> <i class="mdi mdi-chevron-left"></i> </button>',
            nextArrow: '<button type="button" class="slick-next"> <i class="mdi mdi-chevron-right"></i> </button>',
            adaptiveHeight: true
        })

        $('.open-popup-link').on('mfpOpen', function(e /*, params */) {
            $('.js-slider-instruct-steps, .js-slider-instruct').slick("setPosition", 0);
        });

        $(".see-road").on('click', function () {
            var dataId = $(this).attr('data-id');
            var active = $(this).attr('data-active');

            $(".hybrid-iframe").empty();
            $(".see-road").attr('data-active',"0");
            $(".see-road").html('VER RECORRIDO <i class="text--blue mdi mdi-plus"></i>');
            
            if (active === "0") {

                var iframe = '<iframe scrolling="no" seamless="seamless" frameborder="0" style="border: none" height="390px" width="100%" src="{{ hybridsAPI }}/report.php?embed=1&h='+dataId+'"></iframe>';

                $("#"+dataId).append(iframe);
                $(this).attr('data-active',"1");
                $(this).html('OCULTAR RECORRIDO <i class="text--blue mdi mdi-minus"></i>');
            }else{
                $(this).attr('data-active',"0");
                $(this).html('VER RECORRIDO <i class="text--blue mdi mdi-plus"></i>');
                $("#"+dataId).empty();

            }
        });

        $(".hybridInfo").on('click', function (e) {
            e.preventDefault();
            var target = $($(this).attr('data-target'));
            $(".in").not(target).collapse('hide');
        })
    </script>
{% endblock %}
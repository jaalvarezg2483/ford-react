{% extends "base.html.twig" %}

{% block title %}Elegir familia{% endblock %}

{% block meta %}
    <meta name="identifier-url" content="" />
    <meta name="title" content="Ford"/>
    <meta name="description" content="Seleccione la familia del vehiculo a financiar" />
    <meta name="abstract" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="revisit-after" content="1" />
    <meta name="language" content="es" />
    <meta name="copyright" content="© 2017" />
    <meta name="organization" content="">
    <meta name="revisit-after" content="1 day">
    <meta name="origen" content="">
    <meta name="locality" content="San José , Costa Rica">
    <meta name="distribution" content="global">
    <link rel="image_src" href="" >
    <meta name="dcterms.abstract" content="">
    <meta name="dcterms.rightsHolder" content="">
    <meta NAME="robots" CONTENT="noindex">
{% endblock %}

{% block body %}
    <div class="wrapper wrapper-accesories">
        <div class="container container--breadcrumb">
            <ol class="breadcrumb">
                <li><i class="icon icon-arrow-left breadcrumb-back"></i></li>
                <li><a href="{{path('home')}}">Inicio</a></li><li><a href="{{path('sucursales')}}">Sucursales</a></li><li>{% if type != "test-drive" %}Calcular Financiamiento{% else %}Prueba de Manejo{% endif %}</li>
            </ol>
        </div>
        <section class="container">
            <h1 class="title text-center">{% if type != "test-drive" %}Calcular Financiamiento{% else %}Prueba de Manejo{% endif %}</h1>
            <p class="text text-center">Elegí la familia para ver los modelos</p>
            <div class="section">
                <div class="menu--mock">
                    <div class="hidden-sm hidden-xs">
                        <div class="container">
                            <ul class="tabs">
                                {% for type in categories  %}
                                <li class="tab {% if loop.index == 1 %} active {% endif %}"><a href="#select-model-{{ loop.index }}" data-toggle="tab">{{ type.name }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    <ul class="collapsible tab-content">
                        {% for type_category in categories  %}
                        <li class="tab-pane fade {% if loop.index == 1 %} in active {% endif %}" id="select-model-{{ loop.index }}">
                            <button type="button" class="collapsible__header js-collapse-next {% if loop.index == 1 %}  {% endif %}"><i class="mdi mdi-plus"></i>{{ type_category.name }}</button>
                            <div class="collapsible__body container-fluid">
                                <div class="row row--flex">
                                {% for family in type_category.families2 %}
                                    {% if (dont_show[family.id] is not defined and type == "test-drive") or (type != "test-drive" and family.showCalculate == true)%}
                                    <div class="col-sm-6 col-md-3 family-wrap">
                                        {% if type == "test-drive" %}
                                            <a href="{{ path('prueba-manejo', {"slug": family.slug, "code": models[family.id].code}) }}">
                                        {% else %}
                                            <a href="{{  path('step2-subsidiary', {"name": subsidiary, "type": type, "slug": family.slug}) }}">
                                        {% endif %}
                                            <div class="family">
                                                <div class="family__img">
                                                    <img src="{{ family.getWebPath() ? server_url ~ '/' ~ family.getWebPath()  : '/img/content/yaris-small.png' }}" alt="Car" class="img-responsive">
                                                </div>
                                                <div class="family__text">
                                                    <h2> 
                                                        {{ family.name }}
                                                        {{family.hybrid == true ? '<span class="mdi mdi-leaf"></span>' : ''}}
                                                    </h2>
                                                    {% if dataSheets[family.id] is defined %}
                                                        <p class="family__cta--download">Ver PDF</p>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    {% endif %}
                                {% endfor %}
                                </div>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </section>
    </div>

{%  endblock %}

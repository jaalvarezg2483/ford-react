<div id="form-testDrive" class="row quotation__form" hidden>
    <h1 class="subtitle--large not-bold text-center title-margin-more">Enviar cotización al correo</h1>
    <div class=" form--custom card">
    <form action="{{ path('test_drive_by_family', {slug: family.slug}) }}" method="post" class="form" id="contactForm">
        {#{{ path('prueba-manejo', {slug: family.slug, code: model.code}) }}#}
        <div class="card__content bg--gray">
            <div class="container">
                <p><strong>ME INTERESA EL VEHÍCULO:</strong></p>
                <p class="quotation__model">
                    <span>{{ family.name }}</span>
                    {#{{ model.name }}#}
                </p>
            </div>
        </div>
        <div class="card__content">
            <div class="container">
                <div class="row">
                    <div class="col-sm-12">
                        <p><strong>MIS DATOS</strong></p>
                        <div class="input-field">
                            <div class="select">
                                {{ form_widget(form.tipoCedula, {"attr":{"class":"js-select change_identification_type", "required":"required"}}) }}
                            </div>
                        </div>
                        <div class="input-field">
                            {{ form_widget(form.cedula, {attr: {"class": "input identification", "data-parent": form.tipoCedula.vars.id}}) }}
                        </div>
                        <div class="input-field">
                            {{ form_widget(form.first_name, {attr: {"class": "input"}}) }}
                        </div>
                        <div class="input-field">
                            {{ form_widget(form.last_name, {attr: {"class": "input"}}) }}
                        </div>
                        <div class="input-field">
                            {{ form_widget(form.email, {attr: {"class": "input"}}) }}
                        </div>
                        <div class="input-field">
                            {{ form_widget(form.mobile, {attr: {"class": "input telefono", "data-inputmask":"'mask': '99999999'"}}) }}
                        </div>

                        <div class="input-field">
                            <div class="select">
                                {{ form_widget(form.provincia, {"attr":{"required":"required", "data-target":form.canton.vars.id, "class":"js-select "~form.provincia.vars.attr.class|default("")}}) }}
                            </div>
                        </div>

                        <div class="input-field">
                            <div class="select">
                                {{ form_widget(form.canton, {"attr":{"required":"required","data-target":form.distrito.vars.id, "class":"js-select "~form.canton.vars.attr.class |default("")}}) }}
                            </div>
                        </div>

                        <div class="input-field">
                            <div class="select">
                                {{ form_widget(form.distrito, {"attr":{"required":"required","class":"js-select "~form.distrito.vars.attr.class|default("")}}) }}
                            </div>
                        </div>

                        <div class="input-field">
                            {{ form_widget(form.direccion, {attr: {"class": "input"}}) }}
                        </div>

                        <p><strong>SUCURSAL</strong></p>
                        <div class="input-field">
                            <div class="select">
                                {{ form_widget(form.sucursal, {"attr":{"class":"js-select"}}) }}
                            </div>
                        </div>
                        <input hidden name="idModel" type="text" id="idModel">
                        <button type="submit" name="button" class="btn btn--black btn--block">ENVIAR</button>
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
    </form>
    </div>
</div>
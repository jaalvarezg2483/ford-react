<div class="wrapper">
    <div class="find-us">
        <div class="container">
            <h1 class="title text-center">ENCONTRANOS</h1>
            <ul class="tabs tabs-gray-fc">
                <li class="tab active"><a>SUCURSALES</a></li>
            </ul>
            <form class="find-us__filter">
                <div class="find-us__search">
                    <div class="input-field">
                        <input type="text" id="search" placeholder="Buscar Sucursal">
                    </div>
                </div>
                <div class="checkbox--container">
                    <div class="input-field">
                        <input type="checkbox" class="checkbox" name="nuevo" value="nuevos" id="nuevo">
                        <label for="nuevo">Ventas Nuevos</label>
                    </div>
                    <div class="input-field">
                        <input type="checkbox" class="checkbox" name="taller" value="taller" id="taller">
                        <label for="taller">Taller de Servicio</label>
                    </div>
                    <div class="input-field">
                        <input type="checkbox" class="checkbox" name="repuestos" value="repuestos" id="repuestos">
                        <label for="repuestos">Repuestos</label>
                    </div>
                    <div class="input-field">
                        <input type="checkbox" class="checkbox" name="ventas usados" value="usados" id="ventas usados">
                        <label for="ventas usados">Ventas Usados</label>
                    </div>
                </div>

            </form>
        </div>

        <div class="container container--full-mobile">
            <ul class="collapsible card find-us__office">
                {% for sucursal in sucursales %}
                    {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
                        {% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}
                            <li class="items--list-js" data-service="{{ sucursal.workshop ? 'taller' : '' }} {{ sucursal.spares ? 'repuestos' : ''}} {{ sucursal.newSales ? 'nuevos' : '' or 'Comerciales' in info.subsidiaryInfo.info ? 'nuevos' : ''}} {{ sucursal.usedSales ? 'usados' : ''}}">
                        {% endif %}
                    {% endfor %}
                    <button type="button" class="collapsible__header js-collapse-next js-toggle-map" data-lat="{{sucursal.latitude}}" data-long="{{sucursal.longitude}}"><i class="mdi mdi-plus"></i>{{sucursal.name}}</button>
                    <div class="collapsible__body">
                        <div class="collapsible__padding">
                            {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
                                {% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}
                                    <p><strong>{{info.subsidiaryInfo.typeInfo}}</strong></p>
                                    <ul class="list--checks list--2-cols" data-services="{{info.subsidiaryInfo.info}}">
                                        {% for item in info.subsidiaryInfo.info|split(',') %}
                                            <li class="item--category-js">{{item}}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <div class="map" id="map{{sucursal.id}}"></div>
                        <div class="find-us__btns clearfix">
                            <a href="http://maps.google.com/maps?q={{sucursal.latitude}},{{sucursal.longitude}}&navigate=yes" target="_blank" class="btn"><i class="mdi mdi-navigation"></i> NAVEGAR</a>
                            <a href="tel:+{{sucursal.phone}}" class="btn"><i class="mdi mdi-phone"></i> LLAMAR</a>
                        </div>
                        <div class="collapsible__padding">
                            <div class="row">
                                <div class="col-sm-6">
                                    {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
                                        {% if info.subsidiaryInfo.typeInfo != 'Servicios:' %}
                                            <p><strong>{{info.subsidiaryInfo.typeInfo}}</strong></p>
                                            <p>{{info.subsidiaryInfo.info}}</p>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="col-sm-6">
                                    <div class="office__img">
                                        <img src="/uploads/subsidiary/{{sucursal.path}}" alt="{{sucursal.name}}">
                                    </div>
                                    <ul class="office__cta">
                                        {#{% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}#}
                                        {#{% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}#}
                                        {#{% if 'Taller' in info.subsidiaryInfo.info %}#}
                                        {#<li><a href="#"><i class="mdi mdi-email"></i> Solicitar cita en el taller</a></li>#}
                                        {#{% endif %}#}
                                        {#{% endif %}#}
                                        {#{% endfor %}#}
                                        {% if sucursal.isTestDrive() == 1 %}
                                            <li><a href="{{ path('step1-subsidiary', {'name': sucursal.name, 'type': 'test-drive'}) }}"><i class="mdi mdi-steering"></i> Solicitar prueba de manejo</a></li>
                                        {% endif %}
                                        <li><a href="{{ path('step1-subsidiary', {'name': sucursal.name, 'type': 'cotizacion'}) }}"><i class="mdi mdi-calculator"></i> Solicitar una cotización</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    </li>
                {% endfor %}
            </ul>
        </div>

    </div>
</div>

{% block scripts %}
    <script>
        var map;
        $('.js-toggle-map').one('click', function(){
            var lat = $(this).data('lat');
            var long = $(this).data('long');
            var content = $(this).next();
            var mapID = content.find('.map').attr('id');
            initMap(mapID, lat, long);
            setTimeout(function(){
                google.maps.event.trigger(map, 'resize');
            }, 100)
        });
        function initMap(mapID, lat, long) {
            var LatLng = {lat: lat, lng: long};
            map = new google.maps.Map(document.getElementById(mapID), {
                center: LatLng,
                zoom: 18,
                zoomControl: true,
                scrollwheel: false,
            });
        }
    </script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key={{google_maps_api_key}}"></script>
{% endblock %}

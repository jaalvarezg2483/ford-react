{% extends "base.html.twig"%}
{% block title %}Cotizar Renting{% endblock %}

{% block body %}

<div class="wrapper">
	<div class="container container--breadcrumb">
		<ol class="breadcrumb steps--backbot">
			<li><a href="javascript:history.back()"><i class="icon icon-arrow-left breadcrumb-back"></i></a></li>
			<li><a href="javascript:history.back()"> Atrás</a></li>
			<li>Renting</li>
		</ol>
	</div>
	<div class="container text-center">
		<h2 class="title title-margin">Cotizar Renting</h2>
		<div class="step--circles">
			<ul>
				<li class="active">
					<span>1</span>
					<p>Automóvil</p>
				</li>
				<li>
					<span>2</span>
					<p>Plazo</p>
				</li>
				<li>
					<span>3</span>
					<p>Cotización</p>
				</li>
			</ul>
		</div>
		<p class="text--larger margin--top"><strong>Elegir Automóvil</strong></p>
		{#<p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor.</p>#}
		<p>{{ home.getDisclaimerChooseBrand }}</p>

		{#SI EL USUARIO ESTÁ LOGGEADO#}
		{#<div class="margin--top">#}
			{#<button class="btn btn--red btn--block">Usar auto Actual</button>#}
			{#<p>Si deseas un automóvil diferente puedes elegirlo acontinuación</p>#}
		{#</div>#}
		{#FIN#}

	</div>
	<section class="section section--slider">
		<ul class="tabs js-tabs-car js-tabs-renting">
			{% for type in families %}
				<li class="tab {{ loop.first ? "active" : "" }}">
					<a href="#slider{{ loop.index }}" data-toggle="tab">{{ type.name }}</a>
				</li>
			{% endfor %}
		</ul>
		<ul class="collapsible tab-content" id="accordion">
			{% for type in families %}
				<li class="panel tab-pane fade tab--find-car {{ loop.first ? "in active" : "" }}" id="slider{{ loop.index }}">
					<button type="button" class="collapsible__header-show collapsed js-open-slider" data-toggle="collapse" data-target="#family_collapse_{{loop.index}}">
						<i class="mdi mdi-plus"></i> {{ type.name }}
					</button>

					<div class="collapsible__body-show collapse js-collapse-family" id="family_collapse_{{loop.index}}" data-parent="#accordion">
						<div class="slider-rentals-main js-slider-car slider slider--car">
							{% for family in type.families2 %}
								<div>
									<a class="js-show-sub slider__link" href="#" tabindex="0" data-attr="{{ family.id }}">
										<img src="{{ server_url ~ family.getFoto3() }}" alt="Toyota {{ family.name }} {{ family.principalModel.year | default(2017) }}">
										<h2>{{ family.name }} {{ family.principalModel.year | default(2017) }}</h2>
										{#<span class="line"><span>desde</span></span>#}
										{#<p class="title">${{ family.startPrice | number_format(0,',','.') }}</p>#}
									</a>
								</div>
							{% endfor %}
						</div>
						<div class="js-slider-models slider--models-container">
							<div class="container text-center">
								<h2 class="renting_models subtitle"></h2>
							</div>
							<div class="slider slider--models">
								
							</div>
						</div>
					</div>
				</li>
			{% endfor %}
		</ul>

		<div class="container text-center">
			<p>{{ home.getDisclaimerChooseModel }}</p>
		</div>
	</section>
</div>

<div class="card hidden" id="copy-card" data-type="{{ type_rental }}">
	<div class="card__image">
		<img src="{{ server_url }}" alt="">
	</div>
	<div class="card__content">
		<h2 class="card__title">COROLLA L 2018</h2>
		<p class="card__text">Automático</p>
	</div>
	<div class="card__action">
		<a href="" class="" data-car="COROLLA L 2018">Seleccionar Vehículo</a>
	</div>
</div>



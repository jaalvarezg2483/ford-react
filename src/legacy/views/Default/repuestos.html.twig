{% extends "base.html.twig"%}
{% block title %} Repuestos {% endblock %}

{% block body %}

<div class="wrapper--car">
  <div class="menu--inner">
    <button type="button" class="menu--inner__toggle js-collapse-next">
      <p>REPUESTOS</p>
      <i class="mdi mdi-chevron-down"></i>
    </button>
    <ul class="tabs--drop-mobile">
      <p class="menu--inner__name">REPUESTOS</p>
      <li class="tab active"><a href="{{ path('category_by_alias', {"category_alias": 'repuestos'}) }}">Contacto</a></li>
      <li class="tab"><a href="{{ path('repuestos-ford') }}" target="_self">Repuestos Ford</a></li>
      <li class="tab"><a href="{{ path('boletin') }}">Boletín Pro800</a></li>
    </ul>
  </div>

  <div class="container container--breadcrumb">
    <ol class="breadcrumb">
      <li><a href=""><i class="icon icon-arrow-left breadcrumb-back"></i></a></li><li><a href="{{path('index')}}"> Inicio</a></li><li>Repuestos</li>
    </ol>
  </div>

  <div class="slider slider--card js-slider-card">
    {{ render(controller("LumenCMSBundle:Default:renderSlider", {"name":"REPUESTOS_HOME"})) }}
    {#<div>#}
      {#<img src="/img/content/banner-repuestos-01.png" alt="Conductor prevenido vale por dos">#}
    {#</div>#}
    {#<div>#}
      {#<img src="/img/content/banner-repuestos-02.png" alt="20% descuento en fibras y zapatas">#}
    {#</div>#}
    {#<div>#}
      {#<img src="/img/content/banner-repuestos-03.png" alt="Beneficios">#}
    {#</div>#}
  </div>

  <div class="container">

    <div class="row js-equal-height-parent">
      <div class="col-md-4">
        <a href="{{path('contactar-asesor-repuestos')}}" class="card card--link js-equal-height">
          <div class="card__content">
            <i class="mdi mdi-account"></i>
            <h2 class="card__title">Contactar asesor</h2>
          </div>
        </a>
      </div>
      <div class="col-md-4">
        <a href="tel:+(506)25197777" class="card card--link js-equal-height">
          <div class="card__content">
            <i class="mdi mdi-phone"></i>
            <h2 class="card__title">Llamar</h2>
            <p class="card__text">(506) 2519-7777</p>
          </div>
        </a>
      </div>
      <div class="col-md-4">
        <a href="#" class="card card--link js-equal-height chat-btn">
          <div class="card__content">
            <i class="mdi mdi-message"></i>
            <h2 class="card__title">Chat</h2>
          </div>
        </a>
      </div>
    </div>

    <h2 class="title title-margin text-center">REPUESTOS Ford</h2>
    <div class="slider slider--cards slide--cards-two js-slider-cards-two js-equal-height-parent">
        {% include 'LumenAppBundle:Default:partials/_repuestos.html.twig' with {"repuestos": repuestos} %}
    </div>

    <div class="card">
      <div class="row">
        <div class="col-sm-6">
          <div class="release__img">
            <img src="/img/content/boletin.png" alt="">
          </div>
        </div>
        <div class="col-sm-6">
          <div class="release__text ">
            <a href="{{ path('boletin') }}" class="subtitle subtitle--icon">Boletín Pro800 <i class="mdi mdi-chevron-right"></i></a>
            <p>Encontrá aquí los últimos boletines correspondientes a nuestros talleres de Pro800. Serán gran utilidad para vos y para tu negocio.</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  {% include "LumenAppBundle:Default/partials:_banner-bottom.html.twig" with {} %}

</div>

{% endblock %}

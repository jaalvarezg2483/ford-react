{% endblock %}

{% block scripts %}
	<script>
        $(".change_model").on('change', function () {
            window.location.href = "{{ path('preapproved-model', {'slug': 'temporal'}) }}".replace("temporal", $(this).val());
        });
	</script>
{% endblock %}
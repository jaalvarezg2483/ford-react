{% extends "base.html.twig"%}
{% block title %}Pre Aprobación de Crédito | Ford Costa Rica | Grupo Purdy | Elegir modelo{% endblock %}
{% block meta %}
	<meta name="identifier-url" content="" />
	<meta name="title" content="Pre Aprobación de Crédito | Ford Costa Rica | Grupo Purdy "/>
	<meta name="description" content="Solicita la preaprobación rápida para crédito de vehículos Ford en línea. Asegura el financiamiento y acelera tu compra. ¡Solicítalo en nuestra web hoy!" />
	<meta name="keywords" content="credito para compra de vehiculo, preaprobado vehiculo, credito vehiculo Ford" />
	<meta name="author" content="" />
	<meta name="revisit-after" content="1" />
	<meta name="language" content="es" />
	<meta name="copyright" content="© {{ "now" | date("Y") }}" />
	<meta name="organization" content="">
	<meta name="revisit-after" content="1 day">
	<meta name="origen" content="">
	<meta name="locality" content="San José , Costa Rica">
	<meta name="distribution" content="global">
	<link rel="image_src" href="" >
	<meta name="dcterms.abstract" content="">
	<meta name="dcterms.rightsHolder" content="">
	<meta NAME="robots" CONTENT="noindex">
{% endblock %}



{%  block template_car %}
	<div class="col-xs-12 col-sm-4">
		<div class="calculate-card">
			<div class="calculate-card-content">
				<img src="{{ image }}" class="calculate-card-img">
				<div class="calculate-card-text">
					<h4 class="title">{{ name }}</h4>
					<p>desde</p>
					<h4 class="title">${{ price }}</h4>
				</div>
			</div>
			<div class="calculate-card-btns">
				<a class="btn btn--clear js-btn-modal" href="#modal-calculate-cars" data-toggle="modal" data-index="{{loop.index}}">Ver más <i class="icon icon-plus"></i></a>
				<a href="{{ path('preapproved-calculate-step5', {"slug": slug, "code":code}) }}" class="btn btn--clear">Seleccionar <i class="icon icon-arrow-right"></i></a>
			</div>
		</div>
	</div>
{% endblock %}


{% block body %}
{% include '@LumenCMS/MenuTemplates/script-select-menu.html.twig' with {'searchMenu': 'Herramientas de compra'} %}
<div>
	<div class="calculate--cancel bg--accent-light">
		<a class="btn btn--clear" href="{{  path('preapproved-family') }}"><i class="icon icon-arrow-left"></i> Cancelar</a>
	</div>
	<div class="text-center margin--top">
		<h2 class="title">Pre Aprobación de Crédito</h2>
	</div>
	{#<div class="calculate-nav">#}
		{#<div class="calculate-nav-item current"><button class="calculate-nav-btn">1</button><span>Vehículo</span></div>#}
		{#<div class="calculate-nav-item"><button class="calculate-nav-btn">2</button><span>Adicionales</span></div>#}
		{#<div class="calculate-nav-item"><button class="calculate-nav-btn">3</button><span>Cálculo</span></div>#}
	{#</div>#}
</div>
<div class="calculate--top container">
	<div class="row margin--top">
		<div class="input-field col-md-4 select-cars select">
			<select class="js-select change_model">
				{% for family in families %}
					<option {{ current.id == family.id ? "disabled selected" : "" }} value="{{ family.slug }}">{{ family.name }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="row">
		<p class="padding-1">Seleccioná el modelo para calcular financiamiento.</p>
	</div>
</div>
<div class="calculate--content">
	<section class="container container-cards-calculate">
        {% for subList in models | batch(4)%}
			<div class="row">
                {% for model in subList %}
                    {% set image = server_url ~ "/" ~ model.getWebPath() %}
                    {% set name = model.name %}
                    {% set price = model.startPrice | number_format(0, ",", ".") %}
                    {% set code = model.code %}
                    {% set slug = current.slug %}
					{%  set caracteristicas = model.mainFeatures %}
                    {{ block("template_car") }}
                {% endfor %}
			</div>
		{% endfor %}
	</section>
</div>


<div class="modal fade modal--full" id="modal-calculate-cars">
	<div class="modal-dialog" role="document">

    	<div class="modal-content cars-slider-modal">

			{% for model in models %}
				{% set image = server_url ~ "/" ~ model.getWebPath() %}
				{% set name = model.name %}
				{% set price = model.startPrice | number_format(0, ",", ".") %}
				{% set code = model.code %}
				{% set slug = current.slug %}
				{%  set caracteristicas = model.mainFeatures %}
				<div class="car-calculate-slide">
					<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>

					<div class="slide-mask hidden-xs">
						<img src="{{image}}" class="slide-image"/>
					</div>
					<div class="slide-content">
						<div class="slide-content-text">
							<h2 class="title">{{name}}</h2>
							<h4 class="title">desde $ {{price}}</h4>
							
							<img src="{{image}}" class="slide-image hidden-md"/>
							
							<ul class="slide-car-list">
								{% for feature in model.mainFeatures %}
									<li>{{feature.name}}</li>
								{% endfor %}
							</ul>
						</div>
						<div class="btns-container">
							<a href="{{ path('preapproved-calculate-step5', {"slug": slug, "code":code}) }}" class="btn btn--primary" data-code="{{code}}">Seleccionar Modelo</a>
							<button class="btn" id="modal-slider-next">Ver siguiente</button>
						</div>
					</div>	
				</div>
			{% endfor %}
    	</div>
  	</div>
</div>




<div class="submenu__tabs">
	<div class="container">
		<div class="container margin--top margin--bottom">
			<h2 class="title">Vehículos</h2>
			<h1 class="title">nuevos</h1>
		</div>
		<ul class="tabs tabs-gray js-tabs-animate">
			{% for type in families  %}
			<li class="tab {% if loop.index == 1 %} active {% endif %} {{ type.textColor is defined and type.textColor is not null and type.code == 'ford-performance' ? 'custom-color' : '' }}" style="--category-text-color:#{{ type.textColor is defined and type.textColor is not null ? type.textColor : '#141414' }};
					--underlined-text-color:#{{ type.underlinedTextColor is defined and type.underlinedTextColor  is not null ? type.underlinedTextColor   : '#05629D'}};">
				<a href="#submenu{{ loop.index }}" data-toggle="tab">{{ type.name }}</a>
			</li>
			{% endfor %}
		</ul>
	</div>
</div>

<ul class="collapsible tab-content">
    {% for type in families %}
		<li class="tab-pane fade {% if loop.index == 1 %} in active {% endif %}" id="submenu{{ loop.index }}">

			<div class="collapsible__body container-fluid">
				{% set allFamilies =  type.families2 | merge(type.forceModel)%}
				<div class="row row--flex">
				{% for family in allFamilies %}
					<div class="col-md-4 family-wrap">
						<a {% if family.blockMenu == true %}class="link-disabled" {% endif %} href="{{  path('model_list', {"slug" : family.slug}) }}">
							<div class="family">
								<div class="family__img">
									<img src="{{ family.getWebPath() ? server_url ~ '/' ~ family.getWebPath()  : '/img/content/yaris-small.png' }}" alt="Car" class="img-responsive">
								</div>
								<div class="family__text">
									<h3 class="title">
										{{ family.name }}
									</h3>
									{% if family.hidePrice is defined and not family.hidePrice %}
										<p>desde</p>
										<h4 class="title">${{ family.startPrice | number_format(0, ',', '.') }}</h4>
									{% else %}
										{% if family.comingSoon is defined and family.comingSoon %}
											<h4 class="title">Coming Soon</h4>
										{% endif %}
									{% endif %}

									{% if hasFamilyType(family.getFamilyType2().toArray() , 'ford-performance') %}
										<img class="ford-p-img" src="/img/fordPerformance.png" alt="">
									{% endif %}
								</div>
								<i class="icon icon-arrow-right"></i>
							</div>
						</a>
					</div>
				{% endfor %}
				</div>
			</div>
			{% if type.getCode() == 'ford-performance' %}
				<div class="ford-performance-text">
					<img src="/img/logos/logo-ford-performance.png" alt="">
					<hr>
					<h2 class="title">Innovación a través del rendimiento</h2>
					<p class="text">Gracias al conocimiento, las habilidades y la experiencia de nuestras unidades Ford Racing, Team RS y otras divisiones de vehículos especiales, logramos desarrollar Ford Performance, una unidad de la marca con una clara  intención de siempre desarrollar deportividad, rendimiento y potencia en todos sus modelos.</p>
					<p class="text">El Nuevo Ford GT, el Nuevo Ford Mustang, Focus ST, Fiesta ST, Nuevo Ford Ranger Raptor y Nuevo Ford Focus ST. Esta increíble alineación es la carta de presentación de nuestra división Ford Performance.</p>
				</div>
			{% endif %}
		</li>
	{% endfor %}
</ul>





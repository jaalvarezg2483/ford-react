{% if show_captcha == "true" %}
    <script src='https://www.google.com/recaptcha/api.js'></script>
    <script>
        $(".verify-captcha").submit(function () {
            return validateform();
        });

        function validateform(){
            var get_captcha_response = grecaptcha.getResponse();

            if(get_captcha_response.length == 0 || !get_captcha_response)
            {
                // Captcha is not Passed
                $("#keycode").removeClass("hidden").css('display','');
                // Depends on view
                $("#send-button").attr("disabled",false);
                $("#btn-submit").attr("disabled",false);

                verifyCaptcha = false;
                return false;
            }
            else
            {
                // Captcha is Passed
                $("#keycode").addClass("hidden");
                return true;
            }
        }
    </script>

{% endif %}
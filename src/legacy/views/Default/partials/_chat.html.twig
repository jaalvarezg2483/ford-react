<script type="text/javascript">
    var is_link = false;
    function open_chatbox(event)
    {
        if(typeof event != "undefined")
            event.preventDefault();
        // Ocultar la bolita
        $(".chat__toggle").fadeOut();
        $('.chat__box').addClass('chat-is-open');
        cancelOverflow();
//        $("#webchatLogin").hide();
        //$("#winDisplayAgent, #webchat_chat_area").hide();

    }
    function closeChat()
    {

        //	And hide login page / please wait page

        $('.chat__box').removeClass('chat-is-open');chat
        $(".chat__toggle").fadeIn();
        $("#webchat_user_input").trigger('reset');
        $("#webchat_user_input #skillset").val('').trigger('change');

        // Mostrar la bolita
    }

    function finalCloseSession()
    {
        closeAgentWin();
        setCookie("cookie_skillset", "", 0);
        setCookie("cookie_subject", "", 0);
        setCookie("cookie_reference", "", 0);
        setCookie("cookie_username", "", 0);
        setCookie("ann_session_key", "", 0);
        contact_id = 0;
        CustomTextLine = "[Cliente] ";
        CustomerID = "";
    }

    function leftSession () {
        var session_cookie_key = getCookie("session_key");

        // Verificar si hay sesión activa
        if(typeof session_cookie_key != "undefined" && session_cookie_key != "")
        {
            var c = confirm("Desea terminar la conversacion?");
            // Mostrar la bolita
            if (c == true) {

                finalCloseSession();

                $("#webchatLogin").show();
                $("#winDisplayAgent, #webchat_chat_area, #webchat_please_wait").hide();
                $("#webchat_user_input").show();
            }
        }
        $(".chat__toggle").fadeIn();
    }

    $(document).ready(function () {
        $(document).on("click", "a", function(){
            is_link = true;
        });

        $(document).on("submit", "form", function(){
            is_link = true;
        });

        continueConversation();
        $(document).on("click", ".chat__top",  closeChat);
        $(document).on("click", ".chat__close",  leftSession);
        $(document).on("click", "#chat, .chat-btn",  open_chatbox);
        $(document).on("click", ".chat__start",  processChatRequest);
        $(document).on("click", "#comments",  RemovePlaceHolder);
        $(document).on("keypress", "#comments",  function (event) {
            return checkEnter(this,event);
        });

        $(document).on("keypress", ".no-space",  function (event) {
            return checkSpace(event);
        });
        $(document).on("click", "#enterButton",  processText);

        $(".email_send").hide();


        $(document).on("click", ".evt_send_email_click", function(){
            if($(this).is(":checked"))
            {
                $(".email_send").show("slow");


//                var isMobile = window.matchMedia("only screen and (max-width: 760px)");
//
//                if (isMobile.matches) {
//                    $(".chat__history").attr('style','height: calc(100% - 400px) !important');

//                }

            }
            else
            {
                $(".email_send").hide("slow");

//                var isMobile = window.matchMedia("only screen and (max-width: 760px)");
//
//                if (isMobile.matches) {
//                    $(".chat__history").attr('style','height: calc(100% - 288px) !important');
//                }

            }
        });

        $('#history').bind("DOMSubtreeModified", function () {
            fixBubbles();
        });

        $('.tools__toggle').on('click', function(e){
            e.preventDefault();
            $('.icons--list').toggleClass('open--mobile');
            if ($('.icons--list').hasClass('open--mobile')){
                $(this).html('Cerrar <span class="mdi mdi-close"></span>')
            } else {
                $(this).html('Herramientas de compra <span class="mdi mdi-chevron-up"></span>')
            }
        });

        $(document).click(function(e) {
            var container = $(".car--buying__tools");

            if (!container.is(e.target) && container.has(e.target).length === 0) {
                $('.icons--list').removeClass('open--mobile');
                $('.tools__toggle').html('Herramientas de compra <span class="mdi mdi-chevron-up"></span>');
            }
        });
    });

    function fixBubbles()
    {
        $('.clouds-mjs').find("div").each(function (index) {
            if (this.style.backgroundColor == "rgb(235, 235, 235)") {
                $(this).attr("class", "chatter");
            } else {
                $(this).attr("class", "user");
            }
        });
    }

    function cancelOverflow() {

        var isMobile = window.matchMedia("only screen and (max-width: 760px)");

        if (isMobile.matches) {

            $('html, body').css({
                overflow: 'hidden',
                height: '100%'
            });

        }

    }


    function allowOverflow() {

        var isMobile = window.matchMedia("only screen and (max-width: 760px)");

        if (isMobile.matches) {
            $('html, body').css({
                overflow: 'auto',
                height: 'auto'
            });
        }


    }


</script>


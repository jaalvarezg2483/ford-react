<script type="text/javascript">

    function confirmUnload() {
        var session_cookie_key = getCookie("session_key");

        // Verificar si hay sesión activa
        if(typeof session_cookie_key != "undefined" && session_cookie_key != "" && is_link == false)
        {
            return "Desea terminar la conversacion?";
        }
        return null;
    }
    function closeSession () {
        var session_cookie_key = getCookie("session_key");

        // Verificar si hay sesión activa
        if(typeof session_cookie_key != "undefined" && session_cookie_key != "" && is_link == false)
        {

            finalCloseSession();
            document.getElementById('webchatLogin').style.display = "none";
            //	Show chat window
            document.getElementById('winDisplayAgent').style.display = "";
            document.getElementById('webchat_chat_area').style.display = "";

        }

    }
    function continueConversation () {
        var session_cookie_key = getCookie("session_key");
        session_key = session_cookie_key;
        var ann_session_key = getCookie("ann_session_key");
        var session_cookie_contact = getCookie("contact_id");
        contact_id = session_cookie_contact;
        var previous_url = document.referrer;
        var domain = "{{ chat_continue_domain }}";

        if (session_cookie_key != '') {

            //	Use existing session key if supplied


            var FirstName = getCookie("cookie_username");
            CustomTextLine = "["+FirstName+"] ";

            var email = getCookie("cookie_email");

            var phone = getCookie("phone_number");

            document.getElementById('username').value = FirstName;
            document.getElementById('email').value = email;

            document.getElementById('phone').value = phone;
            document.getElementById('skillset').value = getCookie("cookie_skillset");
            document.getElementById('subject').value = getCookie("cookie_subject");
            document.getElementById('reference').value = getCookie("cookie_reference");


            $("#webchatLogin").hide();
            $("#winDisplayAgent, #webchat_chat_area").show();
            //	Show chat window

            document.getElementById('EmailMeAddress').disabled = true;
            document.getElementById('CallMeNumber').disabled = true;

            CustomerID = getCookie("CustomerID");

            {#
            var text = CustomTextLine + "Abrí la página "+window.location.href;
            jqSajax.x_SendMessage(session_cookie_key, session_cookie_contact, text , "", "Chat_Message_from_Customer", "");
            #}
            Refresh();

            fixBubbles();
            open_chatbox();

        }
    }

    function setCookie(cname, cvalue, exdays) {
        var d = new Date();
        d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
        var expires = "expires="+d.toUTCString();
        document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
    }

    function getCookie(cname) {
        var name = cname + "=";
        var ca = document.cookie.split(';');
        for(var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }

    function checkCookie() {
        setCookie("username", "", 0);

        //alert(document.cookie);
    }
    var elementID;


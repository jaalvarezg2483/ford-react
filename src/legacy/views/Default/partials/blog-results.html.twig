{% for article in articles %}
    <section class="col-sm-12 col-md-3">

        <a class="blog-link js-equal-height blog" href="{{ path("article_by_alias_and_category", {"category_alias": article.category.alias, "article_alias": article.alias}) }}">

            <div class="article-img">
                <img src="{{ article.getWebPath() | imagine_filter('blog_teaser') }}">
            </div>

            <div class="card__content">
                <h5 class="title">{{ article.title() }}</h5>
                <p class="text--primary text--bold">Ver más <i class="icon icon-arrow-right"></i></p>
            </div>
        </a>
    </section>

{% else %}
    <div>No hay resultados para su consulta</div>
{% endfor %}
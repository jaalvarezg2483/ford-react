{% set currRoute = app.request.get('_route') %}
<header class="header">
	<a class="text-replace logo-ford" href="{{path('index')}}">FORD</a>
	<button type="button" class="btn btn--smallest js-submenu-open hidden-md" data-sub="subNuevos">Vehículos nuevos</button>
	<button type="button" class="menu__toggle js-menu-toggle"><i class="icon icon-hamburger"></i></button>
</header>


<menu class="menu">
	<!-- <a href="" class="menu__search"> <i class="mdi mdi-magnify"></i> Buscar en el sitio </a> -->
	<div class="menu__field">
		<!-- <a class="js-close_search"><i class="mdi mdi-close"></i></a> -->
		<form action="{{ path("results_search") }}" method="get">
			<input class="js-hidde_menu input" type="text" placeholder="Buscar en el sitio">
			<button type="button" name="button"><i class="icon icon-arrow-right"></i></button>
		</form>

	</div>
	<ul class="menu__top">
		<li><a href="{{ path('cms_home') }}" class="menu__item {% if currRoute == 'cms_home' %}active{% endif %}">Inicio</a></li>
		<li>
			<button type="button" class="menu__item js-submenu-open 
				{% if currRoute == 'model_list' or currRoute == 'model_list_specs' or currRoute == 'model_list_characteristic' or currRoute == 'model_list_gallery' %}active{% endif %}
			" data-sub="subNuevos">Vehículos nuevos</button>
		</li>
		{{ draw_menu("MainMenu", false) }}
	</ul>
	<ul class="menu__right">	
		<li>
			<a href="{{ path('category_by_alias', {'category_alias': 'herramientas-de-compra'}) }}" class="menu__item wide-line {% if currRoute == 'comparador' %}active{% endif %}"><span class="icon icon-dolar hidden-xs"></span> Herramientas de compra </a>
		</li>
		<li><a href="{{path('calculate')}}" class="menu__item wide-line {% if currRoute == 'calculate' %}active{% endif %}"> <i class="icon icon-calculator hidden-xs"></i> Calcular Financiamiento </a></li>
		<li><a href="#" class="btn--search menu__item js-search-open"> <i class="icon icon-search"></i> </a></li>
	</ul>
	<ul class="menu__social-media">
		<li><a href="https://www.facebook.com/FordCostaRica" target="_blank"><span class="icon icon-facebook"></span></a></li>
		<li><a href="https://www.youtube.com/channel/UC9dvZm4Gt1ggI428hfulSDQ" target="_blank"><span class="icon icon-youtube"></span></a></li>
		<li><a href="https://www.instagram.com/fordcostarica/" target="_blank"><span class="icon icon-instagram"></span></a></li>
	</ul>
	{# <button type="button" class="menu__chat chat-btn"> <i class="icon icon-chat-alt"></i> Iniciar chat con un experto</button> #}
</menu>

<div class="submenu" id="subNuevos">
	{# <button type="button" class="submenu__back js-submenu-close"> <i class="icon icon-chevron-left"></i> Autos nuevos</button> #}
	{{ car_menu() }}
</div>

{% if cedula | default(false) %}
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="tipoCedula">Tipo de identificación<small class="text--primary">*</small></label>
  <div class="select">
      {{ form_widget(form.tipoCedula, {"attr":{"class":"js-select change_identification_type", "required":"required"}}) }}
  </div>
</div>
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="cedula">Identificación<small class="text--primary">*</small></label>
    {{ form_widget(form.cedula, {attr: {"class": "input identification", "data-parent": form.tipoCedula.vars.id}}) }}
</div>
{% endif %}
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="first_name"><small class="text--primary">*</small> Nombre</label>
  {{ form_widget(form.first_name, {attr: {"class": "input", "placeholder":"Juan"}}) }}
</div>
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="last_name"><small class="text--primary">*</small> Apellido </label>
    {{ form_widget(form.last_name, {attr: {"class": "input", "required":"required", "placeholder":"Rodríguez"}}) }}
</div>
{% if renting is defined and renovar is defined%}
  <div class="input-field">
    <label class="label--black" for="cedula"><small class="text--primary">*</small> Cédula </label>
    <input class="input" placeholder="112340567" id="{{ field_id(form, 'cedula') }}" name="{{ field_name(form, 'cedula') }}" value="{{ aditionalValues["cedula"] | default("") }}">
  </div>
  <div class="input-field">
    {#<p class="text--gray"><small>*Obligatorio</small></p>#}
    <label class="label--black" for="plate"><small class="text--primary">*</small> Número de placa </label>
    <input class="input" placeholder="AAA000" id="{{ field_id(form, 'plate') }}" name="{{ field_name(form, 'plate') }}" required value="{{ aditionalValues["plate"] | default("") }}">
  </div>
{% endif %}
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="email"><small class="text--primary">*</small> Correo Electrónico </label>
  {{ form_widget(form.email, {attr: {"class": "input", "placeholder":"ejemplo@mail.com"}}) }}
</div>
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="mobile"><small class="text--primary">*</small> Teléfono</label>
  {{ form_widget(form.mobile, {attr: {"class": "input", "placeholder":"88888888"}}) }}
</div>
{% if placa | default(false) %}
<div class="input-field">
  {%  set aditionalValues = form.vars.value.aditionalFields | default([])%}
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="placa"><small class="text--primary">*</small> Número de placa</label>
  <input type="text" name="placa" id="placa" required="required" class="input" placeholder="AAA000" value="{{ aditionalValues["placa"] | default("") }}">
</div>
{% endif %}

{% if direccion | default(false) %}
<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="provincia"><small class="text--primary">*</small> Provincia</label>
  <div class="select">
      {{ form_widget(form.provincia, {"attr":{"required":"required", "data-target":form.canton.vars.id, "class":"js-select "~form.provincia.vars.attr.class|default("")}}) }}
  </div>
</div>

<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="canton"><small class="text--primary">*</small> Cantón</label>
  <div class="select">
      {{ form_widget(form.canton, {"attr":{"required":"required","data-target":form.distrito.vars.id, "class":"js-select "~form.canton.vars.attr.class |default("")}}) }}
  </div>
</div>

<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="distrito"><small class="text--primary">*</small> Distrito</label>
  <div class="select">
      {{ form_widget(form.distrito, {"attr":{"required":"required","class":"js-select "~form.distrito.vars.attr.class|default("")}}) }}
  </div>
</div>

<div class="input-field">
  {#<p class="text--gray"><small>*Obligatorio</small></p>#}
  <label class="label--black" for="direccion"><small class="text--primary">*</small> Dirección</label>
  {{ form_widget(form.direccion, {attr: {"class": "input", "placeholder": "Urbanización o Barrio"}}) }}
</div>
{% endif %}

{% if renting is defined %}
  <p class="form__title" id="comment-label">Comentario</p>
  <div class="input-field">
    <textarea class="textarea" aria-labelledby="comment-label" placeholder="Describe tu duda o consulta" id="{{ field_id(form, 'comment') }}" name="{{ field_name(form, 'comment') }}">{{ aditionalValues["comment"] | default("") }}</textarea>
  </div>
{% else %}
  <p class="label--black" id="comment-label"><small class="text--primary">*</small> Comentario  </p>
  <div class="input-field">
    {#<p class="text--gray"><small>* Obligatorio</small></p>#}
    <textarea class="textarea" aria-labelledby="comment-label" placeholder="Describe tu duda o consulta" id="{{ field_id(form, 'comment') }}" name="{{ field_name(form, 'comment') }}" >{{ aditionalValues["comment"] | default("") }}</textarea>
  </div>
{% endif %}

{% if sucursal | default(false) %}
<p class="form__title">SUCURSAL PARA HACER LA PRUEBA <small class="text--primary">*</small> </p>
<div class="input-field">
  {#<p class="text--gray"><small>* Obligatorio</small></p>#}
  <div class="select">
    {{ form_widget(form.sucursal, {"attr":{"class":"js-select"}}) }}
  </div>
</div>
{% endif %}

<div class="form__terms">
  Ver <a href="/article/terminos-condiciones" target="_blank">Términos y Condiciones</a>
</div>
{#<div class="input-field">#}
{#  <input id="autorizo_envio" name="autorizo_envio" type="checkbox" value="1" checked="" class="checkbox" required="required">#}
{#  <label for="autorizo_envio">Autorizo a Grupo Purdy el envío de información de sus productos y la utilización de mis datos de contacto.</label>#}
{#</div>#}
{% if seguimiento | default(false) %}
  {% if hiddenSeguimiento | default(false) %}
    <input id="{{ wtlead_seguimiento }}" name="{{ wtlead_seguimiento }}" type="hidden" value="1" class="checkbox" checked="">
  {% else %}
    <div class="input-field">
      <input id="{{ wtlead_seguimiento }}" name="{{ wtlead_seguimiento }}" type="checkbox" value="1" class="checkbox" checked="">
      <label for="{{ wtlead_seguimiento }}">¿Desea recibir seguimiento por parte de un Asesor de Ventas?</label>
    </div>
  {% endif %}
{% endif %}
{% if consentimiento is defined and consentimiento == true %}
  {% include "@LumenApp/Default/partials/_checkbox-consentimiento-informado.html.twig" %}
{% endif %}
{% if captcha is defined and show_captcha == "true" %}
  {% include "@LumenApp/Default/partials/_form-captcha-field.html.twig" %}
{% endif %}
<div class="center">
  <button id="send-button" type="submit" name="button" class="btn btn--primary btn--wider">Enviar mensaje</button>
</div>

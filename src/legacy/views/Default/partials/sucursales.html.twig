<div class="col-md-4">
    {% for sucursal in sucursales %}
        {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
            {% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}
                <div class="items--list-js" data-service="{{ sucursal.workshop ? 'taller' : '' }} {{ sucursal.spares ? 'repuestos' : ''}} {{ sucursal.newSales ? 'nuevos' : '' or 'Comerciales' in info.subsidiaryInfo.info ? 'nuevos' : ''}} {{ sucursal.usedSales ? 'usados' : ''}}">
            {% endif %}
        {% endfor %}
        <button type="button" class="collapsible__header js-collapse-id items--list-js" data-lat="{{sucursal.latitude}}" data-long="{{sucursal.longitude}}" data-id-target="sucursal-{{sucursal.id}}">{{sucursal.name}} <strong>{% if sucursal.distance !=  "" %}{{ sucursal.distance | number_format (1,".",",")}} km de vos{% endif %}</strong> <i class="icon icon-chevron-down"></i></button>
    <div class="collapsible__body sucursal-card" id="sucursal-{{sucursal.id}}">
        {# <div class="collapsible__padding">
            {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
                {% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}
                    <p><strong>{{info.subsidiaryInfo.typeInfo}}</strong></p>
                    <ul class="list--checks list--2-cols" data-services="{{info.subsidiaryInfo.info}}">
                        {% for item in info.subsidiaryInfo.info|split(',') %}
                            <li class="item--category-js">{{item}}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </div> #}
        {# <div class="map" id="map{{sucursal.id}}"></div> #}
        {% set path_img = '/uploads/subsidiary/' ~ sucursal.path %}
        <img  class="img-responsive" src="{{ path_img }}" alt="{{sucursal.name}}" >

        
        <div class="collapsible__padding">
            <div class="row">
                {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
                <div class="col-sm-6">
                    <div class="title-icon title-icon--small">
                        <div class="icon-box icon-box--secondary">
                            <i class="{{ info.subsidiaryInfo.icon }}"></i>
                        </div>
                        <p>{{info.subsidiaryInfo.info}}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="sucursal-card-btns">
                <a href="https://www.waze.com/es/livemap?zoom=15&lat={{ sucursal.latitude }}&lon={{ sucursal.longitude }}" target="_blank" class="btn"><i class="icon icon-waze"></i> Waze</a>
                <a href="http://maps.google.com/maps?q={{sucursal.latitude}},{{sucursal.longitude}}&navigate=yes" target="_blank" class="btn"><i class="icon icon-gmaps"></i> Google Maps</a>
                
                {% if sucursal.isTestDrive() == 1 %}
                    <div class="break"></div>
                    <a class="btn btn--primary" href="{{ path('step1-subsidiary', {'name': sucursal.name, 'type': 'test-drive'}) }}"><i class="icon icon-car"></i> Solicitar TestDrive</a>
                {% endif %}
            </div>
        </div>
    </div>
    {% for info in sucursal.getSubsidiarySubsidiaryInfoToArray %}
        {% if info.subsidiaryInfo.typeInfo == 'Servicios:' %}
        </div>
        {% endif %}
    {% endfor %}
{% endfor %}
</div>

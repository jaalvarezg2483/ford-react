<div class="test-drive-slider">
  <div class="test-drive-slide">
    <p class="form__title">Datos Personales</p>
    <p class="text--gray"><small>* Campos obligatorios</small></p>
    <div class="input-field">
      <label class="label--black" for="tipoCedula">Tipo de identificación<small class="text--gray">*</small></label>
      <div class="select">
          {{ form_widget(form.tipoCedula, {"attr":{"class":"js-select change_identification_type", "required":"required"}}) }}
      </div>
    </div>
    <div class="input-field">
      <label class="label--black" for="cedula">Identificación<small class="text--gray">*</small></label>
        {{ form_widget(form.cedula, {attr: {"class": "input identification", "data-parent": form.tipoCedula.vars.id}}) }}
    </div>
    <div class="input-field">
      <label class="label--black" for="first_name">Nombre<small class="text--gray">*</small></label>
      {{ form_widget(form.first_name, {attr: {"class": "input", "placeholder": "Juan"}}) }}
    </div>
    <div class="input-field">
      <label class="label--black" for="last_name">Apellidos<small class="text--gray">*</small> </label>
        {{ form_widget(form.last_name, {attr: {"class": "input", "required":"required", "placeholder": "Rodríguez"}}) }}
    </div>
  </div>
  <div class="test-drive-slide">
    <p class="form__title">Contacto</p>
    <p class="text--gray"><small>* Campos obligatorios</small></p>
    <div class="input-field">
      <label class="label--black" for="email">Correo Electrónico<small class="text--gray">*</small> </label>
      {{ form_widget(form.email, {attr: {"class": "input", "placeholder":"ejemplo@mail.com"}}) }}
    </div>
    <div class="input-field">
      <label class="label--black" for="mobile">Teléfono<small class="text--gray">*</small> </label>
      {{ form_widget(form.mobile, {attr: {"class": "input", "placeholder":"88888888"}}) }}
    </div>

    <div class="input-field">
      <label class="label--black" for="provincia">Provincia<small class="text--gray">*</small> </label>
      <div class="select">
          {{ form_widget(form.provincia, {"attr":{"required":"required", "data-target":form.canton.vars.id, "class":"js-select "~form.provincia.vars.attr.class|default("")}}) }}
      </div>
    </div>

    <div class="input-field">
      <label class="label--black" for="canton">Cantón<small class="text--gray">*</small> </label>
      <div class="select">
          {{ form_widget(form.canton, {"attr":{"required":"required","data-target":form.distrito.vars.id, "class":"js-select "~form.canton.vars.attr.class |default("")}}) }}
      </div>
    </div>

    <div class="input-field">
      <label class="label--black" for="distrito">Distrito<small class="text--gray">*</small> </label>
      <div class="select">
          {{ form_widget(form.distrito, {"attr":{"required":"required","class":"js-select "~form.distrito.vars.attr.class|default("")}}) }}
      </div>
    </div>

    <div class="input-field">
      <label class="label--black" for="direccion">Dirección<small class="text--gray">*</small> </label>
      {{ form_widget(form.direccion, {attr: {"class": "input", "placeholder": "Urbanización o Barrio"}}) }}
    </div>

   
    <div class="input-field">
      <label class="label--black" id="comment-label">Detalle </label>
      <textarea class="textarea length-text-area" aria-labelledby="comment-label" placeholder="Describe tu duda o consulta" id="{{ field_id(form, 'comment') }}" name="{{ field_name(form, 'comment') }}" >{{ aditionalValues["comment"] | default("") }}</textarea>
    </div>
  </div>
   <div class="test-drive-slide">
    <p class="form__title">Sucursal</p>
    <p class="text--gray"><small>Selecciona la Sucursal en la que le gustaría realizar su TestDrive</small></p>
    <div class="input-field">
      {#<p class="text--gray"><small>* Obligatorio</small></p>#}
        {{ form_widget(form.sucursal, {"attr":{}}) }}
    </div>
  </div>
  <div class="test-drive-slide">
    <p class="form__title">Confirmar</p>
    <p>Confirme los datos ingresados<p>
    <div class="row">
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Modelo:</label>
          <p class="input">{{ model.name }}</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Identificación: </label>
          <p class="input"><span data-info-conf="cedula"></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Nombre completo:</label>
          <p class="input"><span data-info-conf="first_name"></span> <span data-info-conf="last_name"></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Email:</label>
          <p class="input"><span data-info-conf="email"></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Teléfono: </label>
          <p class="input"><span data-info-conf="mobile"></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Dirección: </label>
          <p class="input"><span data-info-conf="provincia"></span>, <span data-info-conf="canton"></span>, <span data-info-conf="distrito"></span>, <span data-info-conf="direccion"></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Detalles: </label>
          <p class="input"><span data-info-conf="comment">&nbsp;</span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="input-wrap">
          <label>Sucursal: </label>
          <p class="input"><span data-info-conf="sucursal"></span></p>
        </div>
      </div>
    </div>

    <div class="form__terms">
      Ver <a href="/article/terminos-condiciones" target="_blank">Términos y Condiciones</a>
    </div>
{#    <div class="input-field">#}
{#      <input id="autorizo_envio" name="autorizo_envio" type="checkbox" value="1" checked="" class="checkbox" required="required">#}
{#      <label for="autorizo_envio">Autorizo a Grupo Purdy al envío de información de sus productos y la utilización de mis datos de contacto.</label>#}
{#    </div>#}
    {% include "LumenAppBundle:Default/partials:_checkbox-consentimiento-informado.html.twig" %}
    {% if captcha is defined and show_captcha == "true" %}
      {% include "@LumenApp/Default/partials/_form-captcha-field.html.twig" %}
    {% endif %}
  </div>
</div>






{% for repuestoT in repuestos %}
    <div class="col-sm-6">
        <a href="{{ path('repuesto', {'alias': repuestoT.alias}) }}" class="calculate-card repuestos-card">
            <div class="calculate-card-content"> 
                <img src="{{repuestoT.previewImage}}" alt="Car" class="calculate-card-img">
                <div class="calculate-card-text">
                    <h4 class="title"> 
                        {{repuestoT.title}}
                    </h4>
                </div>
            </div>
            <div class="text-center">
                <span class="text--primary">Ver más <i class="icon icon-plus"></i></span>
            </div>
        </a>
    </div>
{% endfor %}

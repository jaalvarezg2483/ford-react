<div class="menu--mock">
   
    <ul class="tabs tabs-gray-fc">
        {% for type in categories  %}
        <li class="tab {% if loop.index == 1 %} active {% endif %}"><a href="#folleto{{ loop.index }}" data-toggle="tab">{{ type.name }}</a></li>
        {% endfor %}
    </ul>
    <ul class="collapsible tab-content">
        {% for type in categories  %}
        <li class="tab-pane fade {% if loop.index == 1 %} in active {% endif %}" id="folleto{{ loop.index }}">
           
            <div class="collapsible__body container-fluid">
                <div class="row row--flex">
                {% for family in type.families2 %}
                    <div class="{% if columns is defined and columns == 3 %} col-sm-4 {% else %} col-sm-6 {% endif %}">
                        <a href="{{  path(routePath | default('accessory-select'), {"slug" : family.slug}) }}" class="calculate-card calculate-card-link">
                            <div class="calculate-card-content">
                                <img src="{{ family.getWebPath() ? server_url ~ '/' ~ family.getWebPath()  : '/img/content/yaris-small.png' }}" alt="Car" class="calculate-card-img">
                                <div class="calculate-card-text">
                                    <h4 class="title">
                                        {{ family.name }}
                                    </h4>
                                    {% if family.hidePrice is defined and not family.hidePrice %}
                                        <p>Desde</p>
                                        <h4 class="title">
                                            ${{ family.startPrice | number_format(0, ',', '.') }}
                                        </h4>
                                    {% else %}
                                        {% if family.comingSoon is defined and family.comingSoon %}
                                            <h4 class="title">
                                                Coming Soon
                                            </h4>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
                </div>
            </div>
        </li>
        {% endfor %}
    </ul>
</div>
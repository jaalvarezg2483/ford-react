{% block body %}
{% include '@LumenCMS/MenuTemplates/script-select-menu.html.twig' with {'searchMenu': 'Calcular Financiamiento'} %}


<div class="calculate--header">
	<div class="calculate--cancel bg--accent-light">
		<a class="btn btn--clear" href="{{  path('model_list', {"slug" : current.slug}) }}"><i class="icon icon-arrow-left"></i> Cancelar</a>
	</div>
	<div class="text-center margin--top">
		<h2 class="title">Calcular Financiamiento</h2>
	</div>
	<div class="calculate-nav">
		<div class="calculate-nav-item current"><a href="{{ path('calculate_select_model', {'slug': current.slug }) }}" class="calculate-nav-btn">1</a><span>Vehículo</span></div>
		<div class="calculate-nav-item current"><a href="javascript:void()" class="calculate-nav-btn">2</a><span>Adicionales</span></div>
		<div class="calculate-nav-item"><a href="{{ path('calculate-step5', {'slug':current.slug, 'code': model.code}) }}" class="calculate-nav-btn">3</a><span>Resumen</span></div>
	</div>
</div>
<div class="calculate--top container">
	<div class="row">
		<div class="input-field col-md-6 select-cars select">
			<select class="js-select change_model">
				{% for modelSelect in modelos %}
					<option {{ model.id == modelSelect.id ? "disabled selected" : "" }} value="{{ modelSelect.code }}">{{ modelSelect.name }}</option>
				{% endfor %}
			</select>
		</div>
	</div>
	<div class="row">
		<p class="padding-1">Acá podés agregar los accesorios para tu vehículo o bien, saltarte este paso</p>
	</div>
</div>
	<div class="wrapper-calculate wrapper-calculate-step-2">
		<div class="container">
			<ul class="tabs" role="tablist">
				<li class="tab active"><a href="#accesorios" role="tab" data-toggle="tab">Accesorios</a></li>
				<li class="tab"><a href="#mantenimiento" role="tab" data-toggle="tab">Plan de mantenimiento</a></li>
{#				<li class="tab"><a href="#seguro" role="tab" data-toggle="tab">Seguro</a></li>#}
			</ul>
		</div>
		<section class="container container-calculate">
			<div class="row sticky-parent">
			<div class="tab-content col-md-8">
				<div role="tabpanel" class="tab-pane active clearfix" id="accesorios">

						<div class="row content-accesories-car accessories_wdg">
							{% if modelAccesories | length > 0 %}
								{% for accessory in modelAccesories %}
									<section class="col-md-6">
										<div class="card-accesories card-filter {{ in_array(accessory.id, accessoriesSelected) ? "ele-checked" : ""}}" data-category="#category-{{accessory.accesoryType.id}}" data-card="#accesory{{ accessory.id }}">
											<div class="card-accesories-img">
												<img src="{{ server_url ~ "/" ~ accessory.getWebPath() }}">
											</div>
											<div class="card-accesories-content">
												<div>
													<p class="js-name accessory-name">{{ accessory.name }}</p>
													<p class="text--bold">${{ accessory.price | number_format(0, ".", ",")}}</p>
													{% if accessory.detail != "" and accessory.detail != " " %}
														<a class="text--primary btn-modal-acc"
															href="#modal-accesory"
															data-toggle="modal"
															data-title="{{ accessory.name }}"
															data-description="{{accessory.detail}}"
															data-btn="#accesory{{ accessory.id }}"
															data-img="{{ server_url ~ "/" ~ accessory.getWebPath() }}"
															data-is-checked="{{ in_array(accessory.id, accessoriesSelected) ? 'is-checked' : 'not-checked' }}"
															data-price="{{ accessory.price | number_format(0, ".", ",")}}"
															>Ver detalle</a>
													{% endif %}
												</div>
												<div class="add-accesory">

													<input value="{{ accessory.id }}" type="checkbox" class="checkbox control-resume" id="accesory{{ accessory.id }}" {{ in_array(accessory.id, accessoriesSelected) ? 'checked="checked"' : "" }} data-type="accesory" data-price="{{ accessory.price }}" data-name="{{ accessory.name }}" data-id="{{ accessory.id }}"/>
													<label for="accesory{{ accessory.id }}"></label>
												</div>
											</div>
										</div>
									</section>
								{% endfor %}
                            {% else %}
								<div class="col-xs-12 ">
									<div>
										<div class="card-stacked">
											<div class="card-content">
												<h6></h6>
												<span>Este modelo no cuenta con ningún accesorio disponible en este momento, por favor pasá al siguiente paso.</span>
											</div>
										</div>
									</div>
								</div>
                            {% endif %}
						</div>
					</div>
				<div role="tabpanel" class="tab-pane clearfix" id="mantenimiento">
					{#Mantenimiento#}
					<div class="row content-accesories-car accessories_wdg">
						{% if maintenances | length > 0 %}
							{% for maintenance in maintenances %}
								<div class="col-md-6">
									<div class="card-collapse card-accesories {{ in_array(maintenance.id, maintenancesSelected) ? "ele-checked" : "" }}" data-id="{{ maintenance.id }}"  data-card="#maintenance{{ maintenance.id }}">
										<div class="add-accesory">
										
											<input value="{{ maintenance.id }}" type="checkbox" class="checkbox control-resume only-one" id="maintenance{{ maintenance.id }}" {{ in_array(maintenance.id, maintenancesSelected) ? 'checked="checked"' : "" }} data-type="maintenance" data-price="{{ maintenance.price }}" data-name="{{ maintenance.tittle }}" data-id="maintenance-{{ maintenance.id }}"/>
											<label for="maintenance{{ maintenance.id }}"></label>
										</div>
										<div class="card-accesories-content">
											<button type="button" class="js-collapse-next">
												{{ maintenance.tittle }} desde ${{ maintenance.price | number_format(0, ".", ",")}} <i class="icon icon-chevron-down"></i>
											</button>
											<div class="collapsible__body">
												<ul class="card-services-list row">
													{% for service in maintenance.items %}
														<li>{{ service.text }}</li>
													{% endfor %}
												</ul>
											</div>
										</div>
									</div>
								</div>
							{% endfor %}
						{% else %}
							<div class="col-xs-12 ">
								<div>
									<div class="card-stacked">
										<div class="card-content">
											<h6></h6>
											<span>Este modelo no cuenta con ningún mantenimiento disponible en este momento, por favor pasá al siguiente paso.</span>
										</div>
									</div>
								</div>
							</div>
						{% endif %}
					</div>
				</div>

<div class="modal fade" id="modal-accesory">
	<div class="modal-dialog" role="document">
    	<div class="content-accesories-car content-cards-car">		
			<div class="card-accesories-modal">
				<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>
				<div class="card-accesories-img">
					<img id="modal-acc-img" src="">
				</div>
				<div class="modal-accesories-content">
					<p><strong id="modal-acc-title"></strong></p>
					<h3 id="modal-acc-price" class="text--bold text--primary"></h3>
					<p class="modal-accesories-description" id="modal-acc-description"></p>

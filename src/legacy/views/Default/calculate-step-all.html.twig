			</div>

			<div class="accesories-resume col-md-4">
				<button type="button" class="js-collapse-next hidden-md">
					<span id="total-selected">Adicionales <strong>({{ quantity }})</strong></span>
					<span id="total">Total <strong>${{ price }}</strong></span><i class="mdi mdi-chevron-down"></i>
				</button>
				<div class="collapsible__body">
					<h3 class="title hidden-xs">Mi selección</h3>
					<hr>
					<ul class="accessory-list" id="resume">
						
						<div class="accesory-list-empty text-center
							{% if accessoriesSelected|length > 0 or  maintenancesSelected|length > 0 and insurancesSelected|length > 0 %} hidden {% endif %}">
							<i class="mdi mdi-alert-circle-outline mdi-36px"></i>
							<p>No tienes artículos seleccionados</p>
						</div>
						
						{% for id, accesory in accessoriesSelected %}
							<li class='detail' data-type='accesory' data-price='{{ accesory["price"] }}' data-id='accesory{{ id }}'><span>{{ accesory["name"] }}</span> <span><strong>${{ accesory["price"] }}</strong> <a href='#' class='remove-detail'><span class='icon icon-close'></span></a></span></li>

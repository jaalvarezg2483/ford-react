{% extends "base.html.twig"%}
{% block title %}Renovar Auto Renting{% endblock %}

{% block body %}

    <div class="wrapper">
        <div class="container container--breadcrumb">
            <ol class="breadcrumb steps--backbot">
            <li><a href="javascript:history.back()"><i class="icon icon-arrow-left breadcrumb-back"></i></a></li>
            <li><a href="javascript:history.back()"> Atrás</a></li>
            <li>Renting</li>
        </ol>
        </div>
        <div class="container container--full-mobile">
            <h1 class="title text-center">{{ title }}</h1>
            <div class="card card--form">
                <form action="{{ path("save_contactus", {slug: family.slug, code: model.code, type: "renting-renovar" }) }} " method="post">
                    <div class="card__content bg--gray">
                        <div class="container">
                            <p><strong>Categoría: {{ type|capitalize  }}</strong></p>
                            <p><strong>ME INTERESA EL VEHÍCULO:</strong></p>
                            <p class="quotation__model">
                                <span>{{ family.name }}</span>
                                {% if hino == false %}
                                    {{ model.name }}
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="card__content">
                        <div class="container">
                            {% include 'LumenAppBundle:Default/partials:_form-fields.html.twig' with {'renting':"true", 'renovar':"true"} %}

                            <input type="text" hidden name="tipo" value="{{ type | capitalize }}">

                        </div>
                    </div>
                    {{ form_rest(form) }}
                </form>
            </div>
        </div>
    </div>

{% endblock %}

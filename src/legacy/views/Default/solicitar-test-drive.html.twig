{% extends "base.html.twig" %}
{% block title %}Solicitar Test Drive{% endblock %}

{% block body %}

<div class="wrapper">
  <div class="container container--breadcrumb">
    <a href="{{ path('home') }}" class="btn--back"><span class="icon icon-arrow-left"></span>Volver al <strong>inicio</strong></a>
  </div>
  <div class="section">
    <div class="container">
      <h1 class="title text-center">Solicitar Test Drive</h1>
    </div>
    <div class="container container--full-mobile">
      <div class="card card--form">
        <form action="{{ path('solicitar_test_drive') }}" class="form verify-captcha" id="contactForm" novalidate method="post">
          {% set aditionalValues = form.vars.value.aditionalFields | default([]) %}
          <div class="card__content">
            <div class="container">
              {{ form_errors(form) }}
              <p class="text--gray"><small>* Campos obligatorios</small></p>
              <div class="input-field">
                <label class="label--black" for="{{ form.first_name.vars.id }}"><small class="text--primary">*</small> Primer nombre</label>
                {{ form_widget(form.first_name) }}
                {{ form_errors(form.first_name) }}
              </div>
              <div class="input-field">
                <label class="label--black" for="{{ form.last_name.vars.id }}"><small class="text--primary">*</small> Apellido</label>
                {{ form_widget(form.last_name) }}
                {{ form_errors(form.last_name) }}
              </div>
              <div class="input-field">
                <label class="label--black" for="{{ form.email.vars.id }}"><small class="text--primary">*</small> Correo electrónico</label>
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
              </div>
              <div class="input-field">
                <label class="label--black" for="{{ form.mobile.vars.id }}"><small class="text--primary">*</small> Teléfono</label>
                {{ form_widget(form.mobile) }}
                {{ form_errors(form.mobile) }}
              </div>
              <div class="input-field">
                <label class="label--black" for="{{ form.modelo.vars.id }}"><small class="text--primary">*</small> Modelo</label>
                <div class="select">
                  {{ form_widget(form.modelo) }}
                </div>
                {{ form_errors(form.modelo) }}
              </div>
              <div class="input-field">
                <label class="label--black" for="{{ form.sucursal.vars.id }}"><small class="text--primary">*</small> Sede</label>
                <div class="select">
                  {{ form_widget(form.sucursal) }}
                </div>
                {{ form_errors(form.sucursal) }}
              </div>
              <div class="form__terms">
                Ver <a href="/article/terminos-condiciones" target="_blank">Términos y Condiciones</a>
              </div>
              {% include "@LumenApp/Default/partials/_checkbox-consentimiento-informado.html.twig" %}
              {% if captcha is defined and (show_captcha == "true" or show_captcha == true) %}
                {% include "@LumenApp/Default/partials/_form-captcha-field.html.twig" %}
              {% endif %}
              <div class="center">
                <button id="send-button" type="submit" name="button" class="btn btn--primary btn--wider">Enviar solicitud</button>
              </div>
            </div>
          </div>
          {{ form_rest(form) }}
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}

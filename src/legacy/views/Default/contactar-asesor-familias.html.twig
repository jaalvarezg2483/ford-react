{% extends "base.html.twig"%}
{% block title %}Contactar asesor de ventas{% endblock %}

{% block body %}

<div class="wrapper">
  <div class="container container--breadcrumb">
    <a href="javascript:void(0)" class="btn--back"><span class="icon icon-arrow-left"></span>Volver</a>
  </div>
  <div class="section">
    <div class="container">
      <h1 class="title text-center">Contactar asesor de ventas y enviar cotización al correo</h1>
    </div>
    <div class="container container--full-mobile">
      <div class="card card--form">
        <form action="{{ wtlead_path }}" method="post" class="pre_submit verify-captcha" novalidate>
          <script id="ajax_path">
              var savePath = '{{ path("save_contactus_families", {type: app.request.get("_route")}) }}';
          </script>
          <input type="hidden" name="oid" value="{{ wtlead_oid }}">
          <input type="hidden" name="lead_source" value="Sitio Web">
          <input type="hidden" name="rating" value="Neutro">
          <input type="hidden" id="retURL" name="retURL" value="{{ server_url~path("thanks_route_family", {"route_name": app.request.get("_route"),
              "family": family.slug}) }}">
          <input type="hidden" name="debug" value="0">
          <input type="hidden" name="debugEmail" value="{{wtlead_debug_email}}">
          <input type="hidden" name="{{ wtlead_marca }}" value="{{ family.familyBrand.code }}" id="wtl_marca"/>
          <input type="hidden" name="{{ wtlead_familia }}" value="{{ model.familySalesForce.name }}" id="wtl_familia"/>
          <input type="hidden" name="{{ wtlead_modelo }}" value="{{ model.categorySalesForce }}" id="wtl_modelo"/>
          <input type="hidden" name="model" id="model" required value="{{ model.id }}">
          <div class="card__content bg--gray">
            <div class="container">
              <p class="form__title">ME INTERESA EL VEHÍCULO:</p>
              <div class="quotation__model">
                <div class="select">
                  <select id="family" name="family" class="js-select" required>
                      {% for family in families %}
                        <option data-brand-code="{{ family.familyBrand.code }}" value="{{ family.id }}">{{ family.name }}</option>
                      {% endfor %}
                  </select>
                </div>
              </div>
            </div>
          </div>
          <div class="card__content">
            <div class="container">
              {% include 'LumenAppBundle:Default/partials:_form-fields.html.twig' with {'captcha':true, 'captcha':true, "cedula": true, "consentimiento": true, "seguimiento": true, "hiddenSeguimiento": true} %}
            </div>
          </div>
            {{ form_rest(form) }}
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
  $("#family").on("change", function () {
      var option = $(this).find(':selected');
      $("#wtl_marca").val(option.attr("data-brand-code"));
      $("#send-button").css("display","none");
      $("#wtl_familia").val("");
      $("#wtl_modelo").val("");
      ajaxCall($(this).val());

  })

  function ajaxCall(id){
      $.ajax({
          method: "GET",
          url: "/ajax/getModels-by-family/" + id + "?inverse=true",
      }).done(function (model) {
          var html = "";
          $("#wtl_familia").val(model.wtl_familia);
          $("#wtl_modelo").val(model.wtl_modelo);
          $("#model").val(model.id);
          $("#retURL").val(model.thanks);

          $("#send-button").css("display","block");
      });
  }

  $('form').bind("keypress", function(e) {
      if (e.keyCode == 13) {
          e.preventDefault();
          return false;
      }
  });
</script>
{% endblock %}

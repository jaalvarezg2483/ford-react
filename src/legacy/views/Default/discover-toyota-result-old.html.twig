{% extends "base.html.twig"%}
{% block title %}Descubrir Toyota{% endblock %}

{% block stylesheet %}
	<link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/9.2.0/nouislider.min.css" rel="stylesheet">
{% endblock %}
{% block body %}
	<div class="wrapper">
		<div class="container container--breadcrumb">
			<ol class="breadcrumb">
				<li><i class="icon icon-arrow-left breadcrumb-back"></i></li><li><a href="{{path('index')}}">Inicio</a></li><li><a href="{{path('discover-toyota')}}">Descubrir Mi Toyota</a></li><li>Resultados</li>
			</ol>
		</div>
		<section class="container">
			<h4 class="title text-center">Descubrir Mi Toyota</h4>
			<p class="text--large">Resultados <strong>({{ results | length }})</strong></p>
			<div class="row clearfix chips-discover-result">
				<form action="{{ path("discover-toyota-result") }}" method="post">
					<input type="hidden" name="alter" value="1" />
                    {% set route = app.request.attributes.get('_route') %}
                    {% for name,filter in form.children if (name != '_token') and (filter.vars.value != '') %}
                        {#{% if name != "hibrido" or  (true == filter.vars.checked ) %}#}
						<div class="chip">{{ filter.vars.label }} : {{ name == 'hibrido' ? 'Sí' : filter.vars.value | replace({"," :" - "})}}
                            {{ form_widget(attribute(form, name)) }}
							<a class="act_remove_chip" >
								<i class="mdi mdi-close"></i>
							</a>
						</div>
                        {#{% endif %}#}
                    {% endfor %}
                    {{ form_rest(form) }}
				</form>
			</div>
            {% for result in results | batch(4) %}
				<div class="row">
                    {% for model in result %}
						<div class="col-md-3 family-wrap">
							<a href="{{ path("model_list", {"slug": model.family.slug}) }}">
								<div class="family">
									<div class="family__img">
										<img src="{{ server_url ~ "/" ~ model.getWebPath() }}" alt="{{ model.name }}" class="img-responsive">
									</div>
									<div class="family__text">
										<h2>
                                            {{ model.name }}
                                            {{model.hybrid == true ? '<span class="mdi mdi-leaf"></span>' : ''}}
										</h2>
                                        {% if model.startPrice > 0 %}
											<p class="family__cta-price">Desde <span>${{ model.startPrice | number_format(0, ',', '.') }}</span></p>
                                        {% endif %}
									</div>
								</div>
							</a>
						</div>
                    {% endfor %}
				</div>

            {% endfor %}

		</section>

	</div>

{% endblock %}

{% block scripts %}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/9.2.0/nouislider.min.js"></script>
	<script>
        var slider = $('.range');
        noUiSlider.create(slider, {
            start: [20, 80],
            connect: true,
            step: 1,
            range: {
                'min': 0,
                'max': 100
            }
            // format: wNumb({
            // 	decimals: 0
            // })
        });

	</script>
{% endblock %}
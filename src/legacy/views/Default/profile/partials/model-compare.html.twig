<div class="specs-compare-header container">
    <h3 class="title">Comparar Modelos</h3>
    {%  for datasheet in family.dataSheets %}
        <div class="margin--top">
            <a class="btn btn--clear" href="{{ path("download_datasheet", {"id": datasheet.id, "path" : datasheet.path}) }}" target="_blank">Descargar ficha <i class="icon icon-download"></i></a>
            {% if family.dataSheets | length > 1 %}
            <p><small>{{datasheet.description}}</small></p>
            {% endif %}
        </div>
     {% endfor %}
    <div class="margin--top">
        {% if request_models | length > 1 %}
            <input id="show_difference" type="checkbox" name="show_difference" {% if request_difference == true %} checked {% endif %} class="checkbox show_difference"><label for="show_difference">Mostrar únicamente diferencias</label>
        {% endif %}
    </div>


</div>

<div>
    <div class="select-clone" id="hide-select">
        <td>
            <div>
                <select  name="models[]" hidden>
                    <option value="">Selecciona un modelo</option>
                    {% for model in models %}
                        <option value="{{ model.id }}">{{ model.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </td>
    </div>
    <form method="get" id="search-form">
        <input name="show_difference" type="checkbox" hidden class="show_difference">
        <div class="specs-model-filters">

        <table class="specs-table specs-filters">
            <tbody>
                <tr class="mobile-flex-row cols-{{ request_models | length + 2 }}" id="selects">
                    <td class="desktop-only">

                    </td>
                    {% if request_models | length > 0 %}
                        {% for model_id in request_models %}
                        <td>
                            <div class="select-wrap-specs {% if loop.index > 2  %}hidden-mobile{% endif %}">
                                <select class="models-select" name="models[]" id="model-{{ model_id }}">
                                    {% for model in models %}
                                        {% if model.id == model_id %}
                                            <option selected value="{{ model.id }}">{{ model.name }}</option>
                                        {% elseif model.id not in request_models %}
                                            <option value="{{ model.id }}">{{ model.name }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            {% if loop.index > 1 %}
                                <a class="remove-model" data-id="{{ model_id }}">Eliminar <i class="icon icon-close"></i></a>
                            {% endif %}
                            </div>
                        {% endfor %}
                        </td>
                    {% endif %}
                        {% if models | length > 1 and models | length > request_models | length and request_models | length < 4 %}
                            <td id="add-cell" class="{% if request_models | length > 1  %}hidden-mobile{% endif %}">
                                <a id="add-model" class="btn btn--primary">Agregar otro vehículo</a>
                            </td>
                        {% endif %}
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</div>

<div class="spec-table-container">
    <div class="container container--full">
    {% for category in categories['titles'] %}
            <h3 class="title margin--bottom">{{category}}</h3>
            <table class="specs-table">
                <tbody>
                {% for feature in categories['features'][category] %}
                    {% if request_models | length > 1 %}
                    <tr class="mobile-only">
                        <td colspan='2'><p>{{ feature.name }}</p></td>
                    </tr>
                    {% endif %}
                    <tr class="cols-{{ request_models | length + 2 }}">
                        <td class="td-left td-title {% if request_models | length > 1 %}desktop-only{% endif %}">
                            <p>{{ feature.name }}</p>
                        </td>
                        {% for model_id in request_models %}
                            <td {% if loop.index > 2 %}class="desktop-only"{% endif %}>
                                {% if feature.hasModel(model_id) %}
                                    <i class="icon icon-ok text--primary"></i>
                                {% else %}
                                    <i class="icon icon-close text-50"></i>
                                {% endif %}
                            </td>
                        {% endfor %}
                        {% if models | length > 1 and models | length > request_models | length and request_models | length < 4 %}
                        <td class="desktop-only">
                            <i class="mdi mdi-minus text-50 mdi-24px"></i>
                        </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    {% endfor %}
    </div>
</div>
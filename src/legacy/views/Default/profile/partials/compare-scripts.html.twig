<script>
    var serverPath = '{{ server_url }}';

    $(document).ready(function(){
        $("body").on('change', '.models-select', function () {
            if ($(this).val() !== ""){
                showSpinner();
                $("#search-form").submit();
            }
        });

        $(".show_difference").on('change', function () {
            var checked = $(this).is(":checked");
            if (checked){
                $(".show_difference").attr("checked", true);
            }else{
                $(".show_difference").removeAttr("checked");
            }
            showSpinner();
            $("#search-form").submit();
        });

        $("#add-model").on('click', function (e) {
            e.preventDefault();
            $(this).addClass('disabled');
            // $(this).hide();
            //showSpinner();
            var select = $("#hide-select").clone();

            select.removeAttr('id');
            select.find('select').removeAttr('hidden');

            $(".models-select").each(function (index, element) {
                select.find("option[value='"+$(element).val()+"']").remove();
            });

            $(".models-select").find('option').not(':selected').remove();


            select.find('div').addClass('select-wrap-specs');
            select.find('select').addClass("models-select");
            select.css('display', 'table-cell');
            select.insertBefore('#add-cell');

            var modelsQuantity = select.find("option").length-1;
            if (modelsQuantity === 1){
                $(this).css("display", "none");
            }
            //$("#search-form").submit();
        });

        $(".remove-model").on('click', function (e) {
            e.preventDefault();
            showSpinner();
            var id = $(this).attr("data-id");
            $("#model-"+ id).parent().remove();
            $(this).remove();
            $("#search-form").submit();
        });

        try {
            var initialTop = $('.specs-model-filters').offset().top - 100;
        } catch (e) {
            // In case doesnt exist .specs-model-filters
        }

        setStickyFilters()

        $(window).scroll(function() {
            setStickyFilters();
        });

        function showSpinner() {
            $('.spinner').css('display', 'block');
        }

        function setStickyFilters(){
            try {

                var stickyheader = $('.specs-model-filters'),
                    scroll = $(window).scrollTop();

                if (scroll >= initialTop) stickyheader.addClass('is-sticky');
                else stickyheader.removeClass('is-sticky');
            } catch (e) {
                // In case compare is not showing
            }
        }

        $(".change_family").on('change', function () {
            window.location.href = "{{ path('precios-fichas-familia', {'slug': 'temporal'}) }}".replace("temporal", $(this).val());
        });
    })
</script>
{% extends "base.html.twig"%}

{% block title %} {{ family.name }} | Especificaciones {% endblock %}

{% block metaFace %}
	<meta property="og:title" content="{{ family.name }} | Especificaciones"/>
	<meta property="og:site_name" content="Ford"/>
	<meta property="og:description" content="{{ family.description }}"/>
	<meta property="og:type" content="website"/>
	<meta property="article:author" content="Ford" />
	<meta property="article:publisher" content="Ford" />
	<meta property="og:image" content="{{server_url ~ "/" ~ family.getWebPath()}}"/>
{% endblock %}

{% block customStyles %}
    {% if banner is not null %}
        <style>
            .car-profile-hero {
                background-image: url("{{ banner.imageMobile }}");
            }
            @media screen and (min-width: 768px){
                .car-profile-hero {
                    background-image: url("{{ banner.image }}");
                }
            }
        </style>
    {% endif %}
{% endblock %}


{% block body %}
	<div class="wrapper--car wrapper-car-specs">
		<div class="profile-back hidden-md">
			<a class="btn btn--clear" href="javascript:history.back()"><i class="icon icon-arrow-left"></i> Volver</a>
		</div>
		<div class="hero car-profile-hero">
			{% include 'LumenAppBundle:Default/CarsTemplate:_menu-inner.html.twig' with {page:'profile'} %}
		</div>
		 <section>
        <div class="car-profile-description container">
            <div class="car-profile-text">
                <h1 class="title"><span>{{ family.familyBrand.name }}</span> {{ family.name }}</h1>
                <h3 class="title">Especificaciones</h3>
            </div>
            <div class="car-profile-text">
                <p class="text">{{ family.description }}</p>
                {% if family.showCalculate == true %}
                    <a href="{{path('calculate_select_model', {slug: family.slug})}}" class="btn btn--primary"><i class="icon icon-calculator"></i> Calcular Financiamiento</a>
                {% endif %}
                {% if test_drive == true %}
					<a href="{{ path("car-test-drive", {"slug": family.slug}) }}" class="btn"><i class="icon icon-car-alt"></i> Solicitar Test Drive</a>
                {% endif %}
            </div>
        </div>
    </section>
 

	<div class="car-specs-details bg--accent-light">
        {% if baseModel.imageDataSheet != "/default.jpg" and baseModel.imageDataSheet != "default.jpg" %}
			<img class="car-specs-datasheet" src="{{ baseModel.imageDataSheet }}" alt="Ficha técnica {{ family.name }} {{ family.currentYear }}">
		{% endif %}
			<div class="specs-list-container">
				<h2 class="title margin--bottom">Datos Generales</h2>

                {% if baseModel.floorDistance != "" %}
					<p>Distancia libre al suelo: <strong>{{ baseModel.floorDistance }}</strong></p>
                {% endif %}
                {% if baseModel.weight != "" %}
					<p>Peso bruto: <strong>{{ baseModel.weight }}</strong></p>
                {% endif %}
			
				<ul class="car-specs-list margin--top js-equal-height-parent">
					{% if baseModel.tankCapacity %}
						<li class="js-equal-height"><i class="icon icon-gas"></i> Capacidad del tanque: {{ baseModel.tankCapacity }}</li>
					{% endif %}
					<li class="js-equal-height"><i class="icon icon-station"></i> Tipo de combustible: {{ baseModel.gas }}</li>
					{% if baseModel.motor %}
						<li class="js-equal-height"><i class="icon icon-motor"></i> Motor: {{ baseModel.motor }}</li>
					{% endif %}
					{% if baseModel.potencyHp %}
						<li class="js-equal-height"><i class="icon icon-tacometro"></i> Potencia Hp: {{ baseModel.potencyHp }}</li>
					{% endif %}
					<li class="js-equal-height"><i class="icon icon-users-group"></i> Pasajeros: {% if baseModel.passengersDisclaimer != "" %} {{ baseModel.passengersDisclaimer }} {% else %} {{ baseModel.pasajeros }} {% endif %}</li>
					{% if baseModel.tires %}
						<li class="js-equal-height"><i class="icon icon-wheel"></i> Llantas: {{ baseModel.tires }}</li>
					{% endif %}
					{% if baseModel.torque %}
						<li class="js-equal-height"><i class="icon icon-torque"></i> Torque: {{ baseModel.torque }}</li>
					{% endif %}
				</ul>
			</div>
		</div>

{#		{% include "@LumenApp/Default/profile/partials/model-compare.html.twig" %}#}

		<div class="text-center">
			{%  for datasheet in family.dataSheets %}
				<div class="margin--top">
					<a class="btn btn--clear" href="{{ path("download_datasheet", {"id": datasheet.id, "path" : datasheet.path}) }}" target="_blank">Descargar ficha <i class="icon icon-download"></i></a>
					{% if family.dataSheets | length > 1 %}
					<p><small>{{datasheet.description}}</small></p>
					{% endif %}
				</div>
       		 {% endfor %}
		</div>

	</div>

{% endblock %}

{% block scripts %}
	{% include "@LumenApp/Default/profile/partials/compare-scripts.html.twig" %}
{% endblock %}

		</ul>
		<div class="gallery__btn">
			<button type="button" class="btn btn--border-white js-gallery-more">Cargar más fotos</button>
		</div> #}

	</section>
	<section class="section scrollspy car__downloads" id="descargas">
		<div class="container">
			<div class="row">
				<div class="col-sm-4">
					<p class="subtitle">Descargas:</p>
				</div>
				<div class="col-sm-8">
					<div class="link--icon-container">
						{%  for datasheet in family.dataSheets %}
							<a class="link--icon" href="{{ "/" ~ datasheet.getWebPath() }}" target="_blank"> <i class="mdi mdi-download"></i> {{ datasheet.description | replace({"DESCARGAR": ""}) | trim }}</a>
						{% endfor %}
		                {% if (family.urlCatalog | default(false)) and (family.urlCatalog != ' ') %}
							<a class="link--icon" href="{{ family.urlCatalog }}" target="_blank"> <i class="mdi mdi-download"></i> Catálogo</a>
		                {% endif %}
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="section scrollspy text-center car__accesories" id="accesorios">
		<h2 class="title">Accesorios</h2>
		<div class="slider slider--cards js-slider-cards js-equal-height-parent">
			{% for accesory in baseModel.accessories %}
    		<div>
    			<div class="card">
    				<div class="card__image">
	              		<img src="{{ accesory.getFoto() ? (server_url ~ accesory.getFoto())| default('/img/content/card-img2.png') }}" alt="{{ accesory.name }}">
    	            </div>
    	            <div class="card__content js-equal-height">
	              		<h2 class="card__subtitle">{{ accesory.name }}</h2>
    	            </div>
    	            <div class="card__action">
	              		<p class="card__title text--red">$ {{ accesory.price }}</p>
    	            </div>
    			</div>
    		</div>
			{% endfor %}
    	</div>
	</section>
	<section class="section scrollspy text-center car__compare bg--gray" id="comparar">
		<form action="{{ path("comparador") }}" method="get">
		<div class="container">
			<h2 class="title">Comparar vehículo</h2>

            <div class="slider slider--cards slider--compare js-slider-compare">
                <div>
                    <button type="button" class="card compare__add">
						<div>
							<i class="mdi mdi-car"></i>
	                        <p class="subtitle">Agregar otro vehículo</p>
						</div>
                    </button>
                </div>
				{%  set vechile_agregar = array_rand(models, 2) %}
                {% for vehicle in  vechile_agregar%}
                    {% set model_picture = server_url ~ vehicle.getFoto() %}
                    {% set model_name = vehicle.name %}
                    {% set family_name = vehicle.family.name %}
                    {% set index = loop.index %}
                    {% set code = vehicle.code %}
                    {% set year = vehicle.year %}
                    {% set id = vehicle.id %}
                    {{ block("template_car") }}
                {% endfor %}

            </div>
			<a href="{{ path("comparador") }}" class="btn btn--black compare_submit">Comparar Ahora</a>
		</div>
		</form>
	</section>
    {% if 0 < (tePodriaGustar | length) %}
	<section class="section scrollspy text-center car__suggest">
		<h2 class="title">te podría gustar</h2>
		<div class="slider slider--model js-slider-model-car">
            {% for canLikeFamily in tePodriaGustar%}
				<div class="js-slider-model-inner">
					<a href="" class="slider__link">
						<img src="{{ server_url ~ canLikeFamily.getFoto3() }}" alt="{{ canLikeFamily.name }}">
						<h2>{{ canLikeFamily.name }}</h2>
						{% if canLikeFamily.slug != "camry" and canLikeFamily != "prius" %}
							<p>${{ canLikeFamily.startPrice | number_format(0,',', '.') }}</p>
						{% endif %}
					</a>
				</div>
            {% endfor %}
		</div>
	</section>
    {% endif %}
</div>

<div id="compare" class="modal fade modal--compare">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal__inner">
				<button type="button" class="modal__close" data-dismiss="modal"> <i class="mdi mdi-close"></i> </button>
				<h2 class="subtitle--large text-center">Seleccionar Vehículo</h2>
			</div>
			<div class="modal__inner bg--gray">
				<form action="" class="container">
					<p class="subtitle">Elegir vehículo</p>
					<div class="row">
						<div class="col-sm-6 select">
							<select name="family" id="compare_family" data-target="compare_model" data-repo="familyModel" class="js-select">
								<option value="">Seleccione una familia</option>
                                {% for family in familyList %}
									<option value="{{ family.id }}">{{ family.name }}</option>
                                {% endfor %}
							</select>
						</div>
						<div class="col-sm-6 select">
							<select name="model" id="compare_model" class="js-select" data-index="models" data-text="name">
								<option value="">Debe seleccionar primero una Familia</option>
							</select>
						</div>
					</div>
					<div class="text-center">
						<button type="button" class="btn btn--border-black vehicle_click">Elegir Vehículo</button>
					</div>
				</form>
			</div>
		    <div class="modal__inner">
		        <h2 class="subtitle--large text-center">Otros modelos relacionados</h2>
		    </div>
			<div class="modal__inner">
				<div class="container">
					<div class="row row--flex">
                        {% for vehicle in array_rand(models, 4, true, vechile_agregar) %}
							<div class="col-sm-3">
								<input type="radio" class="radio radio--large car__select" id="car{{ loop.index }}" name="car" value="{{ vehicle.id }}" data-family="{{ vehicle.family.id }}">
								<label for="car{{ loop.index }}" class="family">
									<div class="family__img">
		                                <img src="{{ server_url ~ vehicle.getFoto() }}" alt="{{ vehicle.name }}" class="img-responsive">
		                            </div>
									<div class="family__text">
										<h2>{{ vehicle.name }}</h2>
										<p class="family__cta-price">desde <span>$ {{ vehicle.startPrice | number_format(0, ',', '.')}} </span></p>
									</div>
									<p class="check">Elegir</p>
								</label>
							</div>
                        {% endfor %}

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}

{% block scripts %}
	<script>
        var serverPath = '{{ server_url }}';
		scrollspy( $('#carMenu') );
	</script>
{% endblock %}

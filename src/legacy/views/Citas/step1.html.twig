{% extends "base.html.twig"%}
{% block title %}Citas Ford{% endblock %}
{% block stylesheet %}
    <link href="/css/citas.css?v={{ assetsVersion }}" rel="stylesheet">
{% endblock %}

{% set activeStep = 1 %}


{% block body %}
    <div class="wrapper load-step-1">
        {# {% include 'LumenAppBundle:Citas/partials:_nav.html.twig' %}
        <div class="navigation" data-action="navigation">
            <i class="mdi mdi-chevron-left"></i>
            <a class="navigation__back evt_prev_step {% if app.request.get('_route') != 'citas' %} md-hidden {% endif %}">Volver al <strong>Inicio de Citas</strong></a> 
        </div>         #}
        <div class="padding-1 bg--accent-light">
            <div class="container">
                <a class="text--primary text--bold" href="{{  path('citas') }}"><i class="icon icon-arrow-left"></i> Volver</a>
            </div>
        </div>
        <div class="container margin--top separador_steps">
            <h1 class="titulo_agendar text-center">Agendar cita de mantenimiento</h1>
        </div>
        {% include 'LumenAppBundle:Citas/partials:_steps.html.twig' with {
        'activeStep' : activeStep } only %}

       <section class="citas-select">
            <p class="title">Hola {{ fullName | default("") }}</p>
            {% if vehicles | length > 1 %}
                <p class="change-text-many-cars">Seleccioná el <span>auto</span> y confirmá el <span>kilometraje</span>:</p>
            {% else %}
                <p class="change-text-many-cars">Confirmá el <span>kilometraje</span> actual de tu <span>auto</span>:</p>
            {% endif %}
            {% if vehicles|length > 2 %}
            {% set isMoreThanTwo = true %}
            {% else %}
            {% set isMoreThanTwo = false %}
            {% endif %}
            <form class="cards-select-vehicle insert-cars {{ isMoreThanTwo ? 'gridContainer' : 'flexContainer' }}">
                {% for vehicle in vehicles %}
                
                <div class="grid-box">
                    <div class="select-card" id="card{{ loop.index }}">
                            <a class="delete-car" data-tooltip="Desvincular vehículo">DESVINCULAR VEHICULO <i class="mdi mdi-window-close"></i></a>
                            <div class="model__plate-container">
                                <span class="modelcar" data-model="{{ vehicle["Modelo"] | replace({',': ' ', '-': ' '}) }}">{{ vehicle["Modelo"] | replace({',': ' ', '-': ' '}) }}</span>
                                <span class="plate" data-plate="{{ vehicle["Placa"] }}">Placa: {{ vehicle["Placa"] }}</span>
                            </div>
                            <span class="plate hidden-object" data-plate="{{ vehicle["Placa"] }}">Placa: {{ vehicle["Placa"] }}</span>
                            <div id="mileage{{ loop.index }}" class="mileage hidden-object">
                                <span>Ingresá el kilometraje de tu vehículo</span>
                                <input placeholder="Kilometraje actual" type="number" {% if debug %}value="{{ vehicle["Odometro"] }}"{% endif %}>
                                <span class="km-mask">km</span>
                            </div>

                            {% if vehicle["Citas_Activas"] is not null %}
                                {% set appointment = vehicle["Citas_Activas"] %}
                                <div id="active-appointment-{{ vehicle["Placa"] | default("") }}" class="active-appointment">
                                    {% include "@LumenApp/Citas/partials/_appointment-info.html.twig" %}
                                </div>
                            {% endif %}

{#                            <a id="simulated-radio-button-container-{{ loop.index }}" class="selection-car" {% if vehicle["Citas_Activas"] is not null %} style="visibility: hidden;" {% endif %}>#}
                            <a id="simulated-radio-button-container-{{ loop.index }}" class="selection-car">
                                <div id="step-one-simulated-radio-button-{{ loop.index }}" data-plate="{{ vehicle["Placa"] | default("") }}" card="card{{ loop.index }}" class="step-one-simulated-radio-button {% if vehicle["Citas_Activas"] is not null %}active-appointment{% endif %}" mileage="mileage{{ loop.index }}" radioContainer="simulated-radio-button-container-{{ loop.index }}"></div>
                                <p class="step-one-simulated-radio-button-text">SELECCIONAR</p>
                            </a>
                    </div>
                </div>
                {% endfor %}
            </form>
            <div class="main-option-buttons">
                <div class="btns-steps text-center">
                    <a class="btn__cancelar_cita" href="{{  path('citas') }}">Anterior</a>
                    <a id="continue-button" href="#" class="btn__continuar_cita btn--ford btn-step1">Continuar</a>
                </div>
            </div>
       </section>

        {# {% include 'LumenAppBundle:Citas/partials:_subfooter.html.twig' %} #}
        {% include 'LumenAppBundle:Citas/partials:_modal.html.twig' %}
    </div>
{% endblock %}
{% block scripts %}
    <script src="/js/dependencies/jstorage.min.js"></script>
    <script src="/js/citas/citas.min.js?v={{ assetsVersion }}"></script>
    {% include 'LumenAppBundle:Citas/partials:_maintenance_modal.html.twig' %}
{% endblock %}

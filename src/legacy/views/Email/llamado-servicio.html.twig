<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
    <head>
        <title>Purdy Accesorios - Contacto</title>
        <style>
            a:link {
                color:#046380;
                text-decoration:underline;
            }
            a:visited {
                color:#A7A37E;
                text-decoration:none;
            }
            a:hover {
                color:#002F2F;
                text-decoration:underline;
            }
            a:active {
                color:#046380;
                text-decoration:none;
            }
        </style>
    </head>
    <body>
        <table align="center" width="600" style="border: #666666 1px solid;" cellpadding="0" cellspacing="0">
            <tr>
                <td bgcolor="#efefef" style="border-bottom: #666666 1px solid;" ><br>
                    <TABLE border="0" align="center">
                        <TR>
                            <TD>
                                LLamado al Servicio
                            </TD>
                        </TR>
                    </TABLE>
                    <br>
                </td>
            </tr>
            <tr>
                <td><TABLE width="510" border="0" cellpadding="0" cellspacing="0" align="center">
                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                            </TD>
                        </TR>
                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Nombre</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.nombre}}</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Teléfono</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.telefono}}</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Placa</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.placa}}</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">Necesita Mantenimiento</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{ message.mantenimiento == 1 ? "SI" : "No"}}</p>
                                {% if message.mantenimiento  == 0 %}
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">Motivo para no tener Mantenimiento</p>
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{ message.wsResponse }}</p>
                                {% endif %}


                            </TD>
                        </TR>

                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                            </TD>
                        </TR>
                    </TABLE>
        </table>
    </body>
</html>

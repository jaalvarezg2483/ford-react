<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Ford | Vehiculos</title>
    <style type="text/css">
        *{
            text-decoration: none;
            font-family: sans-serif;
            color: #2E2D34;
            font-weight: normal;
        }

        p{
            font-size: 14px;
        }

        .ReadMsgBody{
            width: 100%;
            background-color: #ffffff;
        }

        .ExternalClass{
            width: 100%;
            background-color: #ffffff;
        }

        body{
            width: 100%;
            background-color: #ffffff;
            margin:0; padding:0;
            -webkit-font-smoothing: antialiased;
            font-family: Georgia, Times, serif
        }

        table{
            border-collapse: collapse;
        }

        @media only screen and (max-width: 640px)  {
            .deviceWidth{
                width:440px!important;
                padding:0;
            }
            .center{
                text-align: center!important;
            }
        }

        @media only screen and (max-width: 479px) {
            .deviceWidth{
                width: 100% !important;
                padding:0;
            }
            .center{
                text-align: center!important;
            }
            .wspacing{
                width: 30px;
            }
            .logo_e{
                max-width: 136px;
                width: 100%;
                padding-right: 20px;
                display: block;
            }
        }
    </style>
</head>

<body leftmargin="0" topmargin="0" marginwidth="0" marginheight="0" style="font-family: Georgia, Times, serif" >
<table width="100%" border="0" cellpadding="0" cellspacing="0" align="center">
    <tr>
        <td width="100%" valign="top" bgcolor="#f3f3f3" style="padding-top:0px">
            <table width="620" border="0" cellpadding="0" cellspacing="0" align="center" class="deviceWidth" style="margin:0 auto;">
                <tr>
                    <td width="100%" bgcolor="#2E2D34">
                        <table border="0" cellpadding="0" width="100%" cellspacing="0" align="center" class="deviceWidth">
                            <tr>
                                <td style="padding:6px 20px" class="center" align="center">

                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <table width="620" border="0" cellpadding="0" cellspacing="0" align="center" class="deviceWidth" style="margin:0 auto;">
                <tr>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    <td bgcolor="#ffffff" style="border-bottom: 2px solid #eeeeee;">
                        <table border="0" cellpadding="0" cellspacing="0" align="left" class="">
                            <tr>
                                <td style="padding:30px 20px 30px 0px" class="left">
                                    <a href="#"><img src="{{ server_url~ asset('img/email/logo_toyota.png') }}" alt="" border="0" /></a>
                                </td>
                            </tr>
                        </table>
                        <table border="0" cellpadding="0" cellspacing="0" align="right" class="">
                            <tr>
                                <td style="padding:30px 0px 30px 20px" class="right">
                                    <a href="#"><img src="{{ server_url  ~ asset('img/email/logo_purdy.png') }}" alt="" border="0" /></a>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                </tr>
            </table>

            <table width="620" class="deviceWidth" border="0" cellpadding="0" cellspacing="0" align="center" bgcolor="#eeeeed" style="margin:0 auto;">
                <tr>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    <td valign="top" style="padding:0" bgcolor="#ffffff">
                        <h1 style="font-size: 24px;color: #D0112B;font-weight: bold;">Hola, {{ fullname }}</h1>
                        <h3 style="font-size: 20px; font-family: Helvetica;">Confirmación de tu cita en Talleres de Servicio de Purdy Motor.</h3>
                        <p style="font-size: 14px; font-family: Helvetica; line-height: 25px;">Cualquier duda o comentario, por favor llamanos o contestá este correo.</p>
                    </td>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                </tr>
            </table>

            <table width="620" class="deviceWidth" border="0" cellpadding="0" cellspacing="0" align="center" bgcolor="#eeeeed" style="margin:0 auto;">
                <tr>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    <td bgcolor="#ffffff">
                        <table border="0" cellpadding="0" cellspacing="0" align="left" class="">
                            <tr>
                                <td width="100%" bgcolor="#ffffff">
                                    <h2 style="font-size: 24px; font-family: Helvetica;">Resumen cita taller</h2>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                </tr>

                    <tr>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                        <td bgcolor="#ffffff" style="border-bottom: 2px solid #eeeeee;">
                            <table border="0" width="100%" cellpadding="0" cellspacing="0" align="left" class="">
                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        <h2 style="font-size: 16px;"><strong style="font-weight: bold;">Cita Taller</strong></h2>
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">

                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Número de cita
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ ot }}
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Mantenimiento
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ maintenance }}
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Taller
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ workshop }}
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Fecha
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ datet|date('d-m-Y') }}
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Hora
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ datet | date('H:i A') }}
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Vehículo
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ vehicule }}
                                    </td>
                                </tr>

                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Placa
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ plate }}
                                    </td>
                                </tr>
                                {% if details %}
                                <tr>
                                    <td valign="top" style="padding:7px 0" bgcolor="#ffffff">
                                        Comentario
                                    </td>
                                    <td valign="bottom" style="padding:7px 0" bgcolor="#ffffff" width="35%">
                                        {{ detailInfo }}
                                    </td>
                                </tr>
                                {% endif %}

                            </table>
                        </td>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    </tr>


                    <tr>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                        <td bgcolor="#ffffff" style="border-bottom: 2px solid #eeeeee;">
                            <table border="0" width="100%" cellpadding="0" cellspacing="0" align="left" class="">
                                <tr>
                                    <td valign="top" style="padding:0" bgcolor="#ffffff">
                                        <h2 style="font-size: 16px; margin: 1.75em 0 1.50em;"><strong style="font-weight: bold;">Información Personal</strong></h2>
                                    </td>
                                    <td valign="bottom" style="padding:0" bgcolor="#ffffff" width="35%">

                                    </td>
                                </tr>

                                    <tr>
                                        <td valign="top" style="padding:0 0 1.78em" bgcolor="#ffffff">
                                            <p>Nombre Completo</p>
                                        </td>
                                        <td valign="bottom" style="padding:0 0 1.78em" bgcolor="#ffffff" width="35%">
                                            <p>{{  fullname }}</p>
                                        </td>
                                    </tr>

                            </table>
                        </td>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    </tr>
                    <tr>
                        <td colspan="3" bgcolor="#ffffff" style="height: 26px;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                        <td bgcolor="#ffffff">
                            <table border="0" width="100%" cellpadding="0" cellspacing="0" align="center">

                                <tr>
                                    <td style="border-right: 2px solid #eeeeee;" width="40%" align="center" >
                                            <img style="width: 55px; display: block" src="{{ server_url ~ asset('img/email/calendar.png')  }}" alt="">
                                        <a href="{{ absolute_url(appoiment) }}" style="color:#2C97DE; text-align:center;">
                                            Agregar a calendario
                                        </a>
                                    </td>
                                    <td width="60%">
                                        <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td colspan="2"><p style="width: 100%; text-align: center;">Ubicación {{ workshop_address }}</p></td>
                                            </tr>
                                            <tr>
                                                <td align="center">
                                                    <a href="https://www.waze.com/es/livemap?zoom=15&lat={{ lat }}&lon={{ long }}"><img style="width: 120px" src="{{ server_url~ asset('img/email/waze.png') }}" alt="waze"></a>
                                                </td>
                                                <td align="center">
                                                    <a href="http://maps.google.com/maps?q={{ lat }},{{ long }}"><img style="width: 64px" src="{{ server_url ~ asset('img/email/google.png') }}" alt="google"></a>
                                                </td>
                                            </tr>
                                        </table>

                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    </tr>
                    <tr>
                        <td colspan="3" bgcolor="#ffffff" style="height: 25px; ">&nbsp;</td>
                    </tr>
            </table>




            <table width="620" class="deviceWidth" border="0" cellpadding="0" cellspacing="0" align="center" bgcolor="#eeeeed" style="margin:0 auto;">
                <tr>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                    <td valign="top" style="padding:0; border-top: 2px solid #eeeeee;" bgcolor="#ffffff">
                        <table width="100%" border="0" cellspacing="0" cellpadding="0" align="center">
                            <tr>
                                <td>
                                    <div style="height:44px;margin:0 auto;">&nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td align="center">
                                    <table border="0" cellspacing="0" cellpadding="0" align="center">
                                        <tr>
                                            <td align="center" width="248px" height="51px" style="-webkit-border-radius: 3px; -moz-border-radius: 3px; border-radius: 3px;" bgcolor="#969699">
                                                <a href="mailto:citas@grupopurdy.com" style="font-size: 16px; font-family: Helvetica, Arial, sans-serif; font-weight: bold; color: #ffffff; text-decoration: none; text-decoration: none; -webkit-border-radius: 3px; -moz-border-radius: 3px; border-radius: 3px; padding: 16px; display: inline-block;">RESPONDER AL CORREO</a>
                                            </td>
                                            <td width="10px"></td>
                                            <td align="center" width="210px" height="51px" style="-webkit-border-radius: 3px; -moz-border-radius: 3px; border-radius: 3px;" bgcolor="#D0112B">
                                                <a href="tel:25197777" style="font-size: 16px; font-family: Helvetica, Arial, sans-serif; font-weight: bold; color: #ffffff; text-decoration: none; text-decoration: none; -webkit-border-radius: 3px; -moz-border-radius: 3px; border-radius: 3px; padding: 16px; display: inline-block;">Llamar al 2519-7777</a>
                                            </td>
                                        </tr>

                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div style="height:45px;margin:0 auto; border-bottom: 2px solid #eeeeee; ">&nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td style="height: 50px;">&nbsp;</td>
                            </tr>
                            <tr>
                                <td style="text-align: center">
                                    <p>Te agradecemos presentarte puntual a tu cita.</p>
                                </td>
                            </tr>
                            <tr>
                                <td style="height: 50px;"></td>
                            </tr>
                        </table>
                    </td>
                    <td class="wspacing" width="70px" bgcolor="#ffffff"></td>
                </tr>
            </table>

            <table width="100%" border="0" cellpadding="0" cellspacing="0" align="center">
                <tr>
                    <td bgcolor="#f3f3f3" style="padding:0 0 60px 0">
                        <table width="580" border="0" cellpadding="10" cellspacing="0" align="center" class="deviceWidth" style="margin:0 auto;">
                            <tr>
                                <td>
                                    <table width="50%" cellpadding="0" cellspacing="0"  border="0" align="center" class="deviceWidth">
                                        <tr>
                                            <td valign="top" style="font-size: 11px; color: #f1f1f1; font-weight: normal; font-family: Georgia, Times, serif; line-height: 26px; vertical-align: top; text-align:right" class="center">
                                                <p style="text-align: center; font-size: 16px; font-weight: bold;">SEGUINOS EN:</p>
                                                <a href="https://www.facebook.com/ToyotaCostaRica" style="display: inline-block; margin-right: 35px;"><img src="{{ server_url ~ asset('img/email/facebook.png') }}" width="25" height="24" alt="Facebook" title="Facebook" border="0" /></a>
                                                <a href="https://twitter.com/ToyotaCR" style="display: inline-block; margin-right: 35px;"><img src="{{  server_url ~ asset('img/email/twitter.png') }}" width="25" height="24" alt="Twitter" title="Twitter" border="0" /></a>
                                                <a href="https://www.youtube.com/user/ToyotaCostaRica" style="display: inline-block; margin-right: 35px;"><img src="{{ server_url ~ asset('img/email/youtube.png') }}" width="25" height="24" alt="Youtube" title="Youtube" border="0" /></a>
                                                <a href="https://www.instagram.com/toyotacostarica/" style="display: inline-block; margin-right: 35px;"><img src="{{ server_url ~  asset('img/email/instagram.png') }}" width="25" height="24" alt="Instagram" title="Instagram" border="0" /></a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<div style="display:none; white-space:nowrap; font:15px courier; color:#ffffff;">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -</div>
</body>
</html>

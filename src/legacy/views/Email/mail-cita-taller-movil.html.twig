<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
    <title>Citas Taller Móvil</title>
    <style>
        a:link {
            color:#046380;
            text-decoration:underline;
        }
        a:visited {
            color:#A7A37E;
            text-decoration:none;
        }
        a:hover {
            color:#002F2F;
            text-decoration:underline;
        }
        a:active {
            color:#046380;
            text-decoration:none;
        }
    </style>
</head>
<body>
<table align="center" width="600" style="border: #666666 1px solid;" cellpadding="0" cellspacing="0">
    <tr>
        <td bgcolor="#efefef" style="border-bottom: #666666 1px solid;" ><br>
            <TABLE border="0" align="center">
                <TR>
                    <TD>
                        {{ description | default("Citas Taller Móvil") }}
                    </TD>
                </TR>
            </TABLE>
            <br>
        </td>
    </tr>
    <tr>
        <td><TABLE width="510" border="0" cellpadding="0" cellspacing="0" align="center">
                <TR>
                    <TD>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                    </TD>
                </TR>
                <TR>
                    <TD>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Nombre:</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">{{ cita.name }} {{ cita.lastName }}</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Placa:</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">{{ cita.plate }}</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Teléfono:</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">{{ cita.phone }}</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Correo:</p>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">{{ cita.email }}</p>

                    </TD>
                </TR>
                <TR>
                    <TD>
                        <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                    </TD>
                </TR>
            </TABLE>
</table>
</body>
</html>

<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
    <head>
        <title>Purdy Accesorios - Contacto</title>
        <style>
            a:link {
                color:#046380;
                text-decoration:underline;
            }
            a:visited {
                color:#A7A37E;
                text-decoration:none;
            }
            a:hover {
                color:#002F2F;
                text-decoration:underline;
            }
            a:active {
                color:#046380;
                text-decoration:none;
            }
        </style>
    </head>
    <body>
        <table align="center" width="600" style="border: #666666 1px solid;" cellpadding="0" cellspacing="0">
            <tr>
                <td bgcolor="#efefef" style="border-bottom: #666666 1px solid;" ><br>
                    <TABLE border="0" align="center">
                        <TR>
                            <TD>
                                {{ description | default("Cotización Ford") }}
                            </TD>
                        </TR>
                    </TABLE>
                    <br>
                </td>
            </tr>
            <tr>
                <td><TABLE width="510" border="0" cellpadding="0" cellspacing="0" align="center">
                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                            </TD>
                        </TR>
                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Nombre</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.firstName}}</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Teléfono</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.mobile}}</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">Correo</p>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{message.email}}</p>
                                {% for field, value in message.aditionalWithEntity if value is not empty %}
                                    {%  set title = field | translate_field_name  %}
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">{{ title | capitalize  }}</p>
                                    {% if value is iterable %}
                                        {% for accesory in value %}
                                            <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{ accesory.name }} - {{ accesory.price }}</p>
                                        {% endfor %}
                                        {%  else %}
                                            <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{value}}</p>
                                    {% endif %}

                                {% endfor %}


                            </TD>
                        </TR>

                        {% if accessories_list | length > 0 %}
                            
                            {% for accessory  in accessories_list %}
                            <TR>
                                <TD>
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">&nbsp;</p> 
                                </TD>
                            </TR>
                            <TR>
                                <TD>
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{accessory.detail.name}}</p> 
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;">{{accessory.detail.description}}</p> 
                                    <p style="font-family: arial,  helvetica, sans-serif;font-size: 12px;color: #666666;"><img src="http://{{ app.request.host }}/{{accessory.detail.image}}" width="100" height="100"/></p> 
                                </TD>
                            </TR>

                            {% endfor %}
                        {% endif %}
                        <TR>
                            <TD>
                                <p style="font-family: arial,  helvetica, sans-serif;font-size: 15px;color: #666666;">&nbsp;</p>
                            </TD>
                        </TR>
                    </TABLE>
        </table>
    </body>
</html>

{% if articles | length > 0 %}
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h3 class="subtitle">Noticias recientes</h3>
                <h2 class="title news-title">FORD</h2>
                <a class="btn hidden-xs text--bold" href="{{ path('blog') }}">Ir a blog</a>
            </div>

            <div class="col-md-9">
                <div class="news-slider js-equal-height-parent">
                    {% for article in articles %}
                        <div class="card--link">
                            <div class="news-card-img" style="background-image:url('{{ article.getWebPath() | imagine_filter('blog_teaser') }}')">
                                {# <img src="{{ article.getWebPath() | imagine_filter('blog_teaser') }}"> #}
                            </div>
                            <div class="card__content js-equal-height">
                                <h4 class="title">{{ article.title }}</h4>
                                <a class="btn btn--clear" href="{{ path("article_by_alias_and_category", {"category_alias": article.category.alias, "article_alias": article.alias}) }}">Ver más <i class="icon icon-arrow-right"></i></a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
             <div class="col-md-2 hidden-md text-center">
                <a class="btn btn--wider margin--top text--bold" href="{{ path('blog') }}">Ir a blog</a>
            </div>
        </div>
    </div>
{% endif %}

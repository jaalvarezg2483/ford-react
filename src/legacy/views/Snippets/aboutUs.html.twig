{% if categories | length > 0 %}
    <div class="container">
        <ul class="tabs js-tabs-about-us">
            {% for category in categories %}
                <li class="tab {% if loop.first %}active{% endif %}"><a data-toggle="tab" href="#cat{{ category.id }}">{{ category.title }}</a></li>
            {% endfor %}
        </ul>
    </div>
    <div class="bg--accent-dark">
        <div class="tab-content container padding-2">
        {% for category in categories %}
            <div id="cat{{ category.id }}" class="tab-pane fade {% if loop.first %}in active{% endif %}">
                <div class="row">
                    <div class="col-md-6">
                        <h2 class="title text--light">{{ category.title }}</h2>
                        <p class="text--light margin--top">{{ category.description }}</p>
                    </div>
                </div>
                <div class="slider-about-us">
                    {% for item in category.items %}
                        <div class="about-us-img" style="background-image:url('{{ item.image }}')">
                            {# <img src="{{ item.image }}" class="img-responsive"> #}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
{% endif %}


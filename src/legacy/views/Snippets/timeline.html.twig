{% if timeline is not null %}
<div class="timeline-container margin--top">
    <div class="container">
        <h2 class="title">{{ timeline.name }}</h2>

        <ul class="timeline-slider">
            {% for item in timeline.items %}
                <li class="timeline-item">
                    <div class="timeline-img" style="background-image:url('{{ item.image }}')">
                       
                    </div>
                    <h4 class="title">{{ item.year }}</h4> 
                    <p>{{ item.description }}</p>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endif %}
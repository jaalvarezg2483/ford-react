<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h2 class="title ">Contacto</h2>
                <a href="tel:+50624597615" class="title-icon title-icon--responsive">
                    <div class="icon-box">
                        <i class="icon icon-phone"></i>
                    </div>
                    <div>
                        <p>Central telefónica</p> 
                        <p>(506) 2459-7615</p>
                    </div>
                </a>
                <a href="mailto:ventas@grupopurdy.com" class="title-icon title-icon--responsive">
                    <div class="icon-box">
                        <i class="icon icon-mail"></i>
                    </div>
                    <div>
                        <p>Enviar correo</p> 
                        <p>ventas@grupopurdy.com</p>
                    </div>
                </a>
                 <a href="https://api.whatsapp.com/send?phone=50685891000&text=Hola%2C%20deseo%20cotizar%20un%20repuesto%20para%20mi%20Ford.%20" class="title-icon title-icon--responsive">
                        <div class="icon-box">
                            <i class="icon icon-whatsapp"></i>
                        </div>
                        <div>
                            <p>Whatsapp</p>
                            <p>(506) 8589-1000</p>
                        </div>           
                    </a>
            </div>
            <div class="col-md-6">
                <div class="form-container">
                    <h3 class="title">Enviar mensaje</h3>
                    <p><small><span class="text--primary">*</span>  Campos Requeridos</small></p>
                    <form action="{{ path("snippet-contact-form", {'type': type }) }}" class="form snippet-contact-form verify-captcha" id="contactForm" novalidate method="post">
                        {%  set aditionalValues = form.vars.value.aditionalFields | default([])%}

                        
                        {% include 'LumenAppBundle:Default/partials:_form-fields.html.twig' with {'captcha': true} %}
                           
                        {#<input type="hidden" name="token" value="{{ csrf_token(type) }}">#}
                        {{ form_rest(form) }}
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="container container--full-mobile">
        
    </div>

            

    {#Hacer modal pop up#}
    {% if sended is not null %}
        {% if sended == true %}
            <div class="modal fade in show" id="modal-success">
                <div class="modal-dialog" role="document">
                    <button type="button" class="modal__close close-modal-success" data-dismiss="modal"> <i class="icon icon-close"></i> </button>
                    <div class="modal-content text-center padding-2">		
                        
                        <h3 class="text--bold text--primary">SU mensaje se ha enviado con éxito</h3>
                        <p>Pronto nos pondremos en contacto con usted</p>
                        <div>
                            <button class="btn btn--primary close-modal-success" data-dismiss="modal">Aceptar</button>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="modal fade in show" id="modal-success">
                <div class="modal-dialog" role="document">
                    <button type="button" class="modal__close close-modal-success" data-dismiss="modal"> <i class="icon icon-close"></i> </button>
                    <div class="modal-content text-center padding-2">		
                        
                        <h3 class="text--bold text--primary">Ha ocurrido un error al enviar su mensaje</h3>
                        <p>Por favor intente más tarde</p>
                        <div>
                            <button class="btn btn--primary close-modal-success" data-dismiss="modal">Aceptar</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}

</div>


{% block snippetScripts %}
    <script type="text/javascript">
     $('body').on('click', '.close-modal-success',  function(){
            $('#modal-success').removeClass('in show');
        })
    </script>
{% endblock %}
<div class="container margin--top margin--bottom">
    {% for entry in entries %}
        <div class="col-md-4">
            <a href="{{ path('ford-nation-entry', {'alias': entry.alias}) }}" class=
            "benefit-card">
                <img src="{{ entry.image }}" class="benefit-card-img">
                <div class="benefit-card-content">
                    <h3 class="title">{{ entry.title }}</h3>
                    <p class="text--small">{{ entry.description | slice(0,50) }}...</p>
                    <p class="text--small">Vigencia: {{ formatDate(entry.validUntil) }}</p>
                    <p class="text--small text--primary">Ver más <i class="icon icon-arrow-right"></i></p>
                </div>
            </a>
        </div>
    {% endfor %}
</div>

{% if entries | length == 0 %}
<div class="container padding-5 text-center margin--bottom">
    <p>No hay resultados</p>
</div>
{% endif %}

{% if moreResults %}
    <div class="container text-center">
        <button class="btn btn--wider margin--bottom text--bold" id="ford-nation-more-results">Cargar más</button>
    </div>
{% endif %}

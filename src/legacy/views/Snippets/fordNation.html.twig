<div class="container">
    
	<div class="row">	
        <div class="col-md-4">
            <div class="find-us__search">
                <div class="input-field">
                    <input type="text" id="search" name="title" class="input autocomplete" placeholder="Buscar descuento">
                </div>
            </div>
        </div>
    </div>
    <div class="blog-filters">
        <input type="checkbox" id="category-all" name="category-all" value="all" class="ford-nation-category-select categories-select">
        <label for="category-all">Todos ({{ totalEntries }})</label>
    {% for category in categories %}   
        <input type="checkbox" id="category{{ category.id }}" name="category[]" value="{{ category.id }}" class="ford-nation-category-select categories-select">
        <label for="category{{ category.id }}">{{ category.name }} ({{ category.items | length }})</label>
    {% endfor %}
    </div>

</div>
<div id="ford-nation-results">
    {% include '@LumenApp/Snippets/partials/fordNationResults.html.twig' %}
</div>

{% block snippetScripts %}
    <style>
        .autocomplete-suggestions { border: 1px solid #999; background: #FFF; overflow: auto; }
        .autocomplete-suggestion { padding: 2px 5px; white-space: nowrap; overflow: hidden; }
        .autocomplete-selected { background: #F0F0F0; }
        .autocomplete-suggestions strong { font-weight: normal; color: #3399FF; }
        .autocomplete-group { padding: 2px 5px; }
        .autocomplete-group strong { display: block; border-bottom: 1px solid #000; }
        .ui-autocomplete
        {
            position:absolute;
            cursor:default;
            z-index:1001 !important
        }
    </style>
    <script src="{{ asset('bundles/lumencms/js/jquery.autocomplete.min.js') }}"></script>
    <script>
        var query  = {
            page: 1,
            selectedCategories: [],
            title: ""
        };

        var appendMore = function loadMore(result){
            $("#ford-nation-results").append(result);
            $('.spinner').hide();
        };

        var appendMoreAndRemove = function loadMore(result){
            $("#ford-nation-results").empty();
            $("#ford-nation-results").append(result);
            $('.spinner').hide();
        };

        $(document).on("click", "#ford-nation-more-results", function () {
            $("#ford-nation-more-results").remove();
            query.page = query.page + 1;
            $('.spinner').show();
            ajaxCall(appendMore);
        });

        $(document).on("click", ".ford-nation-category-select", function () {
            query.selectedCategories = [];
            query.page = 1;
            $("#ford-nation-results").empty();
            $(".ford-nation-category-select:checked").each(function ()
            {
                query.selectedCategories.push($(this).val());
            });
            $('.spinner').show();
            ajaxCall(appendMore);
        });
        
        function ajaxCall(callback) {
            $.ajax({
                url: "{{ path('snippet-ford-nation', {'size': size}) }}",
                data: query
            }).done(callback);
        }

        var options = {
            paramName: 'title',
            serviceUrl: "{{ path('snippet-ford-nation-by-name') }}",
            params: query,
            onSelect: function (suggestion) {
                $("#ford-nation-results").empty();
                query.page = 1;
                query.title = suggestion.value;
                ajaxCall(appendMoreAndRemove);
            },
            onSearchComplete: function (query) {
                $("#ford-nation-results").empty();
                query.page = 1;
                query.title = query.value;
                ajaxCall(appendMoreAndRemove);
            }
        };

        $(document).on("keydown.autocomplete", "input.autocomplete", function () {
            $(this).autocomplete(options);
        });

        $(document).on("keyup", "input.autocomplete", function () {
            var value = $(this).val();
            if(value === ""){
                query.title = "";
            }
        });
    </script>
{% endblock %}
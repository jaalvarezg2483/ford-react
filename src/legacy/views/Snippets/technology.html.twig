{% if technology is not null %}
<div class="technology-section">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                
                <h3 class="subtitle">{{ technology.title }}</h3>
                <h2 class="title">{{ technology.subTitle }}</h2>

                <p class="text--light margin--top">{{ technology.description }}</p>
            </div>
            <div class="col-md-9">
                <ul class="technology-slider">
                    {% for item in technology.items %}
                        <li class="technology-card">
                            <div class="technology-card-img" style="background-image:url('{{ item.image }}')">
                                {# <img src="{{ item.image }}"> #}
                            </div>
                            <h3 class="title text--light">{{ item.title }}</h3>
                            <p class="text--light">{{ item.description }}</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>    
        </div>
    </div>
</div>    
{% endif %}
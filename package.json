{
  "name": "ford-cr",
  "version": "1.0.0",
  "private": true,
  "description": "Ford Costa Rica — Next.js + Payload CMS + PostgreSQL",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env TZ=America/Costa_Rica NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env TZ=America/Costa_Rica NODE_OPTIONS=--no-deprecation next start -H 0.0.0.0 -p ${PORT:-3000}",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "import:ford": "cross-env NODE_OPTIONS=--no-deprecation NODE_EXTRA_CA_CERTS=./certs/godaddy-secure-ca-g2.pem payload run scripts/import-ford.ts",
    "typecheck": "tsc --noEmit",
    "verify:pages": "tsx scripts/verify-parse.ts",
    "compare": "node scripts/compare-live.mjs",
    "assets:sync": "bash scripts/sync-legacy-assets.sh ../web"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-azure": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cheerio": "^1.0.0",
    "cross-env": "7.0.3",
    "graphql": "16.10.0",
    "next": "16.4.2",
    "nodemailer": "7.0.13",
    "parse5": "7.3.0",
    "payload": "3.91.0",
    "playwright-core": "^1.56.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "twig": "3.0.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@types/twig": "^1.12.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}

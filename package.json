{
  "name": "ford-cr",
  "version": "2.0.0",
  "private": true,
  "description": "Ford Costa Rica: sitio React (Vite) + CMS Payload + PostgreSQL en un solo proceso Node",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --prefix cms",
    "dev:web": "vite",
    "cms": "npm run dev --prefix cms",
    "build": "npm run build:web && npm run build --prefix cms",
    "build:web": "tsc -b && vite build",
    "start": "npm run start --prefix cms",
    "postinstall": "npm ci --prefix cms",
    "typecheck": "tsc -b && npm run typecheck --prefix cms",
    "db:migrate": "npm run payload --prefix cms -- migrate",
    "db:migrate:create": "npm run payload --prefix cms -- migrate:create",
    "import:ford": "npm run import:ford --prefix cms"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "sass": "^1.80.6",
    "typescript": "5.8.3",
    "vite": "^8.2.0"
  }
}
